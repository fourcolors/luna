#!/usr/bin/env bash
# Update an installed Luna server to a target git ref, with auto-rollback.
#
# This is the "update the backend over time" half of the install/update plan.
# Today, updating Luna means SSHing in and running git pull + bun install +
# systemctl restart by hand, with no safety net. This script makes that one
# repeatable command that AUTOMATICALLY ROLLS BACK if the new version fails its
# readiness probe — so a bad update can't take the server down.
#
# Two host shapes share ONE sequence via a "runner" prefix:
#   - bare-host (default): run git/bun/systemctl/curl directly (as root on the box).
#   - --incus <container>: the script runs on the jax-box HOST and routes each step
#     to where it belongs. git ops run DIRECTLY on the host repo mount (the
#     container sees it via bind-mount); bun install / daemon-reload / restart /
#     the readiness curl run INSIDE the container via `incus exec <container> -- ...`.
#
#   Incus path conventions (mirror luna-container-create / luna-server-install):
#     - HOST_REPO_DIR  = /root/luna/<profile>/repo   (host-side git clone; default
#                        derived from --profile, overridable with --repo-dir). This
#                        is bind-mounted to /root/luna INSIDE the container.
#     - CONTAINER_REPO_DIR = /root/luna              (always, in-container view).
#     - unit           = luna_service_name(profile)  (stable -> luna-chat-server.service,
#                        dev -> luna-dev-chat-server.service). The container name
#                        (--incus <container>, e.g. luna-dev) is ONLY the exec target;
#                        paths/unit derive from --profile, never the container name.
#     - readiness port = 4753 (ALWAYS the container-internal port; we curl
#                        127.0.0.1:4753 INSIDE the container, never the host proxy
#                        4753/5753).
#
# This targets the SYSTEM systemd unit (the unit luna-server-install renders under
# /etc/systemd/system, in-container for the incus path). A host running a
# hand-edited `systemctl --user` unit (like the current jax master) is OUT OF SCOPE
# — the script refuses to proceed rather than silently restart the wrong scope
# (see the user-unit guard).

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/luna-deploy.sh
source "$SCRIPT_DIR/lib/luna-deploy.sh"

export HOME="${HOME:-/root}"

PROFILE="${LUNA_PROFILE:-stable}"
# REPO_DIR is the operator-facing repo path. In bare-host mode it is BOTH the git
# cwd and the bun --cwd (default /root/luna). In --incus mode it is only the HOST
# git mount; if the operator did NOT pass --repo-dir we DERIVE it from --profile
# (/root/luna/<profile>/repo, the luna-container-create mount convention) — the
# in-container bun/cwd is always /root/luna. After arg parse we resolve
# HOST_REPO_DIR (git cwd, on the host) and CONTAINER_REPO_DIR (bun --cwd / probe
# cwd, inside the container) so the git-on-host / rest-in-container split is
# explicit. REPO_DIR_EXPLICIT distinguishes "operator passed --repo-dir" from the
# default so the incus path only auto-derives when the operator stayed silent.
REPO_DIR="${LUNA_REPO_DIR:-/root/luna}"
REPO_DIR_EXPLICIT=false
[[ -n "${LUNA_REPO_DIR:-}" ]] && REPO_DIR_EXPLICIT=true
LUNA_HOME="${LUNA_HOME:-/root/.luna}"
SERVICE_DIR="${LUNA_SERVICE_DIR:-/etc/systemd/system}"
SERVICE_NAME=""
REF=""
INCUS_CONTAINER=""
DRY_RUN=false
ROLLBACK=true
# Readiness probe knobs (overridable so the hermetic tests run in ~seconds and
# never hang). curl is bounded per-attempt by --max-time; the overall poll is
# bounded by READINESS_TIMEOUT. Probe target port defaults to the chat server's
# WebSocket/health port (4753).
READINESS_PORT="${LUNA_READINESS_PORT:-4753}"
READINESS_TIMEOUT="${LUNA_READINESS_TIMEOUT:-60}"
READINESS_INTERVAL="${LUNA_READINESS_INTERVAL:-2}"
READINESS_CURL_MAX_TIME="${LUNA_READINESS_CURL_MAX_TIME:-5}"
# Post-stop settle (deploy-reliability). We restart the unit as stop -> settle ->
# start, NOT a fast `systemctl restart`. `systemctl stop` returns once the unit's
# cgroup is torn down, but the outgoing process's DuckDB/SQLite WAL/SHM handles
# can take a moment longer to flush+release (async checkpoint, child reaping, and
# on the --incus bind-mount, host fs cache coherence). A fast `restart` can open
# the DBs from the new process while those handles are still held, crashing the
# boot with "unable to open database file" (SQLITE_CANTOPEN) -> the readiness gate
# then trips a needless auto-rollback. The settle closes that gap. Overridable so
# the hermetic tests set 0 and stay fast (a real deploy uses the default).
RESTART_SETTLE_SECS="${LUNA_RESTART_SETTLE_SECS:-6}"

usage() {
  cat <<'EOF'
Usage: scripts/luna-update-server [options]

Updates an installed Luna server to a target git ref. After restarting the
service it runs a bounded readiness probe; if the new version fails to come up
healthy it AUTOMATICALLY ROLLS BACK to the previous commit and restarts again.

Options:
  --profile <name>          Runtime profile -> unit name. Default: stable.
  --repo-dir <path>         Server git clone to update. Default: /root/luna
                            (bare-host). With --incus, the HOST git mount; default
                            derived from --profile: /root/luna/<profile>/repo.
  --luna-home <path>        Luna state path (holds .env). Default: /root/.luna.
  --ref <git-ref>           Target ref to update to.
                            Default: origin/<current-branch>, or origin/master
                            if the checkout is detached.
  --service-dir <path>      systemd unit directory. Default: /etc/systemd/system.
  --service-name <name>     Override generated unit name.
  --incus <container>       Update an Incus container (e.g. luna-dev / luna-stable)
                            instead of a bare host. The script runs on the jax-box
                            HOST: git ops hit the host repo mount
                            (/root/luna/<profile>/repo, bind-mounted to /root/luna
                            in the container); bun install / daemon-reload / restart
                            and the readiness probe run INSIDE <container> via
                            `incus exec`. The readiness curl targets the
                            container-internal port (4753), not the host proxy.
                            Pair with --profile so paths/unit derive correctly
                            (e.g. --profile dev --incus luna-dev).
  --readiness-timeout <s>   Overall readiness poll budget. Default: 60.
  --readiness-interval <s>  Seconds between readiness attempts. Default: 2.
  --readiness-port <port>   Port for the /healthz probe. Default: 4753.
  --restart-settle <s>      Seconds to wait between `systemctl stop` and `start`
                            so the outgoing process releases its DuckDB/SQLite
                            WAL/SHM handles before the new one opens them (avoids
                            SQLITE_CANTOPEN on boot). Default: 6.
  --no-rollback             Do not auto-roll-back on readiness failure (advanced).
  --dry-run                 Print the plan and change NOTHING.
  --supervisor   <systemd|launchd>   supervisor backend (default: systemd; env: LUNA_SUPERVISOR)
  --user                             use systemd --user scope (systemd only)
  --launchd-label <label>            launchd service label (default: com.user.luna-chat-server; env: LUNA_LAUNCHD_LABEL)
  --launchd-plist <path>             full path to launchd plist (default: ~/Library/LaunchAgents/<label>.plist; env: LUNA_LAUNCHD_PLIST)
  -h, --help                Show this help.

Exit codes:
  0  updated and healthy.
  1  preflight error, OR readiness failed but rollback succeeded.
  2  CRITICAL: readiness failed AND rollback also failed (server may be down;
     manual intervention required).
EOF
}

SUPERVISOR="${LUNA_SUPERVISOR:-systemd}"       # systemd | launchd
SYSTEMD_USER=false                              # --user flag
LAUNCHD_LABEL="${LUNA_LAUNCHD_LABEL:-com.user.luna-chat-server}"
LAUNCHD_PLIST="${LUNA_LAUNCHD_PLIST:-$HOME/Library/LaunchAgents/${LAUNCHD_LABEL}.plist}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile) PROFILE="${2:?missing --profile value}"; shift 2 ;;
    --repo-dir) REPO_DIR="${2:?missing --repo-dir value}"; REPO_DIR_EXPLICIT=true; shift 2 ;;
    --luna-home) LUNA_HOME="${2:?missing --luna-home value}"; shift 2 ;;
    --ref) REF="${2:?missing --ref value}"; shift 2 ;;
    --service-dir) SERVICE_DIR="${2:?missing --service-dir value}"; shift 2 ;;
    --service-name) SERVICE_NAME="${2:?missing --service-name value}"; shift 2 ;;
    --incus) INCUS_CONTAINER="${2:?missing --incus value}"; shift 2 ;;
    --readiness-timeout) READINESS_TIMEOUT="${2:?missing --readiness-timeout value}"; shift 2 ;;
    --readiness-interval) READINESS_INTERVAL="${2:?missing --readiness-interval value}"; shift 2 ;;
    --readiness-port) READINESS_PORT="${2:?missing --readiness-port value}"; shift 2 ;;
    --restart-settle) RESTART_SETTLE_SECS="${2:?missing --restart-settle value}"; shift 2 ;;
    --no-rollback) ROLLBACK=false; shift ;;
    --dry-run) DRY_RUN=true; shift ;;
    --supervisor)  SUPERVISOR="${2:?missing --supervisor value}"; shift 2 ;;
    --user)        SYSTEMD_USER=true; shift ;;
    --launchd-label) LAUNCHD_LABEL="${2:?missing --launchd-label value}"; LAUNCHD_PLIST="$HOME/Library/LaunchAgents/${LAUNCHD_LABEL}.plist"; shift 2 ;;
    --launchd-plist) LAUNCHD_PLIST="${2:?missing --launchd-plist value}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) luna_die "unknown option: $1" ;;
  esac
done

luna_validate_profile "$PROFILE"

# Supervisor validation — incompatible combinations are caught early before any
# mutating step so the operator sees a clear diagnosis, not a half-updated server.
# Reject an unknown value FIRST: the preflight branches `launchd`-vs-else while the
# sup_* functions branch `systemd`-vs-else, so a typo like `--supervisor sytemd`
# would split-brain (systemd preflight + launchctl restart). Fail clean instead.
[[ "$SUPERVISOR" == "systemd" || "$SUPERVISOR" == "launchd" ]] ||
  luna_die "invalid --supervisor: '$SUPERVISOR' (expected 'systemd' or 'launchd')"
if [[ "$SUPERVISOR" == "launchd" ]]; then
  # launchd is macOS-only; --incus targets a Linux container and is incompatible.
  [[ -z "$INCUS_CONTAINER" ]] || luna_die "--supervisor launchd is incompatible with --incus (launchd is macOS-only; containers run Linux systemd)"
  # --user is a systemd concept; launchd has no system/user split in the same sense.
  [[ "$SYSTEMD_USER" == false ]] || luna_die "--supervisor launchd is incompatible with --user (launchd has no system/user unit split)"
  # Require the launchctl binary so the error is clear before any mutating step.
  command -v launchctl >/dev/null 2>&1 || luna_die "--supervisor launchd requires launchctl (not found in PATH)"
fi
if [[ "$SYSTEMD_USER" == true && -n "$INCUS_CONTAINER" ]]; then
  luna_die "--user is incompatible with --incus (user units run on the bare host, not inside a container)"
fi

if [[ -z "$SERVICE_NAME" ]]; then
  SERVICE_NAME="$(luna_service_name "$PROFILE")"
fi

# For --user, default SERVICE_DIR to the XDG systemd user unit directory when the
# operator did not explicitly pass --service-dir / LUNA_SERVICE_DIR. This mirrors
# where `systemctl --user enable` expects to find units (or where a unit file was
# placed by the operator). The system default (/etc/systemd/system) would be wrong
# — units there are not visible to the user scope.
if [[ "$SYSTEMD_USER" == true && -z "${LUNA_SERVICE_DIR:-}" && "$SERVICE_DIR" == "/etc/systemd/system" ]]; then
  SERVICE_DIR="$HOME/.config/systemd/user"
fi
USER_UNIT_FILE="$SERVICE_DIR/$SERVICE_NAME"

# --- resolve the git-on-host / rest-in-container path split -------------------
# HOST_REPO_DIR    : where `git` runs (always on the HOST).
# CONTAINER_REPO_DIR: where `bun`/`systemctl` working dir lives (in-container in
#                     incus mode). In incus mode the host mount is bind-mounted
#                     to /root/luna inside the container, so the two differ; in
#                     bare-host mode both are REPO_DIR.
if [[ -n "$INCUS_CONTAINER" ]]; then
  # Default the host repo mount from the profile (luna-container-create maps
  # /root/luna/<profile>/repo -> /root/luna). --repo-dir overrides the HOST path.
  if [[ "$REPO_DIR_EXPLICIT" == true ]]; then
    HOST_REPO_DIR="$REPO_DIR"
  else
    HOST_REPO_DIR="/root/luna/${PROFILE}/repo"
  fi
  CONTAINER_REPO_DIR="/root/luna"
  # In-container bun: the host's bun path won't exist in the container, so resolve
  # the container's bun (the test seam LUNA_TEST_BUN_PATH still wins for hermetic
  # runs; on real jax it is the standard /root/.bun/bin/bun).
  BUN_BIN_INCUS="${LUNA_TEST_BUN_PATH:-/root/.bun/bin/bun}"
else
  HOST_REPO_DIR="$REPO_DIR"
  CONTAINER_REPO_DIR="$REPO_DIR"
fi

ENV_FILE="$LUNA_HOME/.env"
SERVICE_FILE="$SERVICE_DIR/$SERVICE_NAME"

# --- runner: the single seam that makes bare-host and incus share one path ----
# run_target executes a command on the update target. Bare-host -> direct; incus
# -> wrapped in `incus exec <container> --`. Every IN-CONTAINER step (bun install,
# daemon-reload, restart, claude re-pin) routes through this so the sequence is
# written once. git is the ONE exception: it always runs on the HOST (see
# git_target below), since the container reads the repo via bind-mount. In
# --dry-run run_target prints (via luna_run) and executes nothing.
run_target() {
  if [[ -n "$INCUS_CONTAINER" ]]; then
    luna_run incus exec "$INCUS_CONTAINER" -- "$@"
  else
    luna_run "$@"
  fi
}

# Same as run_target but used by the readiness probe, where we need the command's
# STDOUT captured even in non-dry-run (systemctl is-active / show NRestarts, curl
# /healthz + /readyz). In incus mode these run INSIDE the container, so the curl
# hits 127.0.0.1:<port> on the container loopback (NOT the host proxy). These are
# read-only probes; the readiness gate is only reached on the live (non-dry) path.
run_target_capture() {
  if [[ -n "$INCUS_CONTAINER" ]]; then
    incus exec "$INCUS_CONTAINER" -- "$@"
  else
    "$@"
  fi
}

# git ALWAYS runs on the HOST (never through run_target / incus exec): in incus
# mode the container sees the repo via a bind-mount, so the host git working on
# HOST_REPO_DIR mutates the very files the container reads. Routing git through
# `incus exec` would (a) require git inside the container and (b) operate on the
# in-container path — both wrong. So git_target is just luna_run (dry-run-aware),
# never run_target. git_target_capture runs git directly to capture stdout.
git_target() {
  luna_run git -C "$HOST_REPO_DIR" "$@"
}

git_target_capture() {
  git -C "$HOST_REPO_DIR" "$@"
}

# --- preflight ----------------------------------------------------------------

luna_info "Updating Luna server profile: $PROFILE"
if [[ -n "$INCUS_CONTAINER" ]]; then
  printf 'Repo (host git mount): %s\n' "$HOST_REPO_DIR"
  printf 'Repo (in-container):   %s\n' "$CONTAINER_REPO_DIR"
  printf 'Service: %s (in container)\n' "$SERVICE_FILE"
  printf 'Target: incus container %s\n' "$INCUS_CONTAINER"
elif [[ "$SUPERVISOR" == "launchd" ]]; then
  printf 'Repo: %s\n' "$HOST_REPO_DIR"
  printf 'Service: %s (launchd plist: %s)\n' "$LAUNCHD_LABEL" "$LAUNCHD_PLIST"
  printf 'Target: macOS launchd (gui/%s)\n' "$UID"
elif [[ "$SYSTEMD_USER" == true ]]; then
  printf 'Repo: %s\n' "$HOST_REPO_DIR"
  printf 'Service: %s (systemd --user)\n' "$SERVICE_FILE"
  printf 'Target: bare host (user scope)\n'
else
  printf 'Repo: %s\n' "$HOST_REPO_DIR"
  printf 'Service: %s\n' "$SERVICE_FILE"
  printf 'Target: bare host\n'
fi

# The repo must be a git clone — updating a non-clone is meaningless. git runs on
# the HOST in BOTH modes (in incus mode HOST_REPO_DIR is the bind-mount source the
# host can always stat), so the check is the same host-side test for both shapes.
[[ -d "$HOST_REPO_DIR/.git" ]] || luna_die "$HOST_REPO_DIR is not a git clone"

# Unit-existence preflight: confirm the supervisor artifact (systemd unit or launchd
# plist) actually exists before we mutate the repo. Running without one means we
# would update the code but have no way to restart the service — a silent half-deploy.
# Dry-run is exempt: it prints the plan without touching anything, so a missing unit
# should not block a dry inspection of what WOULD happen.
if [[ "$DRY_RUN" == false ]]; then
  if [[ "$SUPERVISOR" == "launchd" ]]; then
    [[ -f "$LAUNCHD_PLIST" ]] ||
      luna_die "launchd plist $LAUNCHD_PLIST not found; create it (e.g. via render_launchd_plist) before running luna-update-server"
  elif [[ -n "$INCUS_CONTAINER" ]]; then
    # The unit is a CONTAINER-FS artifact (the in-container luna-server-install
    # renders it under /etc/systemd/system), so probe it inside the container.
    incus exec "$INCUS_CONTAINER" -- test -f "$SERVICE_FILE" ||
      luna_die "system unit $SERVICE_FILE not found in container $INCUS_CONTAINER; \
run luna-server-install inside the container first"
  elif [[ "$SYSTEMD_USER" == true ]]; then
    [[ -f "$USER_UNIT_FILE" ]] ||
      luna_die "systemd user unit $USER_UNIT_FILE not found; \
copy or symlink your unit there (e.g. cp my.service $USER_UNIT_FILE) then run systemctl --user daemon-reload"
  else
    [[ -f "$SERVICE_FILE" ]] ||
      luna_die "system unit $SERVICE_FILE not found; \
run luna-server-install to create it, or pass --supervisor launchd / --user for non-system-unit hosts"
  fi
fi

# Resolve the default ref now that we know the repo is real. Default to the
# remote-tracking branch of the current checkout; fall back to origin/master if
# detached. git runs on the host in BOTH modes, so HOST_REPO_DIR's HEAD is
# readable for the incus path too.
if [[ -z "$REF" ]]; then
  CUR_BRANCH=""
  if [[ -d "$HOST_REPO_DIR/.git" ]]; then
    CUR_BRANCH="$(git -C "$HOST_REPO_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  fi
  if [[ -n "$CUR_BRANCH" && "$CUR_BRANCH" != "HEAD" ]]; then
    REF="origin/$CUR_BRANCH"
  else
    REF="origin/master"
  fi
fi
printf 'Target ref: %s\n' "$REF"

# Bun: in incus mode it runs INSIDE the container, so resolve the container's bun
# (BUN_BIN_INCUS, set during path resolution). In bare-host mode resolve the
# host's bun as before.
if [[ -n "$INCUS_CONTAINER" ]]; then
  BUN_BIN="$BUN_BIN_INCUS"
else
  BUN_BIN="$(luna_find_bun)"
fi

# --- helpers: lockfile-change detection (portable; no sha256sum) --------------
# git hash-object is the portable "hash of bun.lock" (matches the spec's "hash"
# wording) and avoids sha256sum, which does NOT exist on macOS where the
# hermetic test runs the real script. Empty string if the file is missing.
# bun.lock lives on the HOST repo mount and git is host-side, so this is a purely
# host-side hash in BOTH modes (HOST_REPO_DIR is the bind-mount source on incus).
lockfile_hash() {
  if [[ -f "$HOST_REPO_DIR/bun.lock" ]]; then
    git -C "$HOST_REPO_DIR" hash-object "$HOST_REPO_DIR/bun.lock" 2>/dev/null || printf ''
  else
    printf ''
  fi
}

# --- crash-safe transaction + per-profile exclusion -------------------------
# Updating mutates a live checkout across several fallible steps. A durable
# phase journal makes a killed/power-lost run resumable, while an atomic mkdir
# lock prevents timer/manual/CLI invocations from interleaving resets, installs,
# and restarts. State lives outside the mutable repo by default.
UPDATE_STATE_DIR="${LUNA_UPDATE_STATE_DIR:-$LUNA_HOME/update}"
UPDATE_LOCK_DIR="$UPDATE_STATE_DIR/lock-$PROFILE"
UPDATE_JOURNAL="$UPDATE_STATE_DIR/transaction-$PROFILE"
UPDATE_LOCK_HELD=false
TX_PHASE=""
TX_PREV=""
TX_TARGET=""
TX_PREV_LOCK_HASH=""
TRANSACTION_TRACK_APPLY=false
EXPECTED_BUILD_SHA=""

process_fingerprint() {
  local pid="$1"
  if [[ -r "/proc/$pid/stat" ]]; then
    # Drop pid + parenthesized comm (which may contain spaces); starttime is
    # field 20 in the remainder (field 22 in procfs' full record).
    sed 's/^.*) //' "/proc/$pid/stat" 2>/dev/null | awk '{print $20}'
  else
    ps -p "$pid" -o lstart= 2>/dev/null | tr -d '\n'
  fi
}

lock_owner_alive() {
  [[ -r "$UPDATE_LOCK_DIR/owner" ]] || return 1
  local pid fingerprint current
  pid="$(sed -n 's/^pid=//p' "$UPDATE_LOCK_DIR/owner" | head -1)"
  fingerprint="$(sed -n 's/^fingerprint=//p' "$UPDATE_LOCK_DIR/owner" | head -1)"
  [[ "$pid" =~ ^[0-9]+$ && -n "$fingerprint" ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  current="$(process_fingerprint "$pid")"
  [[ -n "$current" && "$current" == "$fingerprint" ]]
}

release_update_lock() {
  if [[ "$UPDATE_LOCK_HELD" == true ]]; then
    rm -rf "$UPDATE_LOCK_DIR" 2>/dev/null || true
    UPDATE_LOCK_HELD=false
  fi
}

acquire_update_lock() {
  mkdir -p "$UPDATE_STATE_DIR"
  chmod 700 "$UPDATE_STATE_DIR" 2>/dev/null || true
  if ! mkdir "$UPDATE_LOCK_DIR" 2>/dev/null; then
    if lock_owner_alive; then
      luna_warn "DEFERRED: another update for profile '$PROFILE' is already running"
      return 1
    fi
    luna_warn "removing stale update lock for profile '$PROFILE'"
    rm -rf "$UPDATE_LOCK_DIR"
    mkdir "$UPDATE_LOCK_DIR" || return 1
  fi
  local fingerprint
  fingerprint="$(process_fingerprint "$$")"
  ( umask 077; printf 'pid=%s\nfingerprint=%s\n' "$$" "$fingerprint" > "$UPDATE_LOCK_DIR/owner" )
  UPDATE_LOCK_HELD=true
  trap release_update_lock EXIT INT TERM
}

write_transaction() {
  local phase="$1"
  local tmp="$UPDATE_JOURNAL.tmp.$$"
  ( umask 077; printf 'phase=%s\nprev=%s\ntarget=%s\nprev_lock_hash=%s\nupdated_at=%s\n' \
      "$phase" "$PREV" "$REF" "$PREV_LOCK_HASH" "$(date +%s)" > "$tmp" )
  mv "$tmp" "$UPDATE_JOURNAL"
  TX_PHASE="$phase"
  if [[ "${LUNA_TEST_CRASH_AFTER_PHASE:-}" == "$phase" ]]; then
    # Deliberate SIGKILL seam: traps cannot clean the lock, matching power loss.
    kill -KILL "$$"
  fi
}

clear_transaction() {
  rm -f "$UPDATE_JOURNAL"
  TX_PHASE=""
}

load_transaction() {
  [[ -r "$UPDATE_JOURNAL" ]] || return 1
  TX_PHASE="" TX_PREV="" TX_TARGET="" TX_PREV_LOCK_HASH=""
  local key value
  while IFS='=' read -r key value; do
    case "$key" in
      phase) TX_PHASE="$value" ;;
      prev) TX_PREV="$value" ;;
      target) TX_TARGET="$value" ;;
      prev_lock_hash) TX_PREV_LOCK_HASH="$value" ;;
    esac
  done < "$UPDATE_JOURNAL"
  [[ "$TX_PHASE" =~ ^(prepared|checkout|applied|restarting|verifying|rolling-back|rollback-failed|forward-failed)$ ]] || return 1
  [[ "$TX_PREV" =~ ^[0-9a-fA-F]{7,64}$ ]] || return 1
  [[ "$TX_TARGET" =~ ^[0-9a-fA-F]{7,64}$ ]] || return 1
  [[ -z "$TX_PREV_LOCK_HASH" || "$TX_PREV_LOCK_HASH" =~ ^[0-9a-fA-F]{7,64}$ ]] || return 1
}

# --- readiness probe (the gate for rollback) ----------------------------------
# Bounded, never hangs. A failing probe is a NON-FATAL signal here — callers MUST
# invoke this as `if ! readiness_ok; then ...`, never bare, or `set -e` aborts
# before rollback can run. Returns 0 only when ALL hold within the budget:
#   - systemctl is-active <unit> == active
#   - the unit's NRestarts did not climb since restart (it didn't crash-loop)
#   - curl http://127.0.0.1:<port>/healthz returns HTTP 200
#   - curl /readyz reports "mode":"normal" (NOT setup-mode) — see below
# The probe runs THROUGH the runner, so in --incus it curls 127.0.0.1 INSIDE the
# container (not the host's proxied port). /healthz is bare liveness (a setup-mode
# server answers it 200 too), so the gate ALSO checks /readyz, which reports the
# boot mode. Back-compat: a server without /readyz (older build — e.g. a rollback
# target) returns 404, and the gate falls back to liveness-only so update-server
# can still drive pre-/readyz deploys.
readiness_restart_baseline() {
  # Baseline restart/launch count right after we issued the restart. If this
  # climbs during the probe window the unit is crash-looping, not recovering.
  local n
  n="$(sup_restart_count)"
  [[ "$n" =~ ^[0-9]+$ ]] || n="0"
  printf '%s' "$n"
}

readiness_ok() {
  local baseline="$1"
  local deadline=$((SECONDS + READINESS_TIMEOUT))
  local active nrestarts http
  while (( SECONDS < deadline )); do
    active="$(sup_is_active)"
    if [[ "$active" == "active" ]]; then
      nrestarts="$(sup_restart_count)"
      [[ "$nrestarts" =~ ^[0-9]+$ ]] || nrestarts="0"
      if (( nrestarts <= baseline )); then
        http="$(run_target_capture curl -fsS -o /dev/null -w '%{http_code}' \
          --max-time "$READINESS_CURL_MAX_TIME" \
          "http://127.0.0.1:${READINESS_PORT}/healthz" 2>/dev/null || printf '000')"
        if [[ "$http" == "200" ]]; then
          readyz="$(run_target_capture curl -sS -w '\n%{http_code}' \
            --max-time "$READINESS_CURL_MAX_TIME" \
            "http://127.0.0.1:${READINESS_PORT}/readyz" 2>/dev/null || printf '\n000')"
          local rcode="${readyz##*$'\n'}"
          # Only a real HTTP 404 means a legacy pre-/readyz build. `000` is a
          # transport failure (often the process dying between the healthz and
          # readyz probes) and must retry/fail, never accept the deploy.
          if [[ "$rcode" == "404" ]]; then
            return 0
          fi
          if printf '%s' "$readyz" | grep -q '"mode":"normal"'; then
            if [[ -z "$EXPECTED_BUILD_SHA" ]]; then
              return 0
            fi
            local build_sha
            build_sha="$(printf '%s' "$readyz" | sed -n 's/.*"buildSha":"\([0-9a-fA-F]*\)".*/\1/p' | head -1)"
            if [[ -n "$build_sha" && ( "$EXPECTED_BUILD_SHA" == "$build_sha"* || "$build_sha" == "$EXPECTED_BUILD_SHA"* ) ]]; then
              return 0
            fi
          fi
        fi
      fi
    fi
    sleep "$READINESS_INTERVAL"
  done
  return 1
}

# --- apply: deploy-semantics update to a ref ----------------------------------
# This is a DEPLOY checkout, not a dev tree, so `git reset --hard <ref>` is the
# clean, deterministic update (no merge surprises). git fetch origin brings the
# ref up to date first UNLESS --no-fetch is passed (used by the rollback path,
# which rolls back to a LOCAL sha already in the repo — no network needed, and
# the fetch failing for a network reason should not prevent rollback recovery).
# Re-pinning the Claude executable is intentional: deps can move on `bun install`
# and the override path goes stale — without re-pinning the server boots but
# cannot spawn `claude` (a REAL incident this session).
# Every mutating step is `cmd || return 1` so a command-level failure (a bad
# `bun install`, a refused `systemctl restart`, an out-of-sync frozen lockfile)
# becomes a RETURN VALUE the caller routes into rollback — NOT a `set -e` abort
# that would skip rollback entirely. `|| return 1` is safe under `set -e` in any
# call context (it is the rightmost element of an OR list).
apply_ref() {
  local target="$1"
  local prev_lock_hash="$2"
  local no_fetch="${3:-}"
  if [[ "$no_fetch" != "--no-fetch" ]]; then
    git_target fetch origin || return 1
  fi
  git_target reset --hard "$target" || return 1
  if [[ "$TRANSACTION_TRACK_APPLY" == true ]]; then
    write_transaction "checkout" || return 1
  fi

  local new_lock_hash
  new_lock_hash="$(lockfile_hash)"
  if [[ "$new_lock_hash" != "$prev_lock_hash" ]]; then
    luna_info "bun.lock changed -> bun install --frozen-lockfile"
    # bun --cwd is the IN-CONTAINER repo (/root/luna) in incus mode, the host repo
    # in bare-host mode. run_target wraps it in `incus exec` for incus so deps
    # install inside the container (host git already changed the bind-mounted files).
    run_target "$BUN_BIN" install --cwd "$CONTAINER_REPO_DIR" --frozen-lockfile || return 1
  else
    luna_info "bun.lock unchanged -> skipping bun install"
  fi

  # Build the web SPA on every apply (SPA source changes independent of bun.lock)
  # so chat-server serves the current UI on :4753. The guarded build refuses to
  # bake VITE_UI_WS_TOKEN (deploy env never sets it); failure routes to rollback.
  run_target "$BUN_BIN" run --cwd "$CONTAINER_REPO_DIR" --filter "@luna/ui-web" build || return 1

  # Re-pin LUNA_CLAUDE_CODE_EXECUTABLE (no-op in dry-run). Deps can move on
  # `bun install` and the override path goes stale — without re-pinning the
  # server boots but cannot spawn `claude` (a REAL incident this session).
  if [[ -n "$INCUS_CONTAINER" ]]; then
    # The container's claude executable + .env are container-FS artifacts; a
    # host-side luna_configure_claude_executable would introspect HOST paths and
    # write a host-perspective path into the container's .env (wrong). Run the same
    # helper INSIDE the container against the container's .env (/root/.luna/.env)
    # and repo (/root/luna), sourcing the shared lib there. (no-op in dry-run.)
    run_target bash -lc \
      "source /root/luna/scripts/lib/luna-deploy.sh && luna_configure_claude_executable /root/.luna/.env /root/luna" ||
      return 1
  else
    luna_configure_claude_executable "$ENV_FILE" "$REPO_DIR" || return 1
  fi

}

# Settle between stop and start. A bounded, dry-run-aware wait that lets the
# OUTGOING process finish flushing and release its DuckDB/SQLite WAL/SHM handles
# before the incoming process opens the DBs. Deliberately a FIXED sleep, not a
# port/handle poll: the listening port is already gone the instant `systemctl
# stop` returns, yet the fd release can lag process exit (async WAL checkpoint,
# child reaping, incus bind-mount fs flush) — none of which the port reflects,
# and whose DB file paths this script does not know to fuser/lsof against. A
# short fixed settle is exactly what the manual recovery proved out. ALWAYS
# returns 0: it sits unguarded between restart_service's two `|| return 1` lines,
# so a stray non-zero here must never trip set -e / the rollback path.
settle_after_stop() {
  [[ "$DRY_RUN" == true ]] && return 0
  [[ "$RESTART_SETTLE_SECS" == "0" ]] && return 0
  # Validate BEFORE sleeping. A bare `sleep "$bad" || true` would swallow the
  # failure of an invalid/negative/empty value and skip the settle SILENTLY —
  # reintroducing the WAL/SHM race the operator believes they configured away,
  # with no signal. So reject anything that is not a non-negative number of
  # seconds (the documented contract for --restart-settle / LUNA_RESTART_SETTLE_SECS)
  # and WARN loudly, but still no-op + return 0 (set -e / rollback must never trip).
  if [[ ! "$RESTART_SETTLE_SECS" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
    luna_warn "RESTART_SETTLE_SECS='$RESTART_SETTLE_SECS' is not a non-negative number of seconds; SKIPPING the post-stop settle — the DuckDB/SQLite WAL/SHM race may recur. Set --restart-settle / LUNA_RESTART_SETTLE_SECS to a valid value (e.g. 6)."
    return 0
  fi
  luna_info "settling ${RESTART_SETTLE_SECS}s after stop so DuckDB/SQLite release WAL/SHM before start"
  # Belt-and-suspenders: if sleep STILL fails for some reason, warn (do not
  # swallow it silently) — but keep returning 0 so the rollback path is intact.
  if ! sleep "$RESTART_SETTLE_SECS"; then
    luna_warn "post-stop settle sleep failed (RESTART_SETTLE_SECS='$RESTART_SETTLE_SECS'); proceeding to start WITHOUT a settle — the WAL/SHM race may recur."
  fi
  return 0
}

# --- supervisor abstraction ---------------------------------------------------
# The following five functions (sup_reload, sup_stop, sup_start, sup_is_active,
# sup_restart_count) form a thin abstraction over systemd and launchd so the
# restart/readiness logic above them is written once and routes by $SUPERVISOR.
#
# Key invariant: all five return 0 on success, non-zero on failure — callers use
# `|| return 1` to propagate into rollback exactly as the bare systemctl calls did.
#
# launchd notes (verified on macOS 26.5.1):
#   - `bootout` is ASYNC: the process may still be running when it returns. We
#     capture the PID BEFORE bootout and poll kill -0 until dead (bounded 15s).
#   - bootout when already-gone returns rc=3 "No such process" -> tolerate as OK.
#   - `bootstrap gui/$UID <plist>` is the modern load primitive (not `launchctl load`).
#   - `print gui/$UID/$LABEL` -> state = running (is-active analogue).
#   - `print gui/$UID/$LABEL` -> runs = N (crash-loop counter analogue).

# sup_reload — daemon configuration reload before start.
# systemd: daemon-reload (forces the kernel to re-read unit files so a changed
#   ExecStart / EnvironmentFile / etc. takes effect on the next start).
# launchd: no-op (launchd reads the plist fresh on bootstrap; no reload needed).
sup_reload() {
  if [[ "$SUPERVISOR" == "systemd" ]]; then
    run_target systemctl $(_systemctl_user_flag) daemon-reload
  else
    # launchd: the plist is re-read at bootstrap time, so there is no persistent
    # daemon state to reload. Return 0 unconditionally.
    return 0
  fi
}

# sup_stop — stop the supervised service and wait for the process to be gone.
# systemd: synchronous (systemctl stop blocks until the unit's cgroup is torn down).
# launchd: async! capture PID first, then bootout, then poll kill -0 until dead.
#   Dry-run: just print the bootout command; skip the poll (nothing to wait for).
sup_stop() {
  if [[ "$SUPERVISOR" == "systemd" ]]; then
    run_target systemctl $(_systemctl_user_flag) stop "$SERVICE_NAME"
  else
    # Capture PID BEFORE bootout — once the service is gone launchctl list
    # no longer has a "PID" field, so we must read it first. The line format is
    # exactly `\t"PID" = 1182;` (verified on macOS 26), so pull the integer
    # between `= ` and `;`. (An earlier `awk -F'"' '{print $4}'` extracted the
    # EMPTY field after the closing quote, silently disabling the death-poll —
    # the settle then only "worked" because it outlived the dying process.)
    local pid=""
    pid="$(launchctl list "$LAUNCHD_LABEL" 2>/dev/null | sed -n 's/.*"PID" = \([0-9]*\);.*/\1/p' || true)"

    # bootout: rc=3 "No such process" is normal when the unit is already stopped;
    # treat it as success so an idempotent stop doesn't abort the deploy.
    if [[ "$DRY_RUN" == true ]]; then
      luna_run launchctl bootout "gui/$UID/$LAUNCHD_LABEL"
      return 0
    fi
    launchctl bootout "gui/$UID/$LAUNCHD_LABEL" 2>/dev/null || {
      local rc=$?
      # rc=3 = "No such process" = already stopped. Any other rc is a real error.
      [[ $rc -eq 3 ]] || { printf 'error: launchctl bootout failed (rc=%d)\n' "$rc" >&2; return 1; }
    }

    # Poll until the process is actually gone (bootout is async).
    # A missing or empty PID means nothing was running — skip the poll.
    if [[ -n "$pid" ]]; then
      local i=0
      while (( i < 15 )); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 1
        (( i++ )) || true
      done
      if kill -0 "$pid" 2>/dev/null; then
        luna_warn "launchctl bootout timed out: PID $pid still alive after 15s; proceeding anyway"
      fi
    fi
  fi
}

# sup_start — load/start the supervised service.
# systemd: systemctl start (picks up the unit from SERVICE_DIR, already reloaded).
# launchd: bootstrap gui/$UID <plist> (reads the plist file at LAUNCHD_PLIST).
sup_start() {
  if [[ "$SUPERVISOR" == "systemd" ]]; then
    run_target systemctl $(_systemctl_user_flag) start "$SERVICE_NAME"
  else
    luna_run launchctl bootstrap "gui/$UID" "$LAUNCHD_PLIST"
  fi
}

# sup_is_active — check whether the service is currently running.
# Returns: prints "active" if running; "unknown" otherwise. Callers compare with ==.
# systemd: `systemctl is-active <unit>` (prints "active" when running).
# launchd: `launchctl print gui/$UID/$LABEL | grep 'state = running'`.
sup_is_active() {
  if [[ "$SUPERVISOR" == "systemd" ]]; then
    run_target_capture systemctl $(_systemctl_user_flag) is-active "$SERVICE_NAME" 2>/dev/null || printf 'unknown'
  else
    if launchctl print "gui/$UID/$LAUNCHD_LABEL" 2>/dev/null | grep -q 'state = running'; then
      printf 'active'
    else
      printf 'unknown'
    fi
  fi
}

# sup_restart_count — how many times has the supervisor restarted this service?
# Used by readiness_ok to detect crash-looping: if the count climbs during the
# probe window, the service is not actually healthy despite momentary is-active.
# systemd: NRestarts property via systemctl show.
# launchd: the `runs` field from `launchctl print` (increments on each launch).
# Both: non-numeric output -> "0" (safe default, disables the climb check).
sup_restart_count() {
  local n
  if [[ "$SUPERVISOR" == "systemd" ]]; then
    n="$(run_target_capture systemctl $(_systemctl_user_flag) show "$SERVICE_NAME" --property=NRestarts --value 2>/dev/null || printf '0')"
  else
    n="$(launchctl print "gui/$UID/$LAUNCHD_LABEL" 2>/dev/null | awk '/^[[:space:]]*runs =/{print $3}' || printf '0')"
  fi
  [[ "$n" =~ ^[0-9]+$ ]] || n="0"
  printf '%s' "$n"
}

# _systemctl_user_flag — emit "--user" when the --user flag was passed, empty otherwise.
# Used by every systemctl call so bare-host system-scope is unchanged and user-scope
# is a single toggle. This is a helper, not a supervisor abstraction function.
_systemctl_user_flag() {
  [[ "$SYSTEMD_USER" == true ]] && printf '%s' '--user' || true
}

# Restart the unit as a CLEAN stop -> settle -> start instead of a fast
# supervisor-restart. sup_stop handles the async launchd death-poll internally,
# so settle_after_stop always runs on confirmed-dead (or timed-out-with-warning).
# sup_reload is a no-op for launchd.
restart_service() {
  # Stop -> settle -> start instead of a fast supervisor-restart. sup_stop handles
  # the async launchd death-poll internally, so settle_after_stop always runs on
  # confirmed-dead (or timed-out-with-warning). sup_reload is a no-op for launchd.
  sup_reload || return 1
  sup_stop   || return 1
  settle_after_stop
  sup_start  || return 1
}

# --- plan / dry-run -----------------------------------------------------------
if [[ "$DRY_RUN" == true ]]; then
  luna_info "Plan (dry-run — nothing will be executed):"
  PREV="(current HEAD)"
  # git is host-side in both modes, so HOST_REPO_DIR's HEAD reads for incus too.
  if [[ -d "$HOST_REPO_DIR/.git" ]]; then
    PREV="$(git -C "$HOST_REPO_DIR" rev-parse HEAD 2>/dev/null || printf '(current HEAD)')"
  fi
  if [[ -n "$INCUS_CONTAINER" ]]; then
    printf '0. incus mode -> container %s; git on HOST %s, deps/restart/probe in container\n' \
      "$INCUS_CONTAINER" "$HOST_REPO_DIR"
  fi
  printf '1. record PREV = %s and bun.lock hash (host repo %s)\n' "$PREV" "$HOST_REPO_DIR"
  printf '2. (HOST git) fetch origin + reset --hard to %s\n' "$REF"
  printf '3. if bun.lock changed: %s install --cwd %s --frozen-lockfile (else skip)\n' "$BUN_BIN" "$CONTAINER_REPO_DIR"
  printf '3b. %s run --cwd %s --filter @luna/ui-web build (always — builds the web SPA served on :4753)\n' "$BUN_BIN" "$CONTAINER_REPO_DIR"
  # In incus mode the re-pin runs INSIDE the container against the container .env
  # (/root/.luna/.env), NOT the host --luna-home .env; print the path that the
  # concrete command below actually touches so the plan does not contradict it.
  if [[ -n "$INCUS_CONTAINER" ]]; then
    printf '4. re-pin LUNA_CLAUDE_CODE_EXECUTABLE in /root/.luna/.env (in container)\n'
  else
    printf '4. re-pin LUNA_CLAUDE_CODE_EXECUTABLE in %s\n' "$ENV_FILE"
  fi
  if [[ "$SUPERVISOR" == "launchd" ]]; then
    printf '5. launchctl bootout gui/%s/%s + settle %ss + bootstrap gui/%s %s\n' \
      "$UID" "$LAUNCHD_LABEL" "$RESTART_SETTLE_SECS" "$UID" "$LAUNCHD_PLIST"
  elif [[ "$SYSTEMD_USER" == true ]]; then
    printf '5. systemctl --user daemon-reload + stop + settle %ss + start %s\n' "$RESTART_SETTLE_SECS" "$SERVICE_NAME"
  else
    printf '5. systemctl daemon-reload + stop + settle %ss + start %s\n' "$RESTART_SETTLE_SECS" "$SERVICE_NAME"
  fi
  if [[ "$SUPERVISOR" == "launchd" ]]; then
    restart_count_term="runs-stable"
  else
    restart_count_term="NRestarts-stable"
  fi
  printf '6. readiness probe: is-active + %s + curl http://127.0.0.1:%s/healthz==200 + /readyz mode=normal (<=%ss)\n' \
    "$restart_count_term" "$READINESS_PORT" "$READINESS_TIMEOUT"
  printf '7. on readiness OK: seed V2 dream/wake job rows via dream-wake-install.ts (idempotent, best-effort)\n'
  if [[ "$ROLLBACK" == true ]]; then
    printf '8. on readiness FAIL: reset --hard PREV, re-install if lock reverted, re-pin claude, restart, re-probe (ROLLED BACK)\n'
    printf '   if rollback also fails: CRITICAL, exit 2\n'
  else
    printf '8. rollback DISABLED (--no-rollback): on readiness FAIL, exit 1 without reverting\n'
  fi
  # Show the concrete commands that WOULD run, executing nothing. These route
  # exactly as the live path: git on the host, bun/systemctl via run_target
  # (incus exec in incus mode).
  git_target fetch origin
  git_target reset --hard "$REF"
  run_target "$BUN_BIN" install --cwd "$CONTAINER_REPO_DIR" --frozen-lockfile
  run_target "$BUN_BIN" run --cwd "$CONTAINER_REPO_DIR" --filter "@luna/ui-web" build
  if [[ -n "$INCUS_CONTAINER" ]]; then
    run_target bash -lc \
      "source /root/luna/scripts/lib/luna-deploy.sh && luna_configure_claude_executable /root/.luna/.env /root/luna"
  fi
  restart_service
  run_target "$BUN_BIN" run "$CONTAINER_REPO_DIR/apps/ui-web/scripts/dream-wake-install.ts"
  luna_info "Dry run complete; no changes made."
  exit 0
fi

# --- post-deploy: seed V2 dream/wake job rows --------------------------------
# The scheduler-v2 migration (DESIGN §5.3.5) DISABLES the legacy dream/wake cron
# layers and drives BOTH cycles from durable `jobs` rows instead. Those rows are
# created by dream-wake-install.ts, which is IDEMPOTENT (skip-if-exists, no
# --force). If a promotion ships the migration but the rows were never seeded,
# wake + dream silently go dark — observed on stable 2026-06-15 (legacy cron off
# + no V2 rows = no driver). Seeding on every HEALTHY deploy closes that gap so
# the cycles self-heal on promotion.
#
# Routed through run_target so it executes in the SAME scope as the server (host
# for bare-host stable, inside the container for incus dev) — matching how
# bun install runs — so it resolves the SAME ~/.luna/luna.db.
#
# BEST-EFFORT: the deploy has already succeeded and the server is healthy, so a
# seed failure must only WARN, never fail the deploy or trip rollback. Always
# returns 0 (callers also guard with `|| true`).
seed_dream_wake_jobs() {
  local script="$CONTAINER_REPO_DIR/apps/ui-web/scripts/dream-wake-install.ts"
  luna_info "post-deploy: seeding V2 dream/wake job rows (idempotent)"
  if run_target "$BUN_BIN" run "$script"; then
    luna_info "post-deploy: dream/wake job rows ensured"
  else
    luna_warn "post-deploy: dream/wake seed FAILED (non-fatal); if wake/dream go dark, run manually: $BUN_BIN run $script"
  fi
  return 0
}

# --- rollback ----------------------------------------------------------------
# Single rollback path used for EVERY forward failure — whether the new version
# failed its health probe OR a forward command (bun install / restart) errored.
# Returns nothing: it always exits. Exit 1 = recovered to PREV; exit 2 = CRITICAL
# (rollback itself failed, by command error OR by failing its own health probe).
do_rollback() {
  luna_warn "ROLLING BACK to $PREV"
  write_transaction "rolling-back" || true
  TRANSACTION_TRACK_APPLY=false
  EXPECTED_BUILD_SHA="$PREV"
  local ok=true
  apply_ref "$PREV" "$(lockfile_hash)" --no-fetch || ok=false
  if [[ "$ok" == true ]]; then
    restart_service || ok=false
  fi
  if [[ "$ok" == true ]]; then
    local rollback_baseline
    rollback_baseline="$(readiness_restart_baseline)"
    if readiness_ok "$rollback_baseline"; then
      luna_warn "update to $REF failed — ROLLED BACK to $PREV ($SERVICE_NAME healthy)"
      clear_transaction
      exit 1
    fi
  fi
  # Remediation hint must match the supervisor — pointing a macOS operator at
  # `systemctl`/`journalctl` during an outage sends them to dead-ends.
  local hint
  if [[ "$SUPERVISOR" == "launchd" ]]; then
    hint="launchctl print gui/$UID/$LAUNCHD_LABEL; log show --last 10m --predicate 'process == \"bun\"'"
  elif [[ "$SYSTEMD_USER" == true ]]; then
    hint="systemctl --user status $SERVICE_NAME; journalctl --user -u $SERVICE_NAME"
  else
    hint="systemctl status $SERVICE_NAME; journalctl -u $SERVICE_NAME"
  fi
  printf 'CRITICAL: update to %s failed AND rollback to %s also failed — server may be DOWN. Manual intervention required (check: %s).\n' \
    "$REF" "$PREV" "$hint" >&2
  write_transaction "rollback-failed" || true
  exit 2
}

# Handle a forward-path failure: roll back if enabled, else die at the new ref.
fail_forward() {
  local reason="$1"
  luna_warn "update to $REF failed: $reason (HEAD=${NEW_HEAD:-$REF})"
  if [[ "$ROLLBACK" == false ]]; then
    write_transaction "forward-failed" || true
    luna_die "$reason and --no-rollback set; server left at ${NEW_HEAD:-$REF} (may be unhealthy)"
  fi
  do_rollback
}

# --- live update --------------------------------------------------------------
if ! acquire_update_lock; then
  # Contention is a safe defer, not an update failure. The timer retries.
  exit 0
fi

NEW_HEAD=""
if [[ -f "$UPDATE_JOURNAL" ]]; then
  if ! load_transaction; then
    printf 'CRITICAL: corrupt update transaction journal %s — refusing to mutate the checkout; inspect or remove it manually.\n' "$UPDATE_JOURNAL" >&2
    exit 2
  fi
  PREV="$TX_PREV"
  REF="$TX_TARGET"
  PREV_LOCK_HASH="$TX_PREV_LOCK_HASH"
  luna_warn "RECOVERING interrupted update phase=$TX_PHASE prev=${PREV:0:9} target=${REF:0:9}"
  if [[ "$TX_PHASE" == "rolling-back" || "$TX_PHASE" == "rollback-failed" ]]; then
    do_rollback
  fi
else
  PREV="$(git_target_capture rev-parse HEAD)"
  [[ -n "$PREV" ]] || luna_die "could not read current HEAD in $HOST_REPO_DIR"
  PREV_LOCK_HASH="$(lockfile_hash)"
  luna_info "Current HEAD: $PREV"

  # Resolve the requested moving ref to an immutable commit while holding the
  # profile lock. The journal always records this exact target, so recovery can
  # finish the same transaction even if origin advances again meanwhile.
  REQUESTED_REF="$REF"
  git_target fetch origin || luna_die "fetch failed before update; checkout unchanged"
  if [[ "$REQUESTED_REF" =~ ^[0-9a-fA-F]{7,64}$ ]]; then
    REF="$REQUESTED_REF"
  else
    REF="$(git_target_capture rev-parse "${REQUESTED_REF}^{commit}")"
  fi
  [[ "$REF" =~ ^[0-9a-fA-F]{7,64}$ ]] || luna_die "could not resolve target ref $REQUESTED_REF"
  write_transaction "prepared"
fi

# A forward command-level failure (fetch/reset/install) routes into rollback —
# NOT a `set -e` abort. This is the whole point of auto-rollback.
TRANSACTION_TRACK_APPLY=true
if ! apply_ref "$REF" "$PREV_LOCK_HASH" --no-fetch; then
  TRANSACTION_TRACK_APPLY=false
  fail_forward "apply to $REF errored"
fi
TRANSACTION_TRACK_APPLY=false
NEW_HEAD="$(git_target_capture rev-parse HEAD)"
luna_info "Checked out: $NEW_HEAD"
write_transaction "applied"

write_transaction "restarting"
if ! restart_service; then
  fail_forward "service restart errored"
fi
# Capture NRestarts right AFTER issuing the restart; require it not to climb
# during the probe window (a climbing count means the unit is crash-looping).
RESTART_BASELINE="$(readiness_restart_baseline)"
EXPECTED_BUILD_SHA="$NEW_HEAD"
write_transaction "verifying"

if readiness_ok "$RESTART_BASELINE"; then
  luna_info "updated $PREV -> $NEW_HEAD ($SERVICE_NAME healthy)"
  seed_dream_wake_jobs || true
  clear_transaction
  exit 0
fi

fail_forward "failed readiness"
