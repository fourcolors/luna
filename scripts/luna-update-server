#!/usr/bin/env bash
# Update an installed Luna server to a target git ref, with auto-rollback.
#
# This is the "update the backend over time" half of the install/update plan.
# Today, updating Luna means SSHing in and running git pull + bun install +
# systemctl restart by hand, with no safety net. This script makes that one
# repeatable command that AUTOMATICALLY ROLLS BACK if the new version fails its
# readiness probe — so a bad update can't take the server down.
#
# Two host shapes share ONE sequence via a "runner" prefix:
#   - bare-host (default): run git/bun/systemctl/curl directly (as root on the box).
#   - --incus <container>: the script runs on the jax-box HOST and routes each step
#     to where it belongs. git ops run DIRECTLY on the host repo mount (the
#     container sees it via bind-mount); bun install / daemon-reload / restart /
#     the readiness curl run INSIDE the container via `incus exec <container> -- ...`.
#
#   Incus path conventions (mirror luna-container-create / luna-server-install):
#     - HOST_REPO_DIR  = /root/luna/<profile>/repo   (host-side git clone; default
#                        derived from --profile, overridable with --repo-dir). This
#                        is bind-mounted to /root/luna INSIDE the container.
#     - CONTAINER_REPO_DIR = /root/luna              (always, in-container view).
#     - unit           = luna_service_name(profile)  (stable -> luna-chat-server.service,
#                        dev -> luna-dev-chat-server.service). The container name
#                        (--incus <container>, e.g. luna-dev) is ONLY the exec target;
#                        paths/unit derive from --profile, never the container name.
#     - readiness port = 4753 (ALWAYS the container-internal port; we curl
#                        127.0.0.1:4753 INSIDE the container, never the host proxy
#                        4753/5753).
#
# This targets the SYSTEM systemd unit (the unit luna-server-install renders under
# /etc/systemd/system, in-container for the incus path). A host running a
# hand-edited `systemctl --user` unit (like the current jax master) is OUT OF SCOPE
# — the script refuses to proceed rather than silently restart the wrong scope
# (see the user-unit guard).

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/luna-deploy.sh
source "$SCRIPT_DIR/lib/luna-deploy.sh"

export HOME="${HOME:-/root}"

PROFILE="${LUNA_PROFILE:-stable}"
# REPO_DIR is the operator-facing repo path. In bare-host mode it is BOTH the git
# cwd and the bun --cwd (default /root/luna). In --incus mode it is only the HOST
# git mount; if the operator did NOT pass --repo-dir we DERIVE it from --profile
# (/root/luna/<profile>/repo, the luna-container-create mount convention) — the
# in-container bun/cwd is always /root/luna. After arg parse we resolve
# HOST_REPO_DIR (git cwd, on the host) and CONTAINER_REPO_DIR (bun --cwd / probe
# cwd, inside the container) so the git-on-host / rest-in-container split is
# explicit. REPO_DIR_EXPLICIT distinguishes "operator passed --repo-dir" from the
# default so the incus path only auto-derives when the operator stayed silent.
REPO_DIR="${LUNA_REPO_DIR:-/root/luna}"
REPO_DIR_EXPLICIT=false
[[ -n "${LUNA_REPO_DIR:-}" ]] && REPO_DIR_EXPLICIT=true
LUNA_HOME="${LUNA_HOME:-/root/.luna}"
SERVICE_DIR="${LUNA_SERVICE_DIR:-/etc/systemd/system}"
SERVICE_NAME=""
REF=""
INCUS_CONTAINER=""
DRY_RUN=false
ROLLBACK=true
# In-primitive session guard (phase 2): the guard lives HERE, in the restart
# primitive, so no caller-side flag can skip it. GUARD_SESSIONS is only ever
# flipped false internally (do_rollback, and only when a forward restart
# already interrupted service — see FORWARD_RESTART_RAN). OPERATOR_OVERRIDE_REASON
# is the sole, human-only override lever; it must carry a logged reason.
# RESTART_ONLY selects the cheap repair rung: guarded stop-settle-start +
# readiness, no checkout mutation, no rollback.
# FORWARD_RESTART_RAN scopes the rollback guard exemption: an apply-phase
# failure (bun install / SPA build error) rolls back while the OLD server is
# still running and serving, so that rollback restart must stay guarded — the
# exemption is earned only once a forward restart has actually interrupted
# service (or a mid-rollback journal is being recovered, where the interruption
# already began in a prior run).
GUARD_SESSIONS=true
OPERATOR_OVERRIDE_REASON=""
RESTART_ONLY=false
FORWARD_RESTART_RAN=false
# Readiness probe knobs (overridable so the hermetic tests run in ~seconds and
# never hang). curl is bounded per-attempt by --max-time; the overall poll is
# bounded by READINESS_TIMEOUT. Probe target port defaults to the chat server's
# WebSocket/health port (4753).
READINESS_PORT="${LUNA_READINESS_PORT:-4753}"
READINESS_TIMEOUT="${LUNA_READINESS_TIMEOUT:-60}"
READINESS_INTERVAL="${LUNA_READINESS_INTERVAL:-2}"
READINESS_CURL_MAX_TIME="${LUNA_READINESS_CURL_MAX_TIME:-5}"
# Post-stop settle (deploy-reliability). We restart the unit as stop -> settle ->
# start, NOT a fast `systemctl restart`. `systemctl stop` returns once the unit's
# cgroup is torn down, but the outgoing process's DuckDB/SQLite WAL/SHM handles
# can take a moment longer to flush+release (async checkpoint, child reaping, and
# on the --incus bind-mount, host fs cache coherence). A fast `restart` can open
# the DBs from the new process while those handles are still held, crashing the
# boot with "unable to open database file" (SQLITE_CANTOPEN) -> the readiness gate
# then trips a needless auto-rollback. The settle closes that gap. Overridable so
# the hermetic tests set 0 and stay fast (a real deploy uses the default).
RESTART_SETTLE_SECS="${LUNA_RESTART_SETTLE_SECS:-6}"

usage() {
  cat <<'EOF'
Usage: scripts/luna-update-server [options]

Updates an installed Luna server to a target git ref. After restarting the
service it runs a bounded readiness probe; if the new version fails to come up
healthy it AUTOMATICALLY ROLLS BACK to the previous commit and restarts again.

Options:
  --profile <name>          Runtime profile -> unit name. Default: stable.
  --repo-dir <path>         Server git clone to update. Default: /root/luna
                            (bare-host). With --incus, the HOST git mount; default
                            derived from --profile: /root/luna/<profile>/repo.
  --luna-home <path>        Luna state path (holds .env). Default: /root/.luna.
  --ref <git-ref>           Target ref to update to.
                            Default: origin/<current-branch>, or origin/master
                            if the checkout is detached.
  --service-dir <path>      systemd unit directory. Default: /etc/systemd/system.
  --service-name <name>     Override generated unit name.
  --incus <container>       Update an Incus container (e.g. luna-dev / luna-stable)
                            instead of a bare host. The script runs on the jax-box
                            HOST: git ops hit the host repo mount
                            (/root/luna/<profile>/repo, bind-mounted to /root/luna
                            in the container); bun install / daemon-reload / restart
                            and the readiness probe run INSIDE <container> via
                            `incus exec`. The readiness curl targets the
                            container-internal port (4753), not the host proxy.
                            Pair with --profile so paths/unit derive correctly
                            (e.g. --profile dev --incus luna-dev).
  --readiness-timeout <s>   Overall readiness poll budget. Default: 60.
  --readiness-interval <s>  Seconds between readiness attempts. Default: 2.
  --readiness-port <port>   Port for the /healthz probe. Default: 4753.
  --restart-settle <s>      Seconds to wait between `systemctl stop` and `start`
                            so the outgoing process releases its DuckDB/SQLite
                            WAL/SHM handles before the new one opens them (avoids
                            SQLITE_CANTOPEN on boot). Default: 6.
  --no-rollback             Do not auto-roll-back on readiness failure (advanced).
  --operator-override <reason>
                            HUMAN-ONLY override of the in-primitive session
                            guard. Requires a non-empty reason, which is logged
                            (journalctl of the invoking unit) as the audit
                            trail. Automation must never construct this flag.
  --restart-only            Repair rung 1: plain guarded stop -> settle -> start
                            + readiness probe. No checkout mutation, no bun
                            install/build, no rollback. A pending update
                            transaction runs normal recovery instead.
  --layout <inplace|releases>
                            Deploy layout. inplace (default): today's mutate-
                            the-checkout-in-place behaviour, unchanged.
                            releases: content-addressed immutable releases
                            under <deploy-root>/releases/<sha>, fetched only
                            into <deploy-root>/mirror.git, served through the
                            <deploy-root>/current symlink which is flipped
                            ATOMICALLY inside the guarded restart window.
                            git reset --hard never runs in releases mode.
  --deploy-root <path>      Releases layout root (holds mirror.git/, releases/,
                            current, previous). Required with --layout releases.
  --releases-keep <n>       Releases retention count (>= 2). Default: 3.
  --materialize             Releases-layout bootstrap: fetch the mirror,
                            materialize + build releases/<sha> for --ref and
                            create current if absent. NO restart, NO unit
                            interaction — inert while units still reference the
                            in-place checkout (see docs/deploy-layout-migration.md).
  --dry-run                 Print the plan and change NOTHING.
  --supervisor   <systemd|launchd>   supervisor backend (default: systemd; env: LUNA_SUPERVISOR)
  --user                             use systemd --user scope (systemd only)
  --launchd-label <label>            launchd service label (default: com.user.luna-chat-server; env: LUNA_LAUNCHD_LABEL)
  --launchd-plist <path>             full path to launchd plist (default: ~/Library/LaunchAgents/<label>.plist; env: LUNA_LAUNCHD_PLIST)
  -h, --help                Show this help.

Exit codes:
  0  updated and healthy.
  1  preflight error, OR readiness failed but rollback succeeded.
  2  CRITICAL: readiness failed AND rollback also failed (server may be down;
     manual intervention required).
  3  deferred by the session guard (live or unknown sessions); fresh run:
     nothing mutated; mid-transaction: journal retained and resumed when idle;
     apply-phase rollback: checkout already restored to PREV, old server still
     serving, journal retained (phase=rolling-back) and resumed when idle.
  4  --restart-only only: deferred because another update already holds the
     profile lock (repair-rung contention). Distinct from 3 on purpose: no
     session-guard defer happened, and reporting it as one would send the
     on-call responder hunting for phantom live sessions.
EOF
}

SUPERVISOR="${LUNA_SUPERVISOR:-systemd}"       # systemd | launchd
SYSTEMD_USER=false                              # --user flag
# Releases layout (phase 4). LAYOUT selects the mutation strategy at the
# git_target waist and the apply/rollback dispatchers; everything else (guard,
# journal, readiness, supervisor) is SHARED. CONTAINER_DEPLOY_ROOT is the
# in-container view of the deploy root (the luna-repo bind mount target);
# LUNA_CONTAINER_DEPLOY_ROOT is the migration-bootstrap seam (the runbook's
# temporary additive mount uses /root/luna-deploy). RESTART_PRESTART_HOOK is
# the command restart_service runs BETWEEN confirmed stop+settle and start —
# set ONLY by releases-mode deploy/rollback to the current-symlink flip, never
# by --restart-only, so a session-guard defer leaves current UNTOUCHED and
# there is never a current-vs-served divergence window.
LAYOUT="inplace"
DEPLOY_ROOT=""
RELEASES_KEEP=3
MATERIALIZE_ONLY=false
CONTAINER_DEPLOY_ROOT="${LUNA_CONTAINER_DEPLOY_ROOT:-/root/luna}"
CONTAINER_ENV_FILE="${LUNA_CONTAINER_ENV_FILE:-/root/.luna/.env}"
RESTART_PRESTART_HOOK=()
MIRROR_GIT=""
RELEASES_DIR=""
CURRENT_LINK=""
PREVIOUS_LINK=""
LAUNCHD_LABEL="${LUNA_LAUNCHD_LABEL:-com.user.luna-chat-server}"
LAUNCHD_PLIST="${LUNA_LAUNCHD_PLIST:-$HOME/Library/LaunchAgents/${LAUNCHD_LABEL}.plist}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile) PROFILE="${2:?missing --profile value}"; shift 2 ;;
    --repo-dir) REPO_DIR="${2:?missing --repo-dir value}"; REPO_DIR_EXPLICIT=true; shift 2 ;;
    --luna-home) LUNA_HOME="${2:?missing --luna-home value}"; shift 2 ;;
    --ref) REF="${2:?missing --ref value}"; shift 2 ;;
    --service-dir) SERVICE_DIR="${2:?missing --service-dir value}"; shift 2 ;;
    --service-name) SERVICE_NAME="${2:?missing --service-name value}"; shift 2 ;;
    --incus) INCUS_CONTAINER="${2:?missing --incus value}"; shift 2 ;;
    --readiness-timeout) READINESS_TIMEOUT="${2:?missing --readiness-timeout value}"; shift 2 ;;
    --readiness-interval) READINESS_INTERVAL="${2:?missing --readiness-interval value}"; shift 2 ;;
    --readiness-port) READINESS_PORT="${2:?missing --readiness-port value}"; shift 2 ;;
    --restart-settle) RESTART_SETTLE_SECS="${2:?missing --restart-settle value}"; shift 2 ;;
    --no-rollback) ROLLBACK=false; shift ;;
    --operator-override) OPERATOR_OVERRIDE_REASON="${2:?missing --operator-override reason}"; shift 2 ;;
    --restart-only) RESTART_ONLY=true; shift ;;
    --layout) LAYOUT="${2:?missing --layout value}"; shift 2 ;;
    --deploy-root) DEPLOY_ROOT="${2:?missing --deploy-root value}"; shift 2 ;;
    --releases-keep) RELEASES_KEEP="${2:?missing --releases-keep value}"; shift 2 ;;
    --materialize) MATERIALIZE_ONLY=true; shift ;;
    --dry-run) DRY_RUN=true; shift ;;
    --supervisor)  SUPERVISOR="${2:?missing --supervisor value}"; shift 2 ;;
    --user)        SYSTEMD_USER=true; shift ;;
    --launchd-label) LAUNCHD_LABEL="${2:?missing --launchd-label value}"; LAUNCHD_PLIST="$HOME/Library/LaunchAgents/${LAUNCHD_LABEL}.plist"; shift 2 ;;
    --launchd-plist) LAUNCHD_PLIST="${2:?missing --launchd-plist value}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) luna_die "unknown option: $1" ;;
  esac
done

# The ${2:?} above already rejects a MISSING value; this rejects a
# whitespace-only "reason" — an override without a reason is not an override.
[[ -z "$OPERATOR_OVERRIDE_REASON" || -n "${OPERATOR_OVERRIDE_REASON// }" ]] ||
  luna_die "--operator-override requires a non-empty reason"

luna_validate_profile "$PROFILE"

# Layout validation — same fail-loud posture as the registry loader: a typo'd
# layout must never silently degrade to inplace behaviour.
[[ "$LAYOUT" == "inplace" || "$LAYOUT" == "releases" ]] ||
  luna_die "invalid --layout: '$LAYOUT' (expected 'inplace' or 'releases')"
if [[ "$LAYOUT" == "releases" ]]; then
  [[ -n "$DEPLOY_ROOT" ]] ||
    luna_die "--layout releases requires --deploy-root (the registry passes it; see docs/deploy-layout-migration.md)"
  [[ "$DEPLOY_ROOT" == /* ]] || luna_die "--deploy-root must be an absolute path (got '$DEPLOY_ROOT')"
  [[ "$RELEASES_KEEP" =~ ^[0-9]+$ ]] && (( RELEASES_KEEP >= 2 )) ||
    luna_die "--releases-keep must be an integer >= 2 (got '$RELEASES_KEEP')"
  [[ "$SUPERVISOR" == "systemd" ]] ||
    luna_die "--layout releases supports only the systemd supervisor"
else
  [[ "$MATERIALIZE_ONLY" == false ]] || luna_die "--materialize requires --layout releases"
fi

# Supervisor validation — incompatible combinations are caught early before any
# mutating step so the operator sees a clear diagnosis, not a half-updated server.
# Reject an unknown value FIRST: the preflight branches `launchd`-vs-else while the
# sup_* functions branch `systemd`-vs-else, so a typo like `--supervisor sytemd`
# would split-brain (systemd preflight + launchctl restart). Fail clean instead.
[[ "$SUPERVISOR" == "systemd" || "$SUPERVISOR" == "launchd" ]] ||
  luna_die "invalid --supervisor: '$SUPERVISOR' (expected 'systemd' or 'launchd')"
if [[ "$SUPERVISOR" == "launchd" ]]; then
  # launchd is macOS-only; --incus targets a Linux container and is incompatible.
  [[ -z "$INCUS_CONTAINER" ]] || luna_die "--supervisor launchd is incompatible with --incus (launchd is macOS-only; containers run Linux systemd)"
  # --user is a systemd concept; launchd has no system/user split in the same sense.
  [[ "$SYSTEMD_USER" == false ]] || luna_die "--supervisor launchd is incompatible with --user (launchd has no system/user unit split)"
  # Require the launchctl binary so the error is clear before any mutating step.
  command -v launchctl >/dev/null 2>&1 || luna_die "--supervisor launchd requires launchctl (not found in PATH)"
fi
if [[ "$SYSTEMD_USER" == true && -n "$INCUS_CONTAINER" ]]; then
  luna_die "--user is incompatible with --incus (user units run on the bare host, not inside a container)"
fi

if [[ -z "$SERVICE_NAME" ]]; then
  SERVICE_NAME="$(luna_service_name "$PROFILE")"
fi

# For --user, default SERVICE_DIR to the XDG systemd user unit directory when the
# operator did not explicitly pass --service-dir / LUNA_SERVICE_DIR. This mirrors
# where `systemctl --user enable` expects to find units (or where a unit file was
# placed by the operator). The system default (/etc/systemd/system) would be wrong
# — units there are not visible to the user scope.
if [[ "$SYSTEMD_USER" == true && -z "${LUNA_SERVICE_DIR:-}" && "$SERVICE_DIR" == "/etc/systemd/system" ]]; then
  SERVICE_DIR="$HOME/.config/systemd/user"
fi
USER_UNIT_FILE="$SERVICE_DIR/$SERVICE_NAME"

# --- resolve the git-on-host / rest-in-container path split -------------------
# HOST_REPO_DIR    : where `git` runs (always on the HOST).
# CONTAINER_REPO_DIR: where `bun`/`systemctl` working dir lives (in-container in
#                     incus mode). In incus mode the host mount is bind-mounted
#                     to /root/luna inside the container, so the two differ; in
#                     bare-host mode both are REPO_DIR.
if [[ -n "$INCUS_CONTAINER" ]]; then
  # Default the host repo mount from the profile (luna-container-create maps
  # /root/luna/<profile>/repo -> /root/luna). --repo-dir overrides the HOST path.
  if [[ "$REPO_DIR_EXPLICIT" == true ]]; then
    HOST_REPO_DIR="$REPO_DIR"
  else
    HOST_REPO_DIR="/root/luna/${PROFILE}/repo"
  fi
  CONTAINER_REPO_DIR="/root/luna"
  # In-container bun: the host's bun path won't exist in the container, so resolve
  # the container's bun (the test seam LUNA_TEST_BUN_PATH still wins for hermetic
  # runs; on real jax it is the standard /root/.bun/bin/bun).
  BUN_BIN_INCUS="${LUNA_TEST_BUN_PATH:-/root/.bun/bin/bun}"
else
  HOST_REPO_DIR="$REPO_DIR"
  CONTAINER_REPO_DIR="$REPO_DIR"
fi

# Releases layout path resolution OVERRIDES the repo-dir conventions above:
# the operator-facing "repo" is the current release, always read THROUGH the
# atomically-flipped symlink. HOST_* paths are host-side (the bind-mount
# source); CONTAINER_* paths are what the in-container steps (bun --cwd,
# claude re-pin, dream-wake seed) use. In bare-host mode both views coincide.
if [[ "$LAYOUT" == "releases" ]]; then
  MIRROR_GIT="$DEPLOY_ROOT/mirror.git"
  RELEASES_DIR="$DEPLOY_ROOT/releases"
  CURRENT_LINK="$DEPLOY_ROOT/current"
  PREVIOUS_LINK="$DEPLOY_ROOT/previous"
  HOST_REPO_DIR="$CURRENT_LINK"
  if [[ -n "$INCUS_CONTAINER" ]]; then
    CONTAINER_REPO_DIR="$CONTAINER_DEPLOY_ROOT/current"
  else
    CONTAINER_REPO_DIR="$CURRENT_LINK"
    CONTAINER_DEPLOY_ROOT="$DEPLOY_ROOT"
  fi
fi

ENV_FILE="$LUNA_HOME/.env"
SERVICE_FILE="$SERVICE_DIR/$SERVICE_NAME"

# --- runner: the single seam that makes bare-host and incus share one path ----
# run_target executes a command on the update target. Bare-host -> direct; incus
# -> wrapped in `incus exec <container> --`. Every IN-CONTAINER step (bun install,
# daemon-reload, restart, claude re-pin) routes through this so the sequence is
# written once. git is the ONE exception: it always runs on the HOST (see
# git_target below), since the container reads the repo via bind-mount. In
# --dry-run run_target prints (via luna_run) and executes nothing.
run_target() {
  if [[ -n "$INCUS_CONTAINER" ]]; then
    luna_run incus exec "$INCUS_CONTAINER" -- "$@"
  else
    luna_run "$@"
  fi
}

# Same as run_target but used by the readiness probe, where we need the command's
# STDOUT captured even in non-dry-run (systemctl is-active / show NRestarts, curl
# /healthz + /readyz). In incus mode these run INSIDE the container, so the curl
# hits 127.0.0.1:<port> on the container loopback (NOT the host proxy). These are
# read-only probes; the readiness gate is only reached on the live (non-dry) path.
run_target_capture() {
  if [[ -n "$INCUS_CONTAINER" ]]; then
    incus exec "$INCUS_CONTAINER" -- "$@"
  else
    "$@"
  fi
}

# git ALWAYS runs on the HOST (never through run_target / incus exec): in incus
# mode the container sees the repo via a bind-mount, so the host git working on
# HOST_REPO_DIR mutates the very files the container reads. Routing git through
# `incus exec` would (a) require git inside the container and (b) operate on the
# in-container path — both wrong. So git_target is just luna_run (dry-run-aware),
# never run_target. git_target_capture runs git directly to capture stdout.
# Releases-layout fork at the narrow waist: EVERY network/ref git operation
# targets the bare mirror — the only thing any fetch ever touches. The current
# release keeps a real .git (a --local clone of the mirror), so identity reads
# (rev-parse HEAD for buildSha/repair/status) still go through $HOST_REPO_DIR
# via plain `git -C` at their call sites; git_target is the MUTATION/REF path.
git_target() {
  if [[ "$LAYOUT" == "releases" ]]; then
    luna_run git --git-dir "$MIRROR_GIT" "$@"
  else
    luna_run git -C "$HOST_REPO_DIR" "$@"
  fi
}

git_target_capture() {
  if [[ "$LAYOUT" == "releases" ]]; then
    git --git-dir "$MIRROR_GIT" "$@"
  else
    git -C "$HOST_REPO_DIR" "$@"
  fi
}

# --- preflight ----------------------------------------------------------------

luna_info "Updating Luna server profile: $PROFILE"
if [[ -n "$INCUS_CONTAINER" ]]; then
  printf 'Repo (host git mount): %s\n' "$HOST_REPO_DIR"
  printf 'Repo (in-container):   %s\n' "$CONTAINER_REPO_DIR"
  printf 'Service: %s (in container)\n' "$SERVICE_FILE"
  printf 'Target: incus container %s\n' "$INCUS_CONTAINER"
elif [[ "$SUPERVISOR" == "launchd" ]]; then
  printf 'Repo: %s\n' "$HOST_REPO_DIR"
  printf 'Service: %s (launchd plist: %s)\n' "$LAUNCHD_LABEL" "$LAUNCHD_PLIST"
  printf 'Target: macOS launchd (gui/%s)\n' "$UID"
elif [[ "$SYSTEMD_USER" == true ]]; then
  printf 'Repo: %s\n' "$HOST_REPO_DIR"
  printf 'Service: %s (systemd --user)\n' "$SERVICE_FILE"
  printf 'Target: bare host (user scope)\n'
else
  printf 'Repo: %s\n' "$HOST_REPO_DIR"
  printf 'Service: %s\n' "$SERVICE_FILE"
  printf 'Target: bare host\n'
fi

# The repo must be a git clone — updating a non-clone is meaningless. git runs on
# the HOST in BOTH modes (in incus mode HOST_REPO_DIR is the bind-mount source the
# host can always stat), so the check is the same host-side test for both shapes.
# Releases layout replaces this with the mirror + current-release shape checks:
# the mirror must be bare WITH the explicit remote.origin.fetch refspec
# (git clone --bare creates NO fetch refspec, and without one every caller's
# origin/<branch> spelling would silently stop resolving new commits), and
# current must resolve into releases/ with a .complete marker — except under
# --materialize, whose whole job is to create the first release/current.
if [[ "$LAYOUT" == "releases" ]]; then
  [[ -d "$MIRROR_GIT" ]] ||
    luna_die "mirror $MIRROR_GIT not found; create it per docs/deploy-layout-migration.md"
  [[ "$(git --git-dir "$MIRROR_GIT" rev-parse --is-bare-repository 2>/dev/null)" == "true" ]] ||
    luna_die "$MIRROR_GIT is not a bare git repository"
  MIRROR_REFSPEC="$(git --git-dir "$MIRROR_GIT" config --get remote.origin.fetch 2>/dev/null || true)"
  [[ "$MIRROR_REFSPEC" == *"refs/remotes/origin/"* ]] ||
    luna_die "$MIRROR_GIT lacks the remote.origin.fetch refspec mapping to refs/remotes/origin/* (LOAD-BEARING: clone --bare creates none); run: git --git-dir $MIRROR_GIT config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'"
  if [[ "$MATERIALIZE_ONLY" == false ]]; then
    _cur_resolved="$(cd -P "$CURRENT_LINK" 2>/dev/null && pwd || true)"
    _rel_resolved="$(cd -P "$RELEASES_DIR" 2>/dev/null && pwd || true)"
    [[ -n "$_cur_resolved" && -n "$_rel_resolved" && "$_cur_resolved" == "$_rel_resolved/"* &&
       -f "$_cur_resolved/.complete" ]] ||
      luna_die "$CURRENT_LINK does not resolve to a complete release under $RELEASES_DIR; bootstrap with --materialize per docs/deploy-layout-migration.md"
  fi
else
  [[ -d "$HOST_REPO_DIR/.git" ]] || luna_die "$HOST_REPO_DIR is not a git clone"
fi

# Unit-existence preflight: confirm the supervisor artifact (systemd unit or launchd
# plist) actually exists before we mutate the repo. Running without one means we
# would update the code but have no way to restart the service — a silent half-deploy.
# Dry-run is exempt: it prints the plan without touching anything, so a missing unit
# should not block a dry inspection of what WOULD happen. --materialize is also
# exempt: it is the inert releases bootstrap that touches NO unit and issues NO
# restart, and it deliberately runs while units still reference the old layout.
if [[ "$DRY_RUN" == false && "$MATERIALIZE_ONLY" == false ]]; then
  if [[ "$SUPERVISOR" == "launchd" ]]; then
    [[ -f "$LAUNCHD_PLIST" ]] ||
      luna_die "launchd plist $LAUNCHD_PLIST not found; create it (e.g. via render_launchd_plist) before running luna-update-server"
  elif [[ -n "$INCUS_CONTAINER" ]]; then
    # The unit is a CONTAINER-FS artifact (the in-container luna-server-install
    # renders it under /etc/systemd/system), so probe it inside the container.
    incus exec "$INCUS_CONTAINER" -- test -f "$SERVICE_FILE" ||
      luna_die "system unit $SERVICE_FILE not found in container $INCUS_CONTAINER; \
run luna-server-install inside the container first"
  elif [[ "$SYSTEMD_USER" == true ]]; then
    [[ -f "$USER_UNIT_FILE" ]] ||
      luna_die "systemd user unit $USER_UNIT_FILE not found; \
copy or symlink your unit there (e.g. cp my.service $USER_UNIT_FILE) then run systemctl --user daemon-reload"
  else
    [[ -f "$SERVICE_FILE" ]] ||
      luna_die "system unit $SERVICE_FILE not found; \
run luna-server-install to create it, or pass --supervisor launchd / --user for non-system-unit hosts"
  fi
fi

# Resolve the default ref now that we know the repo is real. Default to the
# remote-tracking branch of the current checkout; fall back to origin/master if
# detached. git runs on the host in BOTH modes, so HOST_REPO_DIR's HEAD is
# readable for the incus path too.
# Releases layout: there is NO default — the current release is a detached
# checkout by construction, so the inplace fallback would silently degrade
# every run to origin/master. The registry always passes --ref origin/<branch>;
# a missing ref is a caller bug that must fail loudly.
if [[ "$LAYOUT" == "releases" && -z "$REF" ]]; then
  luna_die "--layout releases requires an explicit --ref (the registry passes --ref origin/<branch>; a detached current release must never default to origin/master)"
fi
if [[ -z "$REF" ]]; then
  CUR_BRANCH=""
  if [[ -d "$HOST_REPO_DIR/.git" ]]; then
    CUR_BRANCH="$(git -C "$HOST_REPO_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  fi
  if [[ -n "$CUR_BRANCH" && "$CUR_BRANCH" != "HEAD" ]]; then
    REF="origin/$CUR_BRANCH"
  else
    REF="origin/master"
  fi
fi
printf 'Target ref: %s\n' "$REF"

# Bun: in incus mode it runs INSIDE the container, so resolve the container's bun
# (BUN_BIN_INCUS, set during path resolution). In bare-host mode resolve the
# host's bun as before.
if [[ -n "$INCUS_CONTAINER" ]]; then
  BUN_BIN="$BUN_BIN_INCUS"
else
  BUN_BIN="$(luna_find_bun)"
fi

# --- helpers: lockfile-change detection (portable; no sha256sum) --------------
# git hash-object is the portable "hash of bun.lock" (matches the spec's "hash"
# wording) and avoids sha256sum, which does NOT exist on macOS where the
# hermetic test runs the real script. Empty string if the file is missing.
# bun.lock lives on the HOST repo mount and git is host-side, so this is a purely
# host-side hash in BOTH modes (HOST_REPO_DIR is the bind-mount source on incus).
lockfile_hash() {
  if [[ -f "$HOST_REPO_DIR/bun.lock" ]]; then
    git -C "$HOST_REPO_DIR" hash-object "$HOST_REPO_DIR/bun.lock" 2>/dev/null || printf ''
  else
    printf ''
  fi
}

# --- releases layout helpers (phase 4) ----------------------------------------
# The mutation surface of the releases layout, all host-side unless noted:
#   deployed_sha        — resolve current -> releases/<sha>, fail closed
#   mirror_lock_blob    — bun.lock blob id at a sha, read from the mirror
#   materialize_release — immutable build: clone --local + detach + install +
#                         build + .complete LAST (publish_engine idiom)
#   flip_current        — previous := outgoing current, then staged ln + mv -fT
#                         + cd -P re-resolve assert on BOTH mount sides
#   repin_claude_releases — through-current claude pin with read-back
#   prune_releases      — retention with the prune_engines protection discipline

# deployed_sha — print the sha of the release current resolves to. Returns
# non-zero (and prints nothing usable) when current is absent, dangling, does
# not land inside releases/, is not named by a full sha, or lacks .complete.
# Callers die or map the failure to INCONCLUSIVE — first-deploy and corruption
# both fail closed, never degrade to a guess.
deployed_sha() {
  local dir sha rel_phys
  dir="$(cd -P "$CURRENT_LINK" 2>/dev/null && pwd)" || return 1
  rel_phys="$(cd -P "$RELEASES_DIR" 2>/dev/null && pwd)" || return 1
  [[ "$dir" == "$rel_phys/"* ]] || return 1
  sha="${dir##*/}"
  [[ "$sha" =~ ^[0-9a-f]{40}$ ]] || return 1
  [[ -f "$dir/.complete" ]] || return 1
  printf '%s' "$sha"
}

# mirror_lock_blob <sha> — the git blob id of bun.lock at <sha>, read from the
# bare mirror. Empty when the file/sha is unavailable (treated as "changed",
# which forces the safe fresh-install path).
mirror_lock_blob() {
  git --git-dir "$MIRROR_GIT" rev-parse --verify -q "$1:bun.lock" 2>/dev/null || printf ''
}

# release_artifacts_ok <release-dir> — the reuse gate: .complete AND
# node_modules AND a non-empty SPA entry point. Host-side stats (the host can
# always stat the bind-mount source).
release_artifacts_ok() {
  local rel="$1"
  [[ -f "$rel/.complete" && -d "$rel/node_modules" && -s "$rel/apps/ui-web/dist/index.html" ]]
}

# _build_release_tree <build_dir> <crel> <sha> [prev_lock_blob] — the shared
# build body: clone --local + detach + HEAD postcondition + seed + install +
# build + .complete LAST. <build_dir> is the host-side tree being built (either
# the final releases/<sha> or a staged sibling); <crel> is its in-container
# spelling. Every step is `|| return 1`; the CALLER owns cleanup of a failed
# tree (materialize_release removes it — a failed build tree is never the
# serving tree, so removing it cannot touch what current serves).
_build_release_tree() {
  local build_dir="$1" crel="$2" sha="$3" prev_lock_blob="${4:-}"
  local head_now new_lock cur_sha
  luna_run git clone --no-checkout --local "$MIRROR_GIT" "$build_dir" || return 1
  luna_run git -C "$build_dir" checkout --detach "$sha" || return 1
  # POSTCONDITION: the release identifies as exactly the target sha — this IS
  # the identity chain buildSha/repair/status read later, so it must be proven
  # at build time, not assumed.
  head_now="$(git -C "$build_dir" rev-parse HEAD 2>/dev/null || true)"
  if [[ "${head_now,,}" != "${sha,,}" ]]; then
    luna_warn "POSTCONDITION: release checkout HEAD is '${head_now:-unreadable}', expected $sha — refusing to continue"
    return 1
  fi
  # node_modules seeding: when the mirror says bun.lock is byte-identical
  # between the deployed release and the target, seed via plain cp -a (NEVER
  # hardlinks: bun rewriting a shared inode would corrupt the immutable
  # previous release). The frozen install still runs after seeding — on a
  # satisfied tree it is a fast no-op check, and the node_modules
  # postcondition below is unchanged either way.
  new_lock="$(mirror_lock_blob "$sha")"
  if [[ -n "$prev_lock_blob" && -n "$new_lock" && "$new_lock" == "$prev_lock_blob" ]]; then
    cur_sha="$(deployed_sha 2>/dev/null || true)"
    if [[ -n "$cur_sha" && -d "$RELEASES_DIR/$cur_sha/node_modules" ]]; then
      luna_info "bun.lock unchanged (blob ${new_lock:0:12}) -> seeding node_modules from release ${cur_sha:0:12} (cp -a)"
      if ! cp -a "$RELEASES_DIR/$cur_sha/node_modules" "$build_dir/node_modules"; then
        luna_warn "node_modules seed failed; falling back to a fresh install"
        rm -rf "$build_dir/node_modules" || return 1
      fi
    fi
  fi
  run_target "$BUN_BIN" install --cwd "$crel" --frozen-lockfile || return 1
  # POSTCONDITION: the install's declared artifact exists (in-container view).
  if ! run_target test -d "$crel/node_modules"; then
    luna_warn "POSTCONDITION: bun install exited 0 but $crel/node_modules is missing"
    return 1
  fi
  run_target "$BUN_BIN" run --cwd "$crel" --filter "@luna/ui-web" build || return 1
  # POSTCONDITION: the build's declared artifact exists and is non-empty.
  if ! run_target test -s "$crel/apps/ui-web/dist/index.html"; then
    luna_warn "POSTCONDITION: ui-web build exited 0 but $crel/apps/ui-web/dist/index.html is missing or empty"
    return 1
  fi
  # Deliberate SIGKILL seam (tests): a crash BEFORE the marker must leave a
  # partial the next run sweeps and rebuilds — the publish_engine idiom.
  if [[ -n "${LUNA_TEST_CRASH_BEFORE_COMPLETE:-}" ]]; then
    kill -KILL "$$"
  fi
  # .complete is written LAST so a partial is never seen as complete.
  if ! touch "$build_dir/.complete" || [[ ! -f "$build_dir/.complete" ]]; then
    luna_warn "POSTCONDITION: could not publish $build_dir/.complete"
    return 1
  fi
  return 0
}

# materialize_release <sha> [prev_lock_blob] — build the immutable release
# checkout. Never touches current/previous. Every step is `|| return 1` so a
# failure routes to the caller (pre-flip: warn + exit 1, current untouched).
#
# INVARIANT (the serving-tree rule): this function never removes the tree
# `current` physically resolves to — that directory is the running unit's
# WorkingDirectory and the thing every failure message promises is untouched.
# When the DEPLOYED release's artifacts are damaged (the repair-rung-2 damage
# class: node_modules lost to disk-pressure cleanup), the rebuild happens in a
# staged sibling (releases/.stage.<sha>) and is swapped in ONLY once complete —
# a failed rebuild (bun registry unreachable at 3am) leaves the damaged-but-
# extant tree in place: current still resolves, the exit-1 "current untouched"
# routing stays true, and the preflight complete-release check still passes on
# the next attempt. Staged/failed build trees are removed on the way out so
# consecutive failing deploys of DISTINCT shas cannot accumulate unbounded
# multi-GB partials (retention only runs on healthy/rolled-back exits).
materialize_release() {
  local sha="$1" prev_lock_blob="${2:-}"
  local rel="$RELEASES_DIR/$sha" build_dir crel cur_phys rel_phys staged=false aside
  if [[ "$DRY_RUN" == true ]]; then
    if [[ -n "$INCUS_CONTAINER" ]]; then
      crel="$CONTAINER_DEPLOY_ROOT/releases/$sha"
    else
      crel="$rel"
    fi
    luna_run git clone --no-checkout --local "$MIRROR_GIT" "$rel"
    luna_run git -C "$rel" checkout --detach "$sha"
    run_target "$BUN_BIN" install --cwd "$crel" --frozen-lockfile
    run_target "$BUN_BIN" run --cwd "$crel" --filter "@luna/ui-web" build
    luna_run touch "$rel/.complete"
    return 0
  fi
  mkdir -p "$RELEASES_DIR" || return 1
  # Reuse gate: a COMPLETE release with intact artifacts is immutable and
  # rebuilt never — recovery and repair re-runs no-op here (content-addressed,
  # the guardian engine@<sha> idiom).
  if release_artifacts_ok "$rel"; then
    luna_info "release $sha already materialized and complete — reusing"
    return 0
  fi
  build_dir="$rel"
  if [[ -e "$rel" ]]; then
    cur_phys="$(cd -P "$CURRENT_LINK" 2>/dev/null && pwd || true)"
    rel_phys="$(cd -P "$rel" 2>/dev/null && pwd || true)"
    if [[ -n "$cur_phys" && "$cur_phys" == "$rel_phys" ]]; then
      # The DEPLOYED release with damaged artifacts: NEVER rm -rf it (see the
      # serving-tree rule above). Rebuild into a staged sibling and swap.
      staged=true
      build_dir="$RELEASES_DIR/.stage.$sha"
      luna_warn "deployed release $sha has damaged artifacts — rebuilding into a staged sibling (the serving tree stays in place until a complete swap)"
      rm -rf "$build_dir" || return 1
    else
      # A partial without .complete (crash mid-build) or a .complete whose
      # declared artifacts are damaged — and NOT the deployed release — is
      # swept and rebuilt from scratch.
      luna_warn "removing stale/incomplete release $sha and rebuilding"
      rm -rf "$rel" || return 1
    fi
  fi
  if [[ -n "$INCUS_CONTAINER" ]]; then
    crel="$CONTAINER_DEPLOY_ROOT/releases/${build_dir##*/}"
  else
    crel="$build_dir"
  fi
  if ! _build_release_tree "$build_dir" "$crel" "$sha" "$prev_lock_blob"; then
    # PRE-flip cleanup: by construction the failed tree is never the serving
    # tree (staged, or a non-deployed sha dir), so removing it is safe and
    # keeps distinct failing shas from leaking ~GB partials run after run.
    rm -rf "$build_dir" 2>/dev/null || true
    return 1
  fi
  if [[ "$staged" == true ]]; then
    # Swap the complete staged tree into place. The exposure window is two
    # renames (vs the whole multi-minute build); on any swap failure the
    # damaged-but-extant tree is restored so current never dangles.
    aside="$RELEASES_DIR/.old.$sha.$$"
    rm -rf "$aside" 2>/dev/null || true
    if ! mv -T "$rel" "$aside"; then
      luna_warn "POSTCONDITION: could not move damaged release $sha aside — deployed tree left untouched"
      rm -rf "$build_dir" 2>/dev/null || true
      return 1
    fi
    if ! mv -T "$build_dir" "$rel"; then
      mv -T "$aside" "$rel" 2>/dev/null || true
      luna_warn "POSTCONDITION: staged swap of release $sha did not land — damaged tree restored"
      rm -rf "$build_dir" 2>/dev/null || true
      return 1
    fi
    rm -rf "$aside" 2>/dev/null || true
    # POSTCONDITION: current still resolves into the (now rebuilt) release.
    cur_phys="$(cd -P "$CURRENT_LINK" 2>/dev/null && pwd || true)"
    rel_phys="$(cd -P "$rel" 2>/dev/null && pwd || true)"
    if [[ -z "$cur_phys" || "$cur_phys" != "$rel_phys" ]]; then
      luna_warn "POSTCONDITION: current no longer resolves to releases/$sha after the staged swap"
      return 1
    fi
  fi
  return 0
}

# flip_current <sha> — atomically point current at releases/<sha>, restamping
# previous to the OUTGOING target first (forward AND rollback: after a
# rollback, previous names the failed release, retained for forensics). All
# links are RELATIVE (an absolute link would dangle in-container — the bind
# mount pins the source, only in-tree symlinks propagate). A re-flip to the
# sha current already names (idempotent journal recovery) leaves previous
# untouched — restamping it would destroy the rollback target.
# Runs INSIDE the restart window (RESTART_PRESTART_HOOK): on failure it
# returns 1 with a POSTCONDITION-prefixed warn — never dies mid-primitive
# with the service stopped — so restart_service routes the failure to
# fail_forward -> rollback flip-back.
flip_current() {
  local sha="$1" outgoing_dir outgoing_sha="" linktmp resolved in_container_resolved
  if [[ "$DRY_RUN" == true ]]; then
    luna_run ln -sfT "releases/$sha" "$CURRENT_LINK"
    return 0
  fi
  if [[ ! -f "$RELEASES_DIR/$sha/.complete" ]]; then
    luna_warn "POSTCONDITION: refusing to flip current to releases/$sha — not a complete release"
    return 1
  fi
  outgoing_dir="$(cd -P "$CURRENT_LINK" 2>/dev/null && pwd || true)"
  if [[ -n "$outgoing_dir" ]]; then
    outgoing_sha="${outgoing_dir##*/}"
  fi
  if [[ -n "$outgoing_sha" && "$outgoing_sha" != "$sha" ]]; then
    linktmp="$PREVIOUS_LINK.tmp.$$"
    rm -f "$linktmp"
    if ! ln -s "releases/$outgoing_sha" "$linktmp" || ! mv -fT "$linktmp" "$PREVIOUS_LINK"; then
      rm -f "$linktmp" 2>/dev/null || true
      luna_warn "POSTCONDITION: could not restamp $PREVIOUS_LINK -> releases/$outgoing_sha"
      return 1
    fi
  fi
  # Staged ln + mv -fT: -T is load-bearing (mv onto an existing symlink-to-dir
  # would otherwise nest the new link INSIDE the old release — the engine-pin
  # regression class). Then PROVE the flip landed by physical re-resolution.
  linktmp="$CURRENT_LINK.tmp.$$"
  rm -f "$linktmp"
  if ! ln -s "releases/$sha" "$linktmp" || ! mv -fT "$linktmp" "$CURRENT_LINK"; then
    rm -f "$linktmp" 2>/dev/null || true
    luna_warn "POSTCONDITION: could not publish $CURRENT_LINK -> releases/$sha"
    return 1
  fi
  resolved="$(cd -P "$CURRENT_LINK" 2>/dev/null && pwd || true)"
  if [[ "${resolved##*/}" != "$sha" ]]; then
    luna_warn "POSTCONDITION: current flip did not land — $CURRENT_LINK resolves to '${resolved:-<unresolvable>}', expected releases/$sha"
    return 1
  fi
  # BOTH sides of the bind mount must witness the flip: the container is the
  # side that actually serves, and it runs even while the unit is stopped.
  if [[ -n "$INCUS_CONTAINER" ]]; then
    in_container_resolved="$(run_target_capture readlink -f "$CONTAINER_DEPLOY_ROOT/current" 2>/dev/null || true)"
    if [[ "$in_container_resolved" != */releases/"$sha" ]]; then
      luna_warn "POSTCONDITION: in-container $CONTAINER_DEPLOY_ROOT/current resolves to '${in_container_resolved:-<unreadable>}', expected .../releases/$sha"
      return 1
    fi
  fi
  return 0
}

# repin_claude_releases <sha> — graft 2: the keep-if-executable fast path is
# BYPASSED in releases mode (retained old releases keep old binaries
# executable forever, so the stale-pin detector would never fire). Detect the
# binary inside the NAMED release, rewrite the physical releases/<sha> prefix
# to the through-current spelling, write it with a read-back, and verify the
# PHYSICAL binary is executable (the through-current path only dereferences
# to this release once the flip lands — systemd reads EnvironmentFile at unit
# start, after the in-window flip, so the pin takes effect exactly with the
# release). Missing binary keeps the exit-9-style warn-only degrade.
repin_claude_releases() {
  local sha="$1"
  local rel="$RELEASES_DIR/$sha" detected through_current
  [[ "$DRY_RUN" == true ]] && return 0
  detected="$(
    find "$rel/node_modules" \
      -path '*/@anthropic-ai/claude-agent-sdk-linux-x64/claude' \
      -type f -perm -111 2>/dev/null |
      sort |
      tail -n 1
  )" || true
  if [[ -z "$detected" ]]; then
    if run_target bash -lc 'command -v claude >/dev/null 2>&1'; then
      return 0
    fi
    luna_warn "POSTCONDITION degraded: no usable claude executable in release ${sha:0:12} — server will boot but cannot spawn claude"
    return 0
  fi
  through_current="$CONTAINER_REPO_DIR${detected#"$rel"}"
  if [[ -n "$INCUS_CONTAINER" ]]; then
    # The container's .env is a container-FS artifact; write it in-container
    # sourcing the release's own lib copy (present pre-flip), then read back.
    run_target bash -lc \
      "source $CONTAINER_DEPLOY_ROOT/releases/$sha/scripts/lib/luna-deploy.sh && luna_upsert_env $CONTAINER_ENV_FILE LUNA_CLAUDE_CODE_EXECUTABLE '$through_current' && [[ \"\$(luna_env_value $CONTAINER_ENV_FILE LUNA_CLAUDE_CODE_EXECUTABLE)\" == '$through_current' ]]" || {
      luna_warn "POSTCONDITION: through-current claude pin write did not read back in-container"
      return 1
    }
  else
    luna_upsert_env "$ENV_FILE" "LUNA_CLAUDE_CODE_EXECUTABLE" "$through_current" || return 1
    if [[ "$(luna_env_value "$ENV_FILE" LUNA_CLAUDE_CODE_EXECUTABLE 2>/dev/null || true)" != "$through_current" ]]; then
      luna_warn "POSTCONDITION: through-current claude pin write did not read back in $ENV_FILE"
      return 1
    fi
  fi
  return 0
}

# prune_releases — retention at the END of a healthy deploy only. Protection
# discipline is a direct port of the guardian's prune_engines: protected =
# resolved(current) + resolved(previous) + any sha named in a live transaction
# journal; refuse-all when current OR previous dangles; postcondition
# re-resolves both links and is fatal ONLY when this run actually pruned
# (pre-existing corruption is warned with the right attribution, never blamed
# on prune).
prune_releases() {
  local keep="$RELEASES_KEEP" index=0 dir protected=" " cur prev_phys prev_sha="" pruned_any=false resolved jsha
  if ! cur="$(deployed_sha)"; then
    luna_warn "prune refused: $CURRENT_LINK does not resolve to a complete release; not pruning any releases this run"
    return 0
  fi
  protected+="$cur "
  if [[ -L "$PREVIOUS_LINK" || -e "$PREVIOUS_LINK" ]]; then
    if ! prev_phys="$(cd -P "$PREVIOUS_LINK" 2>/dev/null && pwd)"; then
      luna_warn "prune refused: $PREVIOUS_LINK does not resolve; not pruning any releases this run"
      return 0
    fi
    prev_sha="${prev_phys##*/}"
    if [[ ! -f "$prev_phys/.complete" ]]; then
      luna_warn "prune: previous resolves to a release missing its .complete marker (pre-existing corruption, not caused by prune; it stays protected)"
    fi
    protected+="$prev_sha "
  fi
  # A live journal names shas a crashed/recovering transaction still depends on.
  if [[ -f "$UPDATE_JOURNAL" ]]; then
    for jsha in "$(sed -n 's/^prev=//p' "$UPDATE_JOURNAL" | head -1)" \
                "$(sed -n 's/^target=//p' "$UPDATE_JOURNAL" | head -1)"; do
      [[ "$jsha" =~ ^[0-9a-fA-F]{7,64}$ ]] && protected+="$jsha "
    done
  fi
  # Stale staged build trees (.stage.<sha>, SIGKILL leftovers) are rebuildable
  # debris that is never the serving tree; sweep them unconditionally. (The
  # glob may match nothing — the -e guard skips the literal.)
  local stale
  for stale in "$RELEASES_DIR"/.stage.*; do
    [[ -e "$stale" ]] || continue
    rm -rf "$stale" 2>/dev/null || luna_warn "prune: could not remove stale staged tree $stale"
  done
  # shellcheck disable=SC2012
  for dir in $(ls -dt "$RELEASES_DIR"/*/ 2>/dev/null || true); do
    dir="${dir%/}"
    [[ "${dir##*/}" =~ ^[0-9a-fA-F]{7,64}$ ]] || continue
    if [[ ! -f "$dir/.complete" ]]; then
      # A partial (no .complete) NEVER counts toward keep — an unusable build
      # residue occupying a newest-by-mtime slot would silently evict complete
      # rollback candidates from retention. Unless protected (journal-named /
      # current / previous), it is removed regardless of age.
      if [[ "$protected" == *" ${dir##*/} "* ]]; then continue; fi
      pruned_any=true
      rm -rf "$dir" || luna_warn "prune: could not remove partial $dir"
      continue
    fi
    index=$((index + 1))
    if (( index <= keep )); then continue; fi
    if [[ "$protected" == *" ${dir##*/} "* ]]; then continue; fi
    pruned_any=true
    rm -rf "$dir" || luna_warn "prune: could not remove $dir"
  done
  # POSTCONDITION: the links prune must never break still resolve.
  if ! resolved="$(deployed_sha)"; then
    if [[ "$pruned_any" == true ]]; then
      luna_die "POSTCONDITION: release prune broke $CURRENT_LINK"
    fi
    luna_warn "current is broken but prune deleted nothing this run — pre-existing corruption"
  fi
  if [[ -n "$prev_sha" ]] && ! (cd -P "$PREVIOUS_LINK" >/dev/null 2>&1); then
    if [[ "$pruned_any" == true ]]; then
      luna_die "POSTCONDITION: release prune broke $PREVIOUS_LINK"
    fi
    luna_warn "previous is broken but prune deleted nothing this run — pre-existing corruption"
  fi
  return 0
}

# --- crash-safe transaction + per-profile exclusion -------------------------
# Updating mutates a live checkout across several fallible steps. A durable
# phase journal makes a killed/power-lost run resumable, while an atomic mkdir
# lock prevents timer/manual/CLI invocations from interleaving resets, installs,
# and restarts. State lives outside the mutable repo by default.
UPDATE_STATE_DIR="${LUNA_UPDATE_STATE_DIR:-$LUNA_HOME/update}"
UPDATE_LOCK_DIR="$UPDATE_STATE_DIR/lock-$PROFILE"
UPDATE_JOURNAL="$UPDATE_STATE_DIR/transaction-$PROFILE"
UPDATE_LOCK_HELD=false
TX_PHASE=""
TX_PREV=""
TX_TARGET=""
TX_PREV_LOCK_HASH=""
TRANSACTION_TRACK_APPLY=false
EXPECTED_BUILD_SHA=""
ALLOW_MISSING_BUILD_SHA=false
# Set by readiness_ok to the furthest-progressed reason it kept polling, so a
# timeout surfaces WHICH gate never cleared (active / crash-loop / healthz /
# mode / buildSha) instead of an opaque "failed readiness".
READINESS_DETAIL=""

process_fingerprint() {
  local pid="$1"
  if [[ -r "/proc/$pid/stat" ]]; then
    # Drop pid + parenthesized comm (which may contain spaces); starttime is
    # field 20 in the remainder (field 22 in procfs' full record).
    sed 's/^.*) //' "/proc/$pid/stat" 2>/dev/null | awk '{print $20}'
  else
    ps -p "$pid" -o lstart= 2>/dev/null | tr -d '\n'
  fi
}

lock_owner_alive() {
  [[ -r "$UPDATE_LOCK_DIR/owner" ]] || return 1
  local pid fingerprint current
  pid="$(sed -n 's/^pid=//p' "$UPDATE_LOCK_DIR/owner" | head -1)"
  fingerprint="$(sed -n 's/^fingerprint=//p' "$UPDATE_LOCK_DIR/owner" | head -1)"
  [[ "$pid" =~ ^[0-9]+$ && -n "$fingerprint" ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  current="$(process_fingerprint "$pid")"
  [[ -n "$current" && "$current" == "$fingerprint" ]]
}

# shellcheck disable=SC2329  # invoked indirectly via `trap release_update_lock EXIT INT TERM` in acquire_update_lock
release_update_lock() {
  if [[ "$UPDATE_LOCK_HELD" == true ]]; then
    rm -rf "$UPDATE_LOCK_DIR" 2>/dev/null || true
    UPDATE_LOCK_HELD=false
  fi
}

acquire_update_lock() {
  mkdir -p "$UPDATE_STATE_DIR"
  chmod 700 "$UPDATE_STATE_DIR" 2>/dev/null || true
  if ! mkdir "$UPDATE_LOCK_DIR" 2>/dev/null; then
    if lock_owner_alive; then
      luna_warn "DEFERRED: another update for profile '$PROFILE' is already running"
      return 1
    fi
    luna_warn "removing stale update lock for profile '$PROFILE'"
    rm -rf "$UPDATE_LOCK_DIR"
    mkdir "$UPDATE_LOCK_DIR" || return 1
  fi
  local fingerprint
  fingerprint="$(process_fingerprint "$$")"
  [[ -n "$fingerprint" ]] || { rm -rf "$UPDATE_LOCK_DIR"; return 1; }
  ( umask 077; printf 'pid=%s\nfingerprint=%s\n' "$$" "$fingerprint" > "$UPDATE_LOCK_DIR/owner" )
  # Reader-shape re-verify of our own ownership record (implies -s, and closes
  # the partial pid-without-fingerprint window): a lock whose owner record other
  # contenders cannot witness would be classified stale and stolen mid-update.
  # This function runs errexit-suspended (`if ! acquire_update_lock`), so the
  # explicit check is load-bearing.
  if ! lock_owner_alive; then
    rm -rf "$UPDATE_LOCK_DIR"
    luna_warn "cannot record update-lock ownership; deferring"
    return 1
  fi
  UPDATE_LOCK_HELD=true
  trap release_update_lock EXIT INT TERM
}

write_transaction() {
  local phase="$1"
  local tmp="$UPDATE_JOURNAL.tmp.$$"
  ( umask 077; printf 'phase=%s\nprev=%s\ntarget=%s\nprev_lock_hash=%s\nupdated_at=%s\n' \
      "$phase" "$PREV" "$REF" "$PREV_LOCK_HASH" "$(date +%s)" > "$tmp" )
  mv "$tmp" "$UPDATE_JOURNAL"
  TX_PHASE="$phase"
  if [[ "${LUNA_TEST_CRASH_AFTER_PHASE:-}" == "$phase" ]]; then
    # Deliberate SIGKILL seam: traps cannot clean the lock, matching power loss.
    kill -KILL "$$"
  fi
}

clear_transaction() {
  rm -f "$UPDATE_JOURNAL"
  TX_PHASE=""
}

load_transaction() {
  [[ -r "$UPDATE_JOURNAL" ]] || return 1
  TX_PHASE="" TX_PREV="" TX_TARGET="" TX_PREV_LOCK_HASH=""
  local key value
  while IFS='=' read -r key value; do
    case "$key" in
      phase) TX_PHASE="$value" ;;
      prev) TX_PREV="$value" ;;
      target) TX_TARGET="$value" ;;
      prev_lock_hash) TX_PREV_LOCK_HASH="$value" ;;
    esac
  done < "$UPDATE_JOURNAL"
  [[ "$TX_PHASE" =~ ^(prepared|checkout|applied|restarting|verifying|rolling-back|rollback-failed|forward-failed)$ ]] || return 1
  [[ "$TX_PREV" =~ ^[0-9a-fA-F]{7,64}$ ]] || return 1
  [[ "$TX_TARGET" =~ ^[0-9a-fA-F]{7,64}$ ]] || return 1
  [[ -z "$TX_PREV_LOCK_HASH" || "$TX_PREV_LOCK_HASH" =~ ^[0-9a-fA-F]{7,64}$ ]] || return 1
}

# --- readiness probe (the gate for rollback) ----------------------------------
# Bounded, never hangs. A failing probe is a NON-FATAL signal here — callers MUST
# invoke this as `if ! readiness_ok; then ...`, never bare, or `set -e` aborts
# before rollback can run. Returns 0 only when ALL hold within the budget:
#   - systemctl is-active <unit> == active
#   - the unit's NRestarts did not climb since restart (it didn't crash-loop)
#   - curl http://127.0.0.1:<port>/healthz returns HTTP 200
#   - curl /readyz reports "mode":"normal" (NOT setup-mode) — see below
# The probe runs THROUGH the runner, so in --incus it curls 127.0.0.1 INSIDE the
# container (not the host's proxied port). /healthz is bare liveness (a setup-mode
# server answers it 200 too), so the gate ALSO checks /readyz, which reports the
# boot mode. Back-compat: a server without /readyz (older build — e.g. a rollback
# target) returns 404, and the gate falls back to liveness-only so update-server
# can still drive pre-/readyz deploys.
readiness_restart_baseline() {
  # Baseline restart/launch count right after we issued the restart. If this
  # climbs during the probe window the unit is crash-looping, not recovering.
  local n
  n="$(sup_restart_count)"
  [[ "$n" =~ ^[0-9]+$ ]] || n="0"
  printf '%s' "$n"
}

readiness_ok() {
  local baseline="$1"
  local deadline=$((SECONDS + READINESS_TIMEOUT))
  local active nrestarts http
  READINESS_DETAIL="probe never observed $SERVICE_NAME reach 'active'"
  while (( SECONDS < deadline )); do
    active="$(sup_is_active)"
    READINESS_DETAIL="$SERVICE_NAME is not active (state=$active)"
    if [[ "$active" == "active" ]]; then
      nrestarts="$(sup_restart_count)"
      [[ "$nrestarts" =~ ^[0-9]+$ ]] || nrestarts="0"
      READINESS_DETAIL="$SERVICE_NAME is crash-looping (NRestarts $nrestarts > baseline $baseline)"
      if (( nrestarts <= baseline )); then
        READINESS_DETAIL="/healthz did not return 200 on :${READINESS_PORT}"
        http="$(run_target_capture curl -fsS -o /dev/null -w '%{http_code}' \
          --max-time "$READINESS_CURL_MAX_TIME" \
          "http://127.0.0.1:${READINESS_PORT}/healthz" 2>/dev/null || printf '000')"
        if [[ "$http" == "200" ]]; then
          readyz="$(run_target_capture curl -sS -w '\n%{http_code}' \
            --max-time "$READINESS_CURL_MAX_TIME" \
            "http://127.0.0.1:${READINESS_PORT}/readyz" 2>/dev/null || printf '\n000')"
          local rcode="${readyz##*$'\n'}"
          # Only a real HTTP 404 means a legacy pre-/readyz build. `000` is a
          # transport failure (often the process dying between the healthz and
          # readyz probes) and must retry/fail, never accept the deploy.
          if [[ "$rcode" == "404" ]]; then
            return 0
          fi
          READINESS_DETAIL="/readyz did not report \"mode\":\"normal\" (still booting or in setup-mode; http=$rcode)"
          if printf '%s' "$readyz" | grep -q '"mode":"normal"'; then
            if [[ -z "$EXPECTED_BUILD_SHA" ]]; then
              return 0
            fi
            local build_sha
            build_sha="$(printf '%s' "$readyz" | sed -n 's/.*"buildSha":"\([0-9a-fA-F]*\)".*/\1/p' | head -1)"
            if [[ -n "$build_sha" && ( "$EXPECTED_BUILD_SHA" == "$build_sha"* || "$build_sha" == "$EXPECTED_BUILD_SHA"* ) ]]; then
              return 0
            fi
            # Rollback targets may implement /readyz but predate its additive
            # buildSha field. Accept an absent field only for that compatibility
            # path; if a SHA is present it must still identify PREV.
            if [[ -z "$build_sha" && "$ALLOW_MISSING_BUILD_SHA" == true ]]; then
              return 0
            fi
            if [[ -z "$build_sha" ]]; then
              READINESS_DETAIL="/readyz reported no usable hex buildSha (runtime resolved it to a non-hex value such as 'unknown' when git/.git is unavailable); forward promotion requires a buildSha matching ${EXPECTED_BUILD_SHA:0:12} (set LUNA_BUILD_SHA in the server env to pin it)"
            else
              READINESS_DETAIL="/readyz buildSha $build_sha does not match expected ${EXPECTED_BUILD_SHA:0:12}"
            fi
          fi
        fi
      fi
    fi
    sleep "$READINESS_INTERVAL"
  done
  luna_warn "readiness gave up after ${READINESS_TIMEOUT}s: ${READINESS_DETAIL}"
  return 1
}

# --- apply: deploy-semantics update to a ref ----------------------------------
# This is a DEPLOY checkout, not a dev tree, so `git reset --hard <ref>` is the
# clean, deterministic update (no merge surprises). git fetch origin brings the
# ref up to date first UNLESS --no-fetch is passed (used by the rollback path,
# which rolls back to a LOCAL sha already in the repo — no network needed, and
# the fetch failing for a network reason should not prevent rollback recovery).
# Re-pinning the Claude executable is intentional: deps can move on `bun install`
# and the override path goes stale — without re-pinning the server boots but
# cannot spawn `claude` (a REAL incident this session).
# Every mutating step is `cmd || return 1` so a command-level failure (a bad
# `bun install`, a refused `systemctl restart`, an out-of-sync frozen lockfile)
# becomes a RETURN VALUE the caller routes into rollback — NOT a `set -e` abort
# that would skip rollback entirely. `|| return 1` is safe under `set -e` in any
# call context (it is the rightmost element of an OR list).
# apply_ref is a DISPATCHER: the inplace arm is the pre-phase-4 body VERBATIM
# (all phase 1-3 behaviour byte-preserved); the releases arm materializes an
# immutable release and NEVER flips current (the flip runs inside the guarded
# restart window — see restart_service). git reset --hard exists ONLY in the
# inplace arm.
apply_ref() {
  if [[ "$LAYOUT" == "releases" ]]; then
    apply_ref_releases "$@"
  else
    apply_ref_inplace "$@"
  fi
}

# Releases arm: materialize + build PRE-flip, then the through-current claude
# re-pin. No mutation of current/previous/mirror-worktrees happens here — a
# failure leaves the deploy root serving exactly what it served before.
apply_ref_releases() {
  local target="$1"
  local prev_lock_hash="$2"
  # third arg (--no-fetch) accepted for signature compatibility; the releases
  # main flow always fetches the mirror up front, exactly like inplace.
  materialize_release "$target" "$prev_lock_hash" || return 1
  if [[ "$TRANSACTION_TRACK_APPLY" == true ]]; then
    write_transaction "checkout" || return 1
  fi
  repin_claude_releases "$target" || return 1
}

apply_ref_inplace() {
  local target="$1"
  local prev_lock_hash="$2"
  local no_fetch="${3:-}"
  if [[ "$no_fetch" != "--no-fetch" ]]; then
    git_target fetch origin || return 1
  fi
  git_target reset --hard "$target" || return 1
  # POSTCONDITION: the reset must have MOVED HEAD to the target. A silently
  # no-opped reset previously fed the old HEAD into NEW_HEAD and
  # EXPECTED_BUILD_SHA, so the readiness gate verified the OLD build and the
  # run exited 0 — a self-referential success. Bidirectional prefix match:
  # $target is pre-validated 7-64 hex while HEAD is full-length. Covers the
  # forward, recovery, and rollback invocations identically. Case-normalized:
  # the --ref validation (and the journal's TX_TARGET) accept UPPERCASE hex,
  # git accepts it and moves HEAD, but rev-parse answers lowercase — without
  # normalization a correct reset to an uppercase sha would be reported as a
  # lying reset and rolled back on every attempt.
  local head_now head_lc target_lc
  head_now="$(git_target_capture rev-parse HEAD 2>/dev/null || true)"
  head_lc="${head_now,,}"; target_lc="${target,,}"
  if [[ -z "$head_now" || ( "$head_lc" != "$target_lc"* && "$target_lc" != "$head_lc"* ) ]]; then
    luna_warn "POSTCONDITION: git reset reported success but HEAD is '${head_now:-unreadable}', expected $target — refusing to continue"
    return 1
  fi
  if [[ "$TRANSACTION_TRACK_APPLY" == true ]]; then
    write_transaction "checkout" || return 1
  fi

  local new_lock_hash
  new_lock_hash="$(lockfile_hash)"
  if [[ "$new_lock_hash" != "$prev_lock_hash" ]]; then
    luna_info "bun.lock changed -> bun install --frozen-lockfile"
    # bun --cwd is the IN-CONTAINER repo (/root/luna) in incus mode, the host repo
    # in bare-host mode. run_target wraps it in `incus exec` for incus so deps
    # install inside the container (host git already changed the bind-mounted files).
    run_target "$BUN_BIN" install --cwd "$CONTAINER_REPO_DIR" --frozen-lockfile || return 1
    # POSTCONDITION: the install's declared artifact must exist (in-container
    # via run_target in incus mode). An install that exits 0 without producing
    # node_modules gates readiness on a build that cannot boot.
    if ! run_target test -d "$CONTAINER_REPO_DIR/node_modules"; then
      luna_warn "POSTCONDITION: bun install exited 0 but $CONTAINER_REPO_DIR/node_modules is missing"
      return 1
    fi
  else
    luna_info "bun.lock unchanged -> skipping bun install"
  fi

  # Build the web SPA on every apply (SPA source changes independent of bun.lock)
  # so chat-server serves the current UI on :4753. The guarded build refuses to
  # bake VITE_UI_WS_TOKEN (deploy env never sets it); failure routes to rollback.
  run_target "$BUN_BIN" run --cwd "$CONTAINER_REPO_DIR" --filter "@luna/ui-web" build || return 1
  # POSTCONDITION: the build's declared artifact (the SPA entry point served on
  # :4753) must exist and be non-empty.
  if ! run_target test -s "$CONTAINER_REPO_DIR/apps/ui-web/dist/index.html"; then
    luna_warn "POSTCONDITION: ui-web build exited 0 but $CONTAINER_REPO_DIR/apps/ui-web/dist/index.html is missing or empty"
    return 1
  fi

  # Re-pin LUNA_CLAUDE_CODE_EXECUTABLE (no-op in dry-run). Deps can move on
  # `bun install` and the override path goes stale — without re-pinning the
  # server boots but cannot spawn `claude` (a REAL incident this session).
  if [[ -n "$INCUS_CONTAINER" ]]; then
    # The container's claude executable + .env are container-FS artifacts; a
    # host-side luna_configure_claude_executable would introspect HOST paths and
    # write a host-perspective path into the container's .env (wrong). Run the same
    # helper INSIDE the container against the container's .env (/root/.luna/.env)
    # and repo (/root/luna), sourcing the shared lib there. (no-op in dry-run.)
    #
    # POSTCONDITION (warn-only): the re-pin helper returns 0 even when it found
    # nothing to pin — the silent half of the real incident where the server
    # boots but cannot spawn `claude`. The verification rides the SAME payload
    # so it observes the container's PATH/.env; exit 9 marks "no usable claude"
    # distinctly from a transport/exec failure. Warn-only because rollback
    # cannot fix an absent binary, and failing the deploy would deadlock
    # updates on an orthogonal defect.
    local repin_rc=0
    run_target bash -lc \
      "source /root/luna/scripts/lib/luna-deploy.sh && luna_configure_claude_executable /root/.luna/.env /root/luna && { v=\$(luna_env_value /root/.luna/.env LUNA_CLAUDE_CODE_EXECUTABLE 2>/dev/null || true); [[ -n \$v && -x \$v ]] || command -v claude >/dev/null 2>&1 || exit 9; }" ||
      repin_rc=$?
    if (( repin_rc == 9 )); then
      luna_warn "POSTCONDITION degraded: no usable claude executable after re-pin — server will boot but cannot spawn claude"
    elif (( repin_rc != 0 )); then
      return 1
    fi
  else
    luna_configure_claude_executable "$ENV_FILE" "$REPO_DIR" || return 1
    # Same warn-only postcondition, evaluated host-side.
    local claude_pin
    claude_pin="$(luna_env_value "$ENV_FILE" LUNA_CLAUDE_CODE_EXECUTABLE 2>/dev/null || true)"
    if [[ -z "$claude_pin" || ! -x "$claude_pin" ]] && ! command -v claude >/dev/null 2>&1; then
      luna_warn "POSTCONDITION degraded: no usable claude executable after re-pin — server will boot but cannot spawn claude"
    fi
  fi

}

# Settle between stop and start. A bounded, dry-run-aware wait that lets the
# OUTGOING process finish flushing and release its DuckDB/SQLite WAL/SHM handles
# before the incoming process opens the DBs. Deliberately a FIXED sleep, not a
# port/handle poll: the listening port is already gone the instant `systemctl
# stop` returns, yet the fd release can lag process exit (async WAL checkpoint,
# child reaping, incus bind-mount fs flush) — none of which the port reflects,
# and whose DB file paths this script does not know to fuser/lsof against. A
# short fixed settle is exactly what the manual recovery proved out. ALWAYS
# returns 0: it sits unguarded between restart_service's two `|| return 1` lines,
# so a stray non-zero here must never trip set -e / the rollback path.
settle_after_stop() {
  [[ "$DRY_RUN" == true ]] && return 0
  [[ "$RESTART_SETTLE_SECS" == "0" ]] && return 0
  # Validate BEFORE sleeping. A bare `sleep "$bad" || true` would swallow the
  # failure of an invalid/negative/empty value and skip the settle SILENTLY —
  # reintroducing the WAL/SHM race the operator believes they configured away,
  # with no signal. So reject anything that is not a non-negative number of
  # seconds (the documented contract for --restart-settle / LUNA_RESTART_SETTLE_SECS)
  # and WARN loudly, but still no-op + return 0 (set -e / rollback must never trip).
  if [[ ! "$RESTART_SETTLE_SECS" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
    luna_warn "RESTART_SETTLE_SECS='$RESTART_SETTLE_SECS' is not a non-negative number of seconds; SKIPPING the post-stop settle — the DuckDB/SQLite WAL/SHM race may recur. Set --restart-settle / LUNA_RESTART_SETTLE_SECS to a valid value (e.g. 6)."
    return 0
  fi
  luna_info "settling ${RESTART_SETTLE_SECS}s after stop so DuckDB/SQLite release WAL/SHM before start"
  # Belt-and-suspenders: if sleep STILL fails for some reason, warn (do not
  # swallow it silently) — but keep returning 0 so the rollback path is intact.
  if ! sleep "$RESTART_SETTLE_SECS"; then
    luna_warn "post-stop settle sleep failed (RESTART_SETTLE_SECS='$RESTART_SETTLE_SECS'); proceeding to start WITHOUT a settle — the WAL/SHM race may recur."
  fi
  return 0
}

# --- supervisor abstraction ---------------------------------------------------
# The following five functions (sup_reload, sup_stop, sup_start, sup_is_active,
# sup_restart_count) form a thin abstraction over systemd and launchd so the
# restart/readiness logic above them is written once and routes by $SUPERVISOR.
#
# Key invariant: all five return 0 on success, non-zero on failure — callers use
# `|| return 1` to propagate into rollback exactly as the bare systemctl calls did.
#
# launchd notes (verified on macOS 26.5.1):
#   - `bootout` is ASYNC: the process may still be running when it returns. We
#     capture the PID BEFORE bootout and poll kill -0 until dead (bounded 15s).
#   - bootout when already-gone returns rc=3 "No such process" -> tolerate as OK.
#   - `bootstrap gui/$UID <plist>` is the modern load primitive (not `launchctl load`).
#   - `print gui/$UID/$LABEL` -> state = running (is-active analogue).
#   - `print gui/$UID/$LABEL` -> runs = N (crash-loop counter analogue).

# sup_reload — daemon configuration reload before start.
# systemd: daemon-reload (forces the kernel to re-read unit files so a changed
#   ExecStart / EnvironmentFile / etc. takes effect on the next start).
# launchd: no-op (launchd reads the plist fresh on bootstrap; no reload needed).
sup_reload() {
  if [[ "$SUPERVISOR" == "systemd" ]]; then
    run_target systemctl $(_systemctl_user_flag) daemon-reload
  else
    # launchd: the plist is re-read at bootstrap time, so there is no persistent
    # daemon state to reload. Return 0 unconditionally.
    return 0
  fi
}

# sup_stop — stop the supervised service and wait for the process to be gone.
# systemd: synchronous (systemctl stop blocks until the unit's cgroup is torn down).
# launchd: async! capture PID first, then bootout, then poll kill -0 until dead.
#   Dry-run: just print the bootout command; skip the poll (nothing to wait for).
sup_stop() {
  if [[ "$SUPERVISOR" == "systemd" ]]; then
    run_target systemctl $(_systemctl_user_flag) stop "$SERVICE_NAME"
  else
    # Capture PID BEFORE bootout — once the service is gone launchctl list
    # no longer has a "PID" field, so we must read it first. The line format is
    # exactly `\t"PID" = 1182;` (verified on macOS 26), so pull the integer
    # between `= ` and `;`. (An earlier `awk -F'"' '{print $4}'` extracted the
    # EMPTY field after the closing quote, silently disabling the death-poll —
    # the settle then only "worked" because it outlived the dying process.)
    local pid=""
    pid="$(launchctl list "$LAUNCHD_LABEL" 2>/dev/null | sed -n 's/.*"PID" = \([0-9]*\);.*/\1/p' || true)"

    # bootout: rc=3 "No such process" is normal when the unit is already stopped;
    # treat it as success so an idempotent stop doesn't abort the deploy.
    if [[ "$DRY_RUN" == true ]]; then
      luna_run launchctl bootout "gui/$UID/$LAUNCHD_LABEL"
      return 0
    fi
    launchctl bootout "gui/$UID/$LAUNCHD_LABEL" 2>/dev/null || {
      local rc=$?
      # rc=3 = "No such process" = already stopped. Any other rc is a real error.
      [[ $rc -eq 3 ]] || { printf 'error: launchctl bootout failed (rc=%d)\n' "$rc" >&2; return 1; }
    }

    # Poll until the process is actually gone (bootout is async).
    # A missing or empty PID means nothing was running — skip the poll.
    if [[ -n "$pid" ]]; then
      local i=0
      while (( i < 15 )); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 1
        (( i++ )) || true
      done
      if kill -0 "$pid" 2>/dev/null; then
        luna_warn "launchctl bootout timed out: PID $pid still alive after 15s; proceeding anyway"
      fi
    fi
  fi
}

# sup_start — load/start the supervised service.
# systemd: systemctl start (picks up the unit from SERVICE_DIR, already reloaded).
# launchd: bootstrap gui/$UID <plist> (reads the plist file at LAUNCHD_PLIST).
sup_start() {
  if [[ "$SUPERVISOR" == "systemd" ]]; then
    run_target systemctl $(_systemctl_user_flag) start "$SERVICE_NAME"
  else
    luna_run launchctl bootstrap "gui/$UID" "$LAUNCHD_PLIST"
  fi
}

# sup_is_active — check whether the service is currently running.
# Returns: prints "active" if running; "unknown" otherwise. Callers compare with ==.
# systemd: `systemctl is-active <unit>` (prints "active" when running).
# launchd: `launchctl print gui/$UID/$LABEL | grep 'state = running'`.
sup_is_active() {
  if [[ "$SUPERVISOR" == "systemd" ]]; then
    run_target_capture systemctl $(_systemctl_user_flag) is-active "$SERVICE_NAME" 2>/dev/null || printf 'unknown'
  else
    if launchctl print "gui/$UID/$LAUNCHD_LABEL" 2>/dev/null | grep -q 'state = running'; then
      printf 'active'
    else
      printf 'unknown'
    fi
  fi
}

# sup_restart_count — how many times has the supervisor restarted this service?
# Used by readiness_ok to detect crash-looping: if the count climbs during the
# probe window, the service is not actually healthy despite momentary is-active.
# systemd: NRestarts property via systemctl show.
# launchd: the `runs` field from `launchctl print` (increments on each launch).
# Both: non-numeric output -> "0" (safe default, disables the climb check).
sup_restart_count() {
  local n
  if [[ "$SUPERVISOR" == "systemd" ]]; then
    n="$(run_target_capture systemctl $(_systemctl_user_flag) show "$SERVICE_NAME" --property=NRestarts --value 2>/dev/null || printf '0')"
  else
    n="$(launchctl print "gui/$UID/$LAUNCHD_LABEL" 2>/dev/null | awk '/^[[:space:]]*runs =/{print $3}' || printf '0')"
  fi
  [[ "$n" =~ ^[0-9]+$ ]] || n="0"
  printf '%s' "$n"
}

# sup_main_pid — the supervised service's current main PID, systemd-only.
# Prints a decimal PID (possibly 0 = no main process) or the empty string when
# no numeric answer could be read (transport failure, non-systemd supervisor).
# launchd deliberately answers empty: the launchd integration fakes return a
# constant PID, launchd is the operator's own macOS laptop whose stop path
# already death-polls and warns loudly, and the unattended guardian ladder that
# needs the MainPID proof is systemd-only.
sup_main_pid() {
  local pid=""
  if [[ "$SUPERVISOR" == "systemd" ]]; then
    pid="$(run_target_capture systemctl $(_systemctl_user_flag) show "$SERVICE_NAME" --property=MainPID --value 2>/dev/null || true)"
  fi
  [[ "$pid" =~ ^[0-9]+$ ]] || pid=""
  printf '%s' "$pid"
}

# _systemctl_user_flag — emit "--user" when the --user flag was passed, empty otherwise.
# Used by every systemctl call so bare-host system-scope is unchanged and user-scope
# is a single toggle. This is a helper, not a supervisor abstraction function.
_systemctl_user_flag() {
  [[ "$SYSTEMD_USER" == true ]] && printf '%s' '--user' || true
}

# --- in-primitive session guard (phase 2) -------------------------------------
# THE invariant: the operator is never dropped mid-conversation by an unattended
# restart. It lives inside the restart primitive — not as a caller-side check a
# flag can skip — so automation is structurally unable to bypass it.
#
# Returns 0 = restart permitted, 3 = defer (live or unknown sessions).
#
# Decision procedure (ws-count FIRST — an answered kernel count is authoritative
# in both directions):
#   1. count answered, n > 0  -> DEFER even if systemd reports non-active
#                                (protects against orphaned/lingering holders).
#   2. count answered, n == 0 -> PERMIT without consulting systemd at all
#                                (the common dead-but-reachable repair case; the
#                                kernel socket table proves nothing can drop).
#   3. count UNKNOWN          -> ask systemd whether a serving process can even
#      exist. Only the exact answers 'inactive'/'failed' prove no supervised
#      process exists (sessions structurally cannot exist) — the dead-server
#      exception repair needs. 'activating' must DEFER: a Type=notify server
#      may accept sockets pre-READY. Empty output means transport never reached
#      systemd — DEFER (a restart through the same transport could not succeed
#      anyway). A crash-looping unit in a reachable container still clears via
#      step 2 (ss answers 0).
restart_session_guard() {
  [[ "$DRY_RUN" == true ]] && return 0
  [[ "$GUARD_SESSIONS" == true ]] || return 0
  # launchd = the operator's own macOS laptop; no unattended caller exists there
  # and ss(8) is unavailable (the guard would permanently defer).
  [[ "$SUPERVISOR" == "systemd" ]] || return 0
  if [[ -n "$OPERATOR_OVERRIDE_REASON" ]]; then
    luna_warn "SESSION GUARD OVERRIDDEN by operator: $OPERATOR_OVERRIDE_REASON"
    return 0
  fi
  local n state
  # NOTE: counts READINESS_PORT, which is the ws session port (container-internal
  # 4753 for both profiles; a single port serves ws+health). If a profile ever
  # splits them, this must learn the ws port explicitly.
  if n="$(luna_active_ws_count "$READINESS_PORT" "$INCUS_CONTAINER")"; then
    if (( n > 0 )); then
      luna_warn "session guard: $n active session(s) on :$READINESS_PORT — deferring restart"
      return 3
    fi
    return 0   # kernel socket table answered 0: no established session can be dropped
  fi
  # Count UNKNOWN (probe transport failed). Ask systemd whether a serving process
  # can even exist. Do NOT use sup_is_active here: it maps failure to the string
  # 'unknown', which would be indistinguishable from a real non-active answer.
  state="$(run_target_capture systemctl $(_systemctl_user_flag) is-active "$SERVICE_NAME" 2>/dev/null || true)"
  case "$state" in
    inactive|failed)
      # Non-empty output proves transport reached systemd (a missing unit still
      # prints 'inactive' rc=4). The unit answered: no supervised process exists,
      # so sessions structurally cannot exist. The dead-server exception.
      luna_warn "session guard: ws count unknown but unit answered '$state' — no server process; restart permitted"
      return 0 ;;
    "")
      luna_warn "session guard: transport never reached systemd — deferring (fail closed); a restart through the same transport could not succeed anyway"
      return 3 ;;
    *)
      luna_warn "session guard: ws count unknown while unit answers '$state' — may be serving; deferring (fail closed)"
      return 3 ;;
  esac
}

# Restart the unit as a CLEAN stop -> settle -> start instead of a fast
# supervisor-restart. sup_stop handles the async launchd death-poll internally,
# so settle_after_stop always runs on confirmed-dead (or timed-out-with-warning).
# sup_reload is a no-op for launchd.
restart_service() {
  # First line, belt-and-suspenders: any caller of the primitive is guarded.
  # rc==3 is unambiguous — sup_reload/sup_stop/sup_start return 1, settle 0.
  restart_session_guard || return 3
  # MainPID-changed postcondition, IN THE PRIMITIVE so no caller can skip it
  # (phase-2 philosophy), systemd-only and never in dry-run (run_target_capture
  # executes even under --dry-run, and the dry-run plan block calls this
  # function). Fail only on POSITIVE proof: a known-nonzero pre-PID that did
  # not change across stop->start means the stop silently failed and the OLD
  # process is still serving — today that reads as a successful restart. An
  # unknown/zero pre-PID skips the check entirely (dead server, transport
  # failure, default test stubs answering 0): absence of an answer is not
  # proof of failure — phase-1 tri-state philosophy; readiness_ok still gates.
  local pre_pid="" post_pid=""
  if [[ "$DRY_RUN" != true && "$SUPERVISOR" == "systemd" ]]; then
    pre_pid="$(sup_main_pid)"
  fi
  # Stop -> settle -> start instead of a fast supervisor-restart. sup_stop handles
  # the async launchd death-poll internally, so settle_after_stop always runs on
  # confirmed-dead (or timed-out-with-warning). sup_reload is a no-op for launchd.
  sup_reload || return 1
  sup_stop   || return 1
  settle_after_stop
  # Graft 1 (releases layout): the current-symlink flip lives INSIDE the
  # restart window — after the confirmed stop+settle, before start. A
  # session-guard defer (first line above) therefore leaves current UNTOUCHED:
  # there is never a window where current names a build the server is not
  # serving. The hook is set ONLY by releases-mode deploy/rollback (never by
  # --restart-only); it returns 1 on failure (POSTCONDITION-prefixed warn
  # inside the flip, never a die mid-primitive with the service stopped) so
  # the caller routes it into rollback's flip-back.
  if (( ${#RESTART_PRESTART_HOOK[@]} > 0 )); then
    "${RESTART_PRESTART_HOOK[@]}" || return 1
    # Deliberate SIGKILL seam (tests): a crash BETWEEN the landed flip and
    # sup_start is the narrowest recovery window (journal=restarting, current
    # already names the target, unit stopped). Recovery must re-flip
    # idempotently WITHOUT restamping previous — restamping it to the target
    # (= itself) would destroy the rollback target's `previous` identity and
    # its prune protection (see flip_current's outgoing_sha != sha guard).
    if [[ -n "${LUNA_TEST_CRASH_AFTER_FLIP:-}" ]]; then
      kill -KILL "$$"
    fi
  fi
  sup_start  || return 1
  if [[ "$DRY_RUN" != true && "$SUPERVISOR" == "systemd" ]] &&
     [[ "$pre_pid" =~ ^[0-9]+$ && "$pre_pid" != 0 ]]; then
    post_pid="$(sup_main_pid)"
    if [[ ! "$post_pid" =~ ^[0-9]+$ ]]; then
      # The same skip-unless-answered rule the pre-read gets: an unreadable
      # post-restart MainPID is a transport failure (the incus-exec/dbus flake
      # class), NOT evidence that the old process survived. Failing here would
      # route a healthy forward deploy into rollback on a read blip. The
      # readiness gate still verifies the build that is actually serving.
      luna_warn "restart postcondition INCONCLUSIVE: post-restart MainPID unreadable (transport failure?); skipping the PID-change check — readiness still gates"
    elif [[ "$post_pid" == "$pre_pid" ]]; then
      # POSITIVE proof: systemd answered, and the answer is the OLD pid — the
      # stop silently failed and the old process is still the supervised one.
      luna_warn "POSTCONDITION: restart did not replace the server process (MainPID before=$pre_pid after=$post_pid) — the stop silently failed"
      return 1
    fi
    # post_pid == 0 passes: systemd answered "no main process", which disproves
    # "the old process is still serving"; a failed START is readiness_ok's job.
  fi
}

# --- releases bootstrap: --materialize ----------------------------------------
# Inert by design (graft 6): materialize + build + create current WITHOUT any
# restart or unit interaction, so it can run beside the live in-place server
# during the migration (via the temporary additive device mount — the
# LUNA_CONTAINER_DEPLOY_ROOT seam). current is created only when absent; an
# established current is never moved by a bootstrap.
if [[ "$MATERIALIZE_ONLY" == true ]]; then
  if [[ "$DRY_RUN" == false ]]; then
    if ! acquire_update_lock; then
      luna_die "another update holds the profile '$PROFILE' lock; retry when it finishes"
    fi
    git_target fetch origin || luna_die "mirror fetch failed"
    if [[ "$REF" =~ ^[0-9a-fA-F]{40}$ ]]; then
      MAT_SHA="${REF,,}"
    else
      MAT_SHA="$(git_target_capture rev-parse "${REF}^{commit}" 2>/dev/null || true)"
    fi
    [[ "$MAT_SHA" =~ ^[0-9a-f]{40}$ ]] || luna_die "could not resolve --ref '$REF' in $MIRROR_GIT"
  else
    git_target fetch origin
    MAT_SHA="$REF"
  fi
  materialize_release "$MAT_SHA" || luna_die "materialize of $MAT_SHA failed (failed build tree cleaned up; deploy root unchanged)"
  if [[ "$DRY_RUN" == false ]] && deployed_sha >/dev/null 2>&1; then
    luna_info "current already resolves to a complete release — left untouched (bootstrap never moves an established current)"
  else
    flip_current "$MAT_SHA" || luna_die "could not create $CURRENT_LINK -> releases/$MAT_SHA"
  fi
  luna_info "materialized release $MAT_SHA (no restart, no unit interaction — see docs/deploy-layout-migration.md for the cutover)"
  exit 0
fi

# --- plan / dry-run -----------------------------------------------------------
if [[ "$DRY_RUN" == true && "$LAYOUT" == "releases" ]]; then
  luna_info "Plan (dry-run — releases layout; nothing will be executed):"
  PREV="$(deployed_sha 2>/dev/null || printf '(current release)')"
  printf '1. record PREV = %s (deploy root %s; deployed release resolved via current)\n' "$PREV" "$DEPLOY_ROOT"
  printf '2. mirror fetch: git --git-dir %s fetch origin (the ONLY tree any fetch touches; no reset of any kind)\n' "$MIRROR_GIT"
  printf '3. materialize release: git clone --no-checkout --local %s releases/<sha> + checkout --detach (reused if already .complete)\n' "$MIRROR_GIT"
  printf '4. build-in-release: %s install --frozen-lockfile + @luna/ui-web build INSIDE releases/<sha> (pre-flip; cp -a node_modules seed when bun.lock blob unchanged)\n' "$BUN_BIN"
  printf '5. re-pin LUNA_CLAUDE_CODE_EXECUTABLE through current (detected in the NEW release, written as the through-current spelling)\n'
  printf '6. session guard: refuse stop if live sessions on :%s (dead-server exception: unit inactive/failed permits)\n' "$READINESS_PORT"
  printf '7. flip-inside-restart: stop %s -> settle %ss -> flip current -> releases/<sha> (previous := outgoing; staged ln + mv -fT + cd -P assert) -> start\n' "$SERVICE_NAME" "$RESTART_SETTLE_SECS"
  printf '8. verify: readiness probe is-active + NRestarts-stable + /healthz==200 + /readyz mode=normal + buildSha==<sha> (<=%ss)\n' "$READINESS_TIMEOUT"
  printf '9. on readiness OK: prune releases (keep %s; current/previous/journal-named protected) + seed dream/wake rows through current\n' "$RELEASES_KEEP"
  if [[ "$ROLLBACK" == true ]]; then
    printf '10. rollback = flip back to previous (no git surgery, no install, no rebuild); if the flip-back also fails: CRITICAL, exit 2\n'
  else
    printf '10. rollback DISABLED (--no-rollback): on readiness FAIL, exit 1 without flipping back\n'
  fi
  # Concrete commands that WOULD run, executing nothing (routed exactly as the
  # live path: mirror-only git, bun/systemctl via run_target). The live path
  # resolves --ref to a full lowercase sha BEFORE any path is formed, so the
  # trace must too: resolve READ-ONLY against the existing mirror (no fetch —
  # dry-run mutates nothing) and fall back to a <sha> placeholder when the ref
  # only exists upstream. Printing the raw symbolic ref would trace paths like
  # releases/origin/master that the live path never creates.
  DRY_SHA="$(git --git-dir "$MIRROR_GIT" rev-parse --verify "${REF}^{commit}" 2>/dev/null || true)"
  DRY_SHA="${DRY_SHA,,}"
  [[ "$DRY_SHA" =~ ^[0-9a-f]{40}$ ]] || DRY_SHA="<sha>"
  git_target fetch origin
  materialize_release "$DRY_SHA"
  RESTART_PRESTART_HOOK=(flip_current "$DRY_SHA")
  restart_service
  run_target "$BUN_BIN" run "$CONTAINER_REPO_DIR/apps/ui-web/scripts/dream-wake-install.ts"
  luna_info "Dry run complete; no changes made."
  exit 0
fi
if [[ "$DRY_RUN" == true ]]; then
  luna_info "Plan (dry-run — nothing will be executed):"
  PREV="(current HEAD)"
  # git is host-side in both modes, so HOST_REPO_DIR's HEAD reads for incus too.
  if [[ -d "$HOST_REPO_DIR/.git" ]]; then
    PREV="$(git -C "$HOST_REPO_DIR" rev-parse HEAD 2>/dev/null || printf '(current HEAD)')"
  fi
  if [[ -n "$INCUS_CONTAINER" ]]; then
    printf '0. incus mode -> container %s; git on HOST %s, deps/restart/probe in container\n' \
      "$INCUS_CONTAINER" "$HOST_REPO_DIR"
  fi
  printf '1. record PREV = %s and bun.lock hash (host repo %s)\n' "$PREV" "$HOST_REPO_DIR"
  printf '2. (HOST git) fetch origin + reset --hard to %s\n' "$REF"
  printf '3. if bun.lock changed: %s install --cwd %s --frozen-lockfile (else skip)\n' "$BUN_BIN" "$CONTAINER_REPO_DIR"
  printf '3b. %s run --cwd %s --filter @luna/ui-web build (always — builds the web SPA served on :4753)\n' "$BUN_BIN" "$CONTAINER_REPO_DIR"
  # In incus mode the re-pin runs INSIDE the container against the container .env
  # (/root/.luna/.env), NOT the host --luna-home .env; print the path that the
  # concrete command below actually touches so the plan does not contradict it.
  if [[ -n "$INCUS_CONTAINER" ]]; then
    printf '4. re-pin LUNA_CLAUDE_CODE_EXECUTABLE in /root/.luna/.env (in container)\n'
  else
    printf '4. re-pin LUNA_CLAUDE_CODE_EXECUTABLE in %s\n' "$ENV_FILE"
  fi
  printf '4b. session guard: refuse stop if live sessions on :%s (dead-server exception: unit inactive/failed permits)\n' "$READINESS_PORT"
  if [[ "$SUPERVISOR" == "launchd" ]]; then
    printf '5. launchctl bootout gui/%s/%s + settle %ss + bootstrap gui/%s %s\n' \
      "$UID" "$LAUNCHD_LABEL" "$RESTART_SETTLE_SECS" "$UID" "$LAUNCHD_PLIST"
  elif [[ "$SYSTEMD_USER" == true ]]; then
    printf '5. systemctl --user daemon-reload + stop + settle %ss + start %s\n' "$RESTART_SETTLE_SECS" "$SERVICE_NAME"
  else
    printf '5. systemctl daemon-reload + stop + settle %ss + start %s\n' "$RESTART_SETTLE_SECS" "$SERVICE_NAME"
  fi
  if [[ "$SUPERVISOR" == "launchd" ]]; then
    restart_count_term="runs-stable"
  else
    restart_count_term="NRestarts-stable"
  fi
  printf '6. readiness probe: is-active + %s + curl http://127.0.0.1:%s/healthz==200 + /readyz mode=normal (<=%ss)\n' \
    "$restart_count_term" "$READINESS_PORT" "$READINESS_TIMEOUT"
  printf '7. on readiness OK: seed V2 dream/wake job rows via dream-wake-install.ts (idempotent, best-effort)\n'
  if [[ "$ROLLBACK" == true ]]; then
    printf '8. on readiness FAIL: reset --hard PREV, re-install if lock reverted, re-pin claude, restart, re-probe (ROLLED BACK)\n'
    printf '   if rollback also fails: CRITICAL, exit 2\n'
  else
    printf '8. rollback DISABLED (--no-rollback): on readiness FAIL, exit 1 without reverting\n'
  fi
  # Show the concrete commands that WOULD run, executing nothing. These route
  # exactly as the live path: git on the host, bun/systemctl via run_target
  # (incus exec in incus mode).
  git_target fetch origin
  git_target reset --hard "$REF"
  run_target "$BUN_BIN" install --cwd "$CONTAINER_REPO_DIR" --frozen-lockfile
  run_target "$BUN_BIN" run --cwd "$CONTAINER_REPO_DIR" --filter "@luna/ui-web" build
  if [[ -n "$INCUS_CONTAINER" ]]; then
    run_target bash -lc \
      "source /root/luna/scripts/lib/luna-deploy.sh && luna_configure_claude_executable /root/.luna/.env /root/luna && { v=\$(luna_env_value /root/.luna/.env LUNA_CLAUDE_CODE_EXECUTABLE 2>/dev/null || true); [[ -n \$v && -x \$v ]] || command -v claude >/dev/null 2>&1 || exit 9; }"
  fi
  restart_service
  run_target "$BUN_BIN" run "$CONTAINER_REPO_DIR/apps/ui-web/scripts/dream-wake-install.ts"
  luna_info "Dry run complete; no changes made."
  exit 0
fi

# --- post-deploy: seed V2 dream/wake job rows --------------------------------
# The scheduler-v2 migration (DESIGN §5.3.5) DISABLES the legacy dream/wake cron
# layers and drives BOTH cycles from durable `jobs` rows instead. Those rows are
# created by dream-wake-install.ts, which is IDEMPOTENT (skip-if-exists, no
# --force). If a promotion ships the migration but the rows were never seeded,
# wake + dream silently go dark — observed on stable 2026-06-15 (legacy cron off
# + no V2 rows = no driver). Seeding on every HEALTHY deploy closes that gap so
# the cycles self-heal on promotion.
#
# Routed through run_target so it executes in the SAME scope as the server (host
# for bare-host stable, inside the container for incus dev) — matching how
# bun install runs — so it resolves the SAME ~/.luna/luna.db.
#
# BEST-EFFORT: the deploy has already succeeded and the server is healthy, so a
# seed failure must only WARN, never fail the deploy or trip rollback. Always
# returns 0 (callers also guard with `|| true`).
seed_dream_wake_jobs() {
  local script="$CONTAINER_REPO_DIR/apps/ui-web/scripts/dream-wake-install.ts"
  luna_info "post-deploy: seeding V2 dream/wake job rows (idempotent)"
  if run_target "$BUN_BIN" run "$script"; then
    luna_info "post-deploy: dream/wake job rows ensured"
  else
    luna_warn "post-deploy: dream/wake seed FAILED (non-fatal); if wake/dream go dark, run manually: $BUN_BIN run $script"
  fi
  return 0
}

# --- rollback ----------------------------------------------------------------
# Single rollback path used for EVERY forward failure — whether the new version
# failed its health probe OR a forward command (bun install / restart) errored.
# Returns nothing: it always exits. Exit 1 = recovered to PREV; exit 2 = CRITICAL
# (rollback itself failed, by command error OR by failing its own health probe).
# Releases-layout rollback: flip current back to PREV inside the guarded
# restart window. NO git surgery, NO install, NO rebuild — the previous
# release is immutable and already built. Always exits (like do_rollback):
# 1 recovered, 2 CRITICAL, 3 guard-deferred (journal retained).
do_rollback_releases() {
  # FORWARD_RESTART_RAN scoping is identical to inplace. In releases mode
  # pre-flip failures (materialize/install/build) never enter rollback at all
  # (current never moved, old server never stopped), so this path is normally
  # reached only after a forward restart interrupted service — but the scoping
  # stays explicit so a future caller cannot widen the exemption.
  if [[ "$FORWARD_RESTART_RAN" == true ]]; then
    GUARD_SESSIONS=false
    luna_warn "rollback restart proceeds without the session guard: the forward restart already interrupted service, and blocking rollback would strand a broken build"
  else
    luna_warn "rollback before any forward restart: the old server was never stopped, so the session guard stays ACTIVE for the rollback restart"
  fi
  luna_warn "ROLLING BACK (flip) to $PREV"
  write_transaction "rolling-back" || true
  TRANSACTION_TRACK_APPLY=false
  EXPECTED_BUILD_SHA="$PREV"
  ALLOW_MISSING_BUILD_SHA=true
  if [[ ! -f "$RELEASES_DIR/$PREV/.complete" ]]; then
    printf 'CRITICAL: rollback target release %s is missing or incomplete (%s/.complete absent) — server may be DOWN. Manual remedy: re-materialize with --materialize --ref %s, or flip to another complete release: ln -sfT releases/<sha> %s && systemctl restart %s.\n' \
      "$PREV" "$RELEASES_DIR/$PREV" "$PREV" "$CURRENT_LINK" "$SERVICE_NAME" >&2
    write_transaction "rollback-failed" || true
    exit 2
  fi
  # Re-pin claude against the rollback release, written through-current.
  # Warn-only: restoring service outranks a pin defect (same reasoning as the
  # inplace exit-9 degrade).
  repin_claude_releases "$PREV" ||
    luna_warn "claude re-pin against rollback release $PREV failed; pin may be stale (server still restored)"
  local ok=true rollback_restart_rc=0
  RESTART_PRESTART_HOOK=(flip_current "$PREV")
  restart_service || rollback_restart_rc=$?
  if (( rollback_restart_rc == 3 )); then
    luna_warn "rollback restart DEFERRED by session guard (current untouched); transaction journal retained (phase=rolling-back) — resumes when sessions end"
    exit 3
  fi
  (( rollback_restart_rc == 0 )) || ok=false
  if [[ "$ok" == true ]]; then
    local rollback_baseline
    rollback_baseline="$(readiness_restart_baseline)"
    if readiness_ok "$rollback_baseline"; then
      luna_warn "update to $REF failed — ROLLED BACK (flipped) to $PREV ($SERVICE_NAME healthy)"
      clear_transaction
      # Retention runs on the recovered-rollback exit too: a branch that keeps
      # advancing while every deploy fails readiness otherwise accumulates
      # complete-but-failed releases without bound (nothing else prunes until
      # a deploy finally SUCCEEDS). Protection covers current (=PREV) and
      # previous (=the failed REF, retained for forensics).
      prune_releases
      exit 1
    fi
  fi
  printf 'CRITICAL: update to %s failed AND rollback flip to %s also failed — server may be DOWN. Manual remedy: ln -sfT releases/%s %s && systemctl restart %s (see docs/deploy-layout-migration.md).\n' \
    "$REF" "$PREV" "$PREV" "$CURRENT_LINK" "$SERVICE_NAME" >&2
  write_transaction "rollback-failed" || true
  exit 2
}

do_rollback() {
  if [[ "$LAYOUT" == "releases" ]]; then
    do_rollback_releases
    # not reached — do_rollback_releases always exits
  fi
  # The guard exemption is SCOPED, not unconditional. Two cases:
  #   - FORWARD_RESTART_RAN=true: the forward restart already interrupted
  #     service, so the guard has nothing left to protect and blocking rollback
  #     would strand a broken build. Exempt (rollback restart cannot return 3).
  #   - FORWARD_RESTART_RAN=false: an APPLY-phase failure (bun install / SPA
  #     build error) — the OLD server never stopped and is still serving, and
  #     sessions may have been established since the pre-mutation guard check.
  #     The guard stays ACTIVE: a defer restores nothing further (apply_ref
  #     below has already reset the checkout to PREV, matching the still-running
  #     build), keeps the journal at phase=rolling-back, and exits 3 so the next
  #     idle tick finishes the rollback restart.
  if [[ "$FORWARD_RESTART_RAN" == true ]]; then
    GUARD_SESSIONS=false
    luna_warn "rollback restart proceeds without the session guard: the forward restart already interrupted service, and blocking rollback would strand a broken build"
  else
    luna_warn "rollback after an apply-phase failure: the old server was never stopped, so the session guard stays ACTIVE for the rollback restart"
  fi
  luna_warn "ROLLING BACK to $PREV"
  write_transaction "rolling-back" || true
  TRANSACTION_TRACK_APPLY=false
  EXPECTED_BUILD_SHA="$PREV"
  ALLOW_MISSING_BUILD_SHA=true
  local ok=true
  apply_ref "$PREV" "$(lockfile_hash)" --no-fetch || ok=false
  if [[ "$ok" == true ]]; then
    local rollback_restart_rc=0
    restart_service || rollback_restart_rc=$?
    if (( rollback_restart_rc == 3 )); then
      # Only reachable when the guard stayed active (apply-phase failure, old
      # server still serving). The checkout is already back at PREV — the state
      # the running server was built from — so nothing is stranded; the journal
      # (phase=rolling-back) resumes the restart on the next idle tick.
      luna_warn "rollback restart DEFERRED by session guard (old server still serving; checkout already restored to $PREV); transaction journal retained (phase=rolling-back) — resumes when sessions end"
      exit 3
    fi
    (( rollback_restart_rc == 0 )) || ok=false
  fi
  if [[ "$ok" == true ]]; then
    local rollback_baseline
    rollback_baseline="$(readiness_restart_baseline)"
    if readiness_ok "$rollback_baseline"; then
      luna_warn "update to $REF failed — ROLLED BACK to $PREV ($SERVICE_NAME healthy)"
      clear_transaction
      exit 1
    fi
  fi
  # Remediation hint must match the supervisor — pointing a macOS operator at
  # `systemctl`/`journalctl` during an outage sends them to dead-ends.
  local hint
  if [[ "$SUPERVISOR" == "launchd" ]]; then
    hint="launchctl print gui/$UID/$LAUNCHD_LABEL; log show --last 10m --predicate 'process == \"bun\"'"
  elif [[ "$SYSTEMD_USER" == true ]]; then
    hint="systemctl --user status $SERVICE_NAME; journalctl --user -u $SERVICE_NAME"
  else
    hint="systemctl status $SERVICE_NAME; journalctl -u $SERVICE_NAME"
  fi
  printf 'CRITICAL: update to %s failed AND rollback to %s also failed — server may be DOWN. Manual intervention required (check: %s).\n' \
    "$REF" "$PREV" "$hint" >&2
  write_transaction "rollback-failed" || true
  exit 2
}

# Handle a forward-path failure: roll back if enabled, else die at the new ref.
fail_forward() {
  local reason="$1"
  luna_warn "update to $REF failed: $reason (HEAD=${NEW_HEAD:-$REF})"
  if [[ "$ROLLBACK" == false ]]; then
    write_transaction "forward-failed" || true
    luna_die "$reason and --no-rollback set; server left at ${NEW_HEAD:-$REF} (may be unhealthy)"
  fi
  do_rollback
}

# --- live update --------------------------------------------------------------
if ! acquire_update_lock; then
  # Contention is a safe defer, not an update failure. The timer retries.
  # --restart-only (a repair rung) reports contention as exit 4 — DISTINCT from
  # the session-guard defer (3), because no sessions were ever evaluated here.
  # Conflating them made do_repair and the guardian page "DEFERRED by session
  # guard — live or unknown sessions" while the real cause was a concurrent
  # update holding the profile lock, sending the responder to a false diagnosis.
  [[ "$RESTART_ONLY" == true ]] && exit 4
  exit 0
fi

# --- restart-only mode (repair ladder rung 1) ---------------------------------
# A plain guarded stop -> settle -> start + readiness probe. No journal writes,
# no git mutation, no bun install/build, no rollback. ALLOW_MISSING_BUILD_SHA
# stays false: a build that cannot identify itself fails rung 1 and correctly
# escalates to rung 2 (full redeploy). A pending update transaction takes
# precedence — run normal recovery instead of the light path.
if [[ "$RESTART_ONLY" == true ]]; then
  if [[ -f "$UPDATE_JOURNAL" ]]; then
    luna_warn "restart-only requested but an update transaction is pending; running normal recovery instead"
  else
    RRC=0
    restart_service || RRC=$?
    if (( RRC == 3 )); then exit 3; fi
    if (( RRC != 0 )); then luna_warn "restart-only: restart errored (checkout untouched; no rollback)"; exit 1; fi
    RESTART_BASELINE="$(readiness_restart_baseline)"
    if [[ "$LAYOUT" == "releases" ]]; then
      # The deployed identity is the resolved current release, never the
      # mirror's meaningless HEAD. Fail closed on a dangling current.
      EXPECTED_BUILD_SHA="$(deployed_sha)" ||
        luna_die "cannot resolve the deployed release ($CURRENT_LINK) for the restart-only readiness gate"
    else
      EXPECTED_BUILD_SHA="$(git_target_capture rev-parse HEAD)"
    fi
    if readiness_ok "$RESTART_BASELINE"; then
      luna_info "restart-only: $SERVICE_NAME healthy at ${EXPECTED_BUILD_SHA:0:12}"
      exit 0
    fi
    luna_warn "restart-only: readiness failed after plain restart (checkout untouched; no rollback)"
    exit 1
  fi
fi

NEW_HEAD=""
# RECOVERY_PHASE: the journal phase this run RECOVERED from ("" on a fresh
# run). Captured at load time because write_transaction overwrites TX_PHASE
# mid-run. Load-bearing for releases-mode failure routing: recovery of
# phase=restarting/verifying means the crashed run may already have STOPPED
# the unit and/or FLIPPED current, so an apply failure there must never claim
# "old server still serving" nor destroy the journal.
RECOVERY_PHASE=""
if [[ -f "$UPDATE_JOURNAL" ]]; then
  if ! load_transaction; then
    printf 'CRITICAL: corrupt update transaction journal %s — refusing to mutate the checkout; inspect or remove it manually.\n' "$UPDATE_JOURNAL" >&2
    exit 2
  fi
  PREV="$TX_PREV"
  REF="$TX_TARGET"
  PREV_LOCK_HASH="$TX_PREV_LOCK_HASH"
  RECOVERY_PHASE="$TX_PHASE"
  luna_warn "RECOVERING interrupted update phase=$TX_PHASE prev=${PREV:0:9} target=${REF:0:9}"
  if [[ "$TX_PHASE" == "rolling-back" || "$TX_PHASE" == "rollback-failed" ]]; then
    # A mid-rollback journal means a prior run already began the rollback; the
    # service interruption (if any) already happened in that run and blocking
    # recovery here would strand a broken build. Treat recovery like the
    # post-forward-restart case: the rollback restart is exempt from the guard.
    FORWARD_RESTART_RAN=true
    do_rollback
  fi
  # Forward-resume phases only (do_rollback above never returns): the recovery
  # re-applies and restarts, so the same pre-mutation session-guard check
  # applies. A deferred resume keeps the journal intact and retries next tick.
  # A phase=restarting resume self-permits via the guard itself (server already
  # stopped -> unit answers inactive/failed, or old server still running with
  # 0 sessions -> count 0).
  if [[ -n "$TX_PHASE" ]]; then
    if ! restart_session_guard; then
      luna_warn "DEFERRED by session guard; transaction journal retained (phase=$TX_PHASE) — resumes when sessions end"
      exit 3
    fi
  fi
else
  if [[ "$LAYOUT" == "releases" ]]; then
    # PREV is the RESOLVED deployed release — by construction the sha the
    # server was built from (strictly stronger than a driftable HEAD), and the
    # rollback flip target. The lock "hash" is the mirror's bun.lock blob id
    # at PREV (journal field prev_lock_hash keeps its name and 40-hex shape).
    PREV="$(deployed_sha)" ||
      luna_die "could not resolve the deployed release via $CURRENT_LINK (dangling/incomplete current fails closed; see docs/deploy-layout-migration.md)"
    PREV_LOCK_HASH="$(mirror_lock_blob "$PREV")"
    luna_info "Current release: $PREV"
  else
    PREV="$(git_target_capture rev-parse HEAD)"
    [[ -n "$PREV" ]] || luna_die "could not read current HEAD in $HOST_REPO_DIR"
    PREV_LOCK_HASH="$(lockfile_hash)"
    luna_info "Current HEAD: $PREV"
  fi

  # Resolve the requested moving ref to an immutable commit while holding the
  # profile lock. The journal always records this exact target, so recovery can
  # finish the same transaction even if origin advances again meanwhile.
  REQUESTED_REF="$REF"
  git_target fetch origin || luna_die "fetch failed before update; checkout unchanged"
  if [[ "$LAYOUT" == "releases" ]]; then
    # Releases mode normalizes EVERY ref — hex included — through the mirror
    # to the FULL LOWERCASE sha (exactly what --materialize already does).
    # Passing an operator-supplied hex ref through verbatim regresses two
    # spellings inplace handles: an abbreviated sha fails materialize's
    # exact-length HEAD postcondition with a misleading corruption warning,
    # and an UPPERCASE sha survives the flip only to fail readiness's
    # case-sensitive buildSha compare — flip-rolling-back a healthy deploy on
    # every attempt. The full sha also names the release directory, so the
    # canonical form is load-bearing, not cosmetic.
    REF="$(git_target_capture rev-parse --verify "${REQUESTED_REF}^{commit}" 2>/dev/null || true)"
    REF="${REF,,}"
    [[ "$REF" =~ ^[0-9a-f]{40}$ ]] ||
      luna_die "could not resolve target ref $REQUESTED_REF in $MIRROR_GIT"
  elif [[ "$REQUESTED_REF" =~ ^[0-9a-fA-F]{7,64}$ ]]; then
    REF="$REQUESTED_REF"
  else
    REF="$(git_target_capture rev-parse "${REQUESTED_REF}^{commit}")"
  fi
  [[ "$REF" =~ ^[0-9a-fA-F]{7,64}$ ]] || luna_die "could not resolve target ref $REQUESTED_REF"
  # Pre-mutation session-guard check: defer BEFORE the first journal write so a
  # deferred fresh run leaves nothing behind (the fetch/ref resolution above only
  # touched remote refs, not the checkout; the lock is released by the EXIT trap).
  if ! restart_session_guard; then
    luna_warn "DEFERRED by session guard; nothing mutated (retry next tick)"
    exit 3
  fi
  write_transaction "prepared"
fi

# A forward command-level failure (fetch/reset/install) routes into rollback —
# NOT a `set -e` abort. This is the whole point of auto-rollback.
# Releases layout: a PRE-FLIP failure (materialize/install/build) never enters
# rollback at all — current never moved and the old server never stopped, so
# there is nothing to roll back. Warn, clear the journal, exit 1; the failed
# build tree was already cleaned up by materialize_release.
# EXCEPT during journal RECOVERY of phase=restarting/verifying: there the
# crashed run may already have stopped the unit and/or flipped current, so
# "current untouched, old server still serving" would be a false claim, and
# clearing the journal would (a) destroy the prev/target forensics and (b)
# let autodeploy's local==remote check converge to a silent no-op with the
# server actually down. Retain the journal (the next tick — timer, autodeploy,
# or guardian --restart-only's recovery precedence — resumes it) and report
# the true uncertainty.
TRANSACTION_TRACK_APPLY=true
if ! apply_ref "$REF" "$PREV_LOCK_HASH" --no-fetch; then
  TRANSACTION_TRACK_APPLY=false
  if [[ "$LAYOUT" == "releases" ]]; then
    if [[ "$RECOVERY_PHASE" == "restarting" || "$RECOVERY_PHASE" == "verifying" ]]; then
      luna_warn "recovery (phase=$RECOVERY_PHASE) could not re-apply $REF: the interrupted run may already have stopped the unit and/or flipped current — journal RETAINED for the next tick; do NOT assume the old server is serving (verify: systemctl status $SERVICE_NAME)"
      exit 1
    fi
    luna_warn "materialize/build of $REF failed PRE-flip — current untouched, old server still serving; nothing to roll back (failed build tree cleaned up)"
    clear_transaction
    exit 1
  fi
  fail_forward "apply to $REF errored"
fi
TRANSACTION_TRACK_APPLY=false
if [[ "$LAYOUT" == "releases" ]]; then
  # The target was already resolved to an immutable sha against the mirror
  # while holding the lock — no post-mutation read exists to disagree with it.
  NEW_HEAD="$REF"
  luna_info "Materialized release: $NEW_HEAD"
else
  NEW_HEAD="$(git_target_capture rev-parse HEAD)"
  luna_info "Checked out: $NEW_HEAD"
fi
write_transaction "applied"

write_transaction "restarting"
# Releases layout: arm the in-window flip. From here every failure path is
# post-guard-decision; a guard defer (rc=3 below) still leaves current
# untouched because the hook runs strictly AFTER the guard permits the stop.
if [[ "$LAYOUT" == "releases" ]]; then
  RESTART_PRESTART_HOOK=(flip_current "$REF")
fi
# rc==3 (session-guard defer) must NOT route into fail_forward: fail_forward's
# rollback would perform the very restart the guard just refused. Exit 3 keeps
# the journal at phase=restarting; the next tick resumes when sessions end.
RESTART_RC=0
restart_service || RESTART_RC=$?
if (( RESTART_RC == 3 )); then
  luna_warn "DEFERRED by session guard mid-transaction; journal retained (phase=restarting) — resumes next tick"
  exit 3
fi
# Past the guard: the stop (at least) was attempted, so service is interrupted.
# From here any rollback is exempt from the session guard (see do_rollback).
FORWARD_RESTART_RAN=true
if (( RESTART_RC != 0 )); then
  fail_forward "service restart errored"
fi
# Capture NRestarts right AFTER issuing the restart; require it not to climb
# during the probe window (a climbing count means the unit is crash-looping).
RESTART_BASELINE="$(readiness_restart_baseline)"
EXPECTED_BUILD_SHA="$NEW_HEAD"
write_transaction "verifying"

if readiness_ok "$RESTART_BASELINE"; then
  luna_info "updated $PREV -> $NEW_HEAD ($SERVICE_NAME healthy)"
  seed_dream_wake_jobs || true
  clear_transaction
  # Retention runs ONLY at the end of a healthy releases deploy, after the
  # journal is cleared (a prune postcondition failure must not strand a
  # phase=verifying journal that recovery would re-restart from).
  if [[ "$LAYOUT" == "releases" ]]; then
    prune_releases
  fi
  exit 0
fi

fail_forward "failed readiness"
