#!/usr/bin/env bash
# Create an Incus system container for a Luna runtime.
#
# Fence ACL (--fence / LUNA_FENCE):
#   Off by default — zero behaviour change for existing callers. When enabled,
#   creates a bridge-isolation ACL that allows the bridge gateway and rejects all
#   other bridge peers. The reject destination is derived as a host range that
#   EXCLUDES the gateway, so rule ordering in the firewall backend is irrelevant.
#   See docs/runbooks/incus-fence-acl.md for the full rationale and diagnosis.

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/luna-deploy.sh
source "$SCRIPT_DIR/lib/luna-deploy.sh"

PROFILE="${LUNA_PROFILE:-dev}"
INSTANCE=""
REPO_URL="${LUNA_REPO:-https://github.com/fourcolors/luna.git}"
BRANCH="${LUNA_BRANCH:-}"
REPO_PATH=""
STATE_PATH=""
HOST="${LUNA_HOST:-jax-box}"
# Host-side proxy exposure — THE real network-exposure knob. When unset, it is
# auto-resolved after arg parsing (luna_resolve_bind_addr): the host's Tailscale
# IP if a tailnet is present (so a fresh container serves tailnet peers out of the
# box), else loopback. The WS layer is plaintext ws:// with the token in the URL,
# so a public 0.0.0.0 proxy listen leaks the token to anything on the wire —
# reaching 0.0.0.0 must be a CONSCIOUS choice (--i-understand-public, or an
# explicit 0.0.0.0 via LUNA_LISTEN_ADDR / --listen-addr). An explicit env/flag
# value always wins over auto-resolution.
LISTEN_ADDR="${LUNA_LISTEN_ADDR:-}"
I_UNDERSTAND_PUBLIC=false
HOST_WS_PORT=""
HOST_CONTROL_PORT=""
TOKEN="${LUNA_UI_WS_TOKEN:-}"
IMAGE="${LUNA_INCUS_IMAGE:-images:ubuntu/24.04/cloud}"
DRY_RUN=false
INIT_INCUS=false
REPLACE=false
SKIP_CLONE=false
AUTO_UPDATE=true
ENABLE_DANGEROUS_LOCAL_SHELL=false
EMBEDDER="${LUNA_EMBEDDER:-}"
OLLAMA_BASE_URL="${LUNA_OLLAMA_BASE_URL:-}"
OLLAMA_EMBED_MODEL="${LUNA_OLLAMA_EMBED_MODEL:-}"
OLLAMA_EMBED_DIMENSION="${LUNA_OLLAMA_EMBED_DIMENSION:-}"
OLLAMA_PROBE_TIMEOUT_MS="${LUNA_OLLAMA_PROBE_TIMEOUT_MS:-}"
# Fence ACL — isolate container from bridge peers while preserving gateway access.
# Default OFF: zero behaviour change for existing callers. Enable with --fence or
# LUNA_FENCE=true. See docs/runbooks/incus-fence-acl.md for the full rationale.
FENCE="${LUNA_FENCE:-false}"
FENCE_ACL_NAME="${LUNA_FENCE_ACL_NAME:-}"
FENCE_BRIDGE="${LUNA_FENCE_BRIDGE:-incusbr0}"
FENCE_GATEWAY="${LUNA_FENCE_GATEWAY:-}"

usage() {
  cat <<'EOF'
Usage: scripts/luna-container-create [options]

Options:
  --dry-run                    Print the Incus/container plan without changing the host.
  --profile <name>             Profile name. Default: dev.
  --name <instance>            Incus instance name. Default: luna-<profile>.
  --repo <url>                 Luna git URL. Default: https://github.com/fourcolors/luna.git
  --branch <branch>            Git branch to checkout. Default: master for stable, profile name otherwise.
  --repo-path <path>           Host repo path mounted at /root/luna.
  --state-path <path>          Host state path mounted at /root/.luna.
  --host <hostname>            Hostname clients use. Default: jax-box.
  --listen-addr <addr>         Host listen address for proxies. Default: auto —
                               the host's Tailscale IP if a tailnet is present
                               (serves remote clients), else 127.0.0.1 loopback.
  --i-understand-public        Expose the host proxies on 0.0.0.0 (all interfaces).
                               UNSAFE without Tailscale/a private interface: ws://
                               is plaintext and carries the token in the URL.
  --host-ws-port <port>        Host WebSocket proxy port.
  --host-control-port <port>   Host control proxy port.
  --token <token>              UI WebSocket token to write if no token exists.
  --embedder <name>            Memory embedder: stub or ollama. Omitted preserves/defaults.
  --ollama-base-url <url>      Ollama base URL for LUNA_EMBEDDER=ollama.
  --ollama-embed-model <m>     Ollama embedding model. Default in code: embeddinggemma.
  --ollama-embed-dimension <n> Optional expected embedding dimension.
  --ollama-probe-timeout-ms <n>
                               Optional startup probe timeout.
  --fence                      Create a bridge-isolation ACL for this container.
                               Default OFF. Enable via LUNA_FENCE=true.
                               See docs/runbooks/incus-fence-acl.md.
  --fence-acl-name <name>      ACL name. Default: <container>-fence (LUNA_FENCE_ACL_NAME).
  --fence-bridge <bridge>      Bridge network name. Default: incusbr0 (LUNA_FENCE_BRIDGE).
  --fence-gateway <ip/prefix>  Gateway CIDR. Default: auto-detected from bridge config
                               (LUNA_FENCE_GATEWAY).
  --init-incus                 Run `incus admin init --minimal` if Incus is uninitialized.
  --replace                    Delete an existing instance with this name before creating it.
  --skip-clone                 Require an existing repo path instead of cloning/updating it.
  --no-auto-update             Do not install the host-side auto-update timer for
                               this channel (default: installed and enabled; the
                               timer defers while WebSocket sessions are active).
  --enable-dangerous-local-shell
                               Write the marker and profile env that allow the
                               chat server to attach a container-scoped local
                               shell sandbox.
  -h, --help                   Show this help.

The container is unprivileged, uses security.nesting=true for Bun, mounts the
repo/state from /root/luna/<profile>/repo and /root/.luna-<profile>, and proxies
host ports to container-local 4753/4754.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY_RUN=true; shift ;;
    --profile) PROFILE="${2:?missing --profile value}"; shift 2 ;;
    --name) INSTANCE="${2:?missing --name value}"; shift 2 ;;
    --repo) REPO_URL="${2:?missing --repo value}"; shift 2 ;;
    --branch) BRANCH="${2:?missing --branch value}"; shift 2 ;;
    --repo-path) REPO_PATH="${2:?missing --repo-path value}"; shift 2 ;;
    --state-path) STATE_PATH="${2:?missing --state-path value}"; shift 2 ;;
    --host) HOST="${2:?missing --host value}"; shift 2 ;;
    --listen-addr) LISTEN_ADDR="${2:?missing --listen-addr value}"; shift 2 ;;
    --i-understand-public) I_UNDERSTAND_PUBLIC=true; LISTEN_ADDR="0.0.0.0"; shift ;;
    --host-ws-port) HOST_WS_PORT="${2:?missing --host-ws-port value}"; shift 2 ;;
    --host-control-port) HOST_CONTROL_PORT="${2:?missing --host-control-port value}"; shift 2 ;;
    --token) TOKEN="${2:?missing --token value}"; shift 2 ;;
    --embedder) EMBEDDER="${2:?missing --embedder value}"; shift 2 ;;
    --ollama-base-url) OLLAMA_BASE_URL="${2:?missing --ollama-base-url value}"; shift 2 ;;
    --ollama-embed-model) OLLAMA_EMBED_MODEL="${2:?missing --ollama-embed-model value}"; shift 2 ;;
    --ollama-embed-dimension) OLLAMA_EMBED_DIMENSION="${2:?missing --ollama-embed-dimension value}"; shift 2 ;;
    --ollama-probe-timeout-ms) OLLAMA_PROBE_TIMEOUT_MS="${2:?missing --ollama-probe-timeout-ms value}"; shift 2 ;;
    --fence) FENCE=true; shift ;;
    --fence-acl-name) FENCE_ACL_NAME="${2:?missing --fence-acl-name value}"; shift 2 ;;
    --fence-bridge) FENCE_BRIDGE="${2:?missing --fence-bridge value}"; shift 2 ;;
    --fence-gateway) FENCE_GATEWAY="${2:?missing --fence-gateway value}"; shift 2 ;;
    --init-incus) INIT_INCUS=true; shift ;;
    --replace) REPLACE=true; shift ;;
    --skip-clone) SKIP_CLONE=true; shift ;;
    --no-auto-update) AUTO_UPDATE=false; shift ;;
    --enable-dangerous-local-shell) ENABLE_DANGEROUS_LOCAL_SHELL=true; shift ;;
    -h|--help) usage; exit 0 ;;
    *) luna_die "unknown option: $1" ;;
  esac
done

luna_validate_profile "$PROFILE"

# When neither LUNA_LISTEN_ADDR nor --listen-addr chose a host-proxy listen,
# auto-resolve it: the host's Tailscale IP if a tailnet is present (so a fresh
# container serves tailnet peers), else loopback with a warning.
if [[ -z "$LISTEN_ADDR" ]]; then
  LISTEN_ADDR="$(luna_resolve_bind_addr)"
fi

# Loud one-line warning whenever the EFFECTIVE host-proxy listen is the public
# wildcard. The WS layer is plaintext ws:// with the token in the URL, so a
# 0.0.0.0 proxy listen has no transport confidentiality and MUST sit behind
# Tailscale/a private interface. --i-understand-public is the explicit opt-in;
# an explicit LUNA_LISTEN_ADDR / --listen-addr of 0.0.0.0 is also honored (and
# warned about).
if [[ "$LISTEN_ADDR" == "0.0.0.0" ]]; then
  luna_warn "exposing host proxy on 0.0.0.0 (public): plaintext ws:// + token-in-URL has NO transport confidentiality — MUST be behind Tailscale or a private interface (opt-in via --i-understand-public)"
fi
: "$I_UNDERSTAND_PUBLIC"

if [[ -z "$BRANCH" ]]; then
  if [[ "$PROFILE" == "stable" ]]; then
    BRANCH="master"
  else
    BRANCH="$PROFILE"
  fi
fi

[[ "$BRANCH" =~ ^[A-Za-z0-9._/-]+$ ]] || luna_die "branch contains unsupported characters"

PROFILE_ENV="$(luna_profile_env_name "$PROFILE")"
CHAT_SERVER_NAME="$(luna_chat_server_name "$PROFILE")"
CONTAINER_LUNA_HOME="/root/.luna"

if [[ -z "$INSTANCE" ]]; then
  INSTANCE="luna-${PROFILE}"
fi

if [[ -z "$REPO_PATH" ]]; then
  REPO_PATH="/root/luna/${PROFILE}/repo"
fi

if [[ -z "$STATE_PATH" ]]; then
  if [[ "$PROFILE" == "stable" ]]; then
    STATE_PATH="/root/.luna"
  else
    STATE_PATH="/root/.luna-${PROFILE}"
  fi
fi

if [[ -z "$HOST_WS_PORT" ]]; then
  if [[ "$PROFILE" == "stable" ]]; then
    HOST_WS_PORT="4753"
  else
    HOST_WS_PORT="5753"
  fi
fi

if [[ -z "$HOST_CONTROL_PORT" ]]; then
  if [[ "$PROFILE" == "stable" ]]; then
    HOST_CONTROL_PORT="4754"
  else
    HOST_CONTROL_PORT="5754"
  fi
fi

[[ "$HOST_WS_PORT" =~ ^[0-9]+$ ]] || luna_die "--host-ws-port must be numeric"
[[ "$HOST_CONTROL_PORT" =~ ^[0-9]+$ ]] || luna_die "--host-control-port must be numeric"

if [[ -z "$TOKEN" ]]; then
  profile_token_var="LUNA_${PROFILE_ENV}_UI_WS_TOKEN"
  TOKEN="${!profile_token_var:-}"
fi

# apply_fence_acl — idempotent creation of a bridge-isolation ACL.
#
# Derives the peer-host reject range from the gateway CIDR, then emits the
# allow-gateway egress rule FIRST and the reject-peers rule(s) after it,
# so the allow wins regardless of firewall backend rule evaluation order.
#
# For a /24 with gateway at .1: reject range is .2-.254.
# For other prefix lengths: arithmetic derivation handles /1-/30.
# If the gateway is not the first usable host, two reject ranges are emitted
# (one segment below the gateway, one above).
# /31 and /32 are rejected with a clear error — no usable peer range exists.
#
# Idempotency: an ACL that already exists is reused verbatim (with a warning) —
# it is a network-level resource shared across container recreations, so
# --replace never rewrites it. Repairing a bad ACL requires detach + delete +
# re-run; see docs/runbooks/incus-fence-acl.md.
#
# Test seam: set LUNA_TEST_FENCE_GATEWAY to override bridge auto-detection.
apply_fence_acl() {
  if [[ "$FENCE" != true ]]; then
    return 0
  fi

  # Resolve ACL name default (requires $INSTANCE to be set by this point)
  if [[ -z "$FENCE_ACL_NAME" ]]; then
    FENCE_ACL_NAME="${INSTANCE}-fence"
  fi

  # Resolve gateway CIDR: explicit flag > test seam > live bridge query
  local gw_cidr
  if [[ -n "$FENCE_GATEWAY" ]]; then
    gw_cidr="$FENCE_GATEWAY"
  elif [[ "${LUNA_TEST_FENCE_GATEWAY+set}" == "set" ]]; then
    gw_cidr="$LUNA_TEST_FENCE_GATEWAY"
  else
    gw_cidr="$(incus network get "$FENCE_BRIDGE" ipv4.address 2>/dev/null || true)"
    if [[ -z "$gw_cidr" ]]; then
      if [[ "${DRY_RUN:-false}" == true ]]; then
        luna_warn "fence: could not auto-detect gateway (incus unavailable); using placeholder 10.77.0.1/24 for dry-run output"
        gw_cidr="10.77.0.1/24"
      else
        luna_die "fence: could not read ipv4.address from bridge $FENCE_BRIDGE"
      fi
    fi
  fi

  local gw_ip prefix
  gw_ip="${gw_cidr%%/*}"
  prefix="${gw_cidr##*/}"

  [[ "$prefix" =~ ^[0-9]+$ ]] || luna_die "fence: invalid prefix in gateway CIDR: $gw_cidr"
  [[ "$prefix" -ge 1 && "$prefix" -le 30 ]] ||
    luna_die "fence: prefix /$prefix has no usable peer host range; use a prefix /1-/30"

  # Parse octets — each must be a decimal 0-255 or the integer arithmetic
  # below silently derives a wrong subnet and reject range.
  local o1 o2 o3 o4 oct
  IFS='.' read -r o1 o2 o3 o4 <<< "$gw_ip"
  for oct in "$o1" "$o2" "$o3" "$o4"; do
    if ! [[ "$oct" =~ ^[0-9]{1,3}$ ]] || (( 10#$oct > 255 )); then
      luna_die "fence: invalid gateway IP octet '${oct:-<empty>}' in: $gw_ip (each octet must be 0-255)"
    fi
  done

  # Integer arithmetic to derive subnet bounds (10# forces decimal so a
  # leading-zero octet like 010 cannot be read as octal)
  local gw_int mask net_int bcast_int first_int last_int
  gw_int=$(( (10#$o1 << 24) | (10#$o2 << 16) | (10#$o3 << 8) | 10#$o4 ))
  mask=$(( ( 0xFFFFFFFF << (32 - prefix) ) & 0xFFFFFFFF ))
  net_int=$(( gw_int & mask ))
  bcast_int=$(( net_int | ( (~mask) & 0xFFFFFFFF ) ))
  first_int=$(( net_int + 1 ))
  last_int=$(( bcast_int - 1 ))

  [[ $last_int -ge $first_int ]] ||
    luna_die "fence: subnet /$prefix is too small for a usable peer host range"
  [[ $gw_int -ge $first_int && $gw_int -le $last_int ]] ||
    luna_die "fence: gateway $gw_ip is outside the usable host range of $gw_cidr"

  # Convert a 32-bit integer back to dotted-decimal
  _fence_int_to_ip() {
    printf '%d.%d.%d.%d' \
      $(( ($1 >> 24) & 0xFF )) $(( ($1 >> 16) & 0xFF )) \
      $(( ($1 >>  8) & 0xFF )) $(( $1 & 0xFF ))
  }

  # Build reject ranges: all usable hosts in the subnet EXCEPT the gateway.
  # If gateway == first_int: one range (gw+1)-last
  # If gateway == last_int:  one range first-(gw-1)
  # Otherwise:               two ranges first-(gw-1) and (gw+1)-last
  local reject_ranges=()
  if [[ $gw_int -gt $first_int ]]; then
    reject_ranges+=("$(_fence_int_to_ip "$first_int")-$(_fence_int_to_ip "$(( gw_int - 1 ))")")
  fi
  if [[ $gw_int -lt $last_int ]]; then
    reject_ranges+=("$(_fence_int_to_ip "$(( gw_int + 1 ))")-$(_fence_int_to_ip "$last_int")")
  fi
  [[ ${#reject_ranges[@]} -gt 0 ]] ||
    luna_die "fence: gateway $gw_ip exhausts the subnet — no peer host range to reject"

  luna_info "Fence ACL: bridge=$FENCE_BRIDGE gateway=${gw_ip}/${prefix} acl=$FENCE_ACL_NAME"
  for r in "${reject_ranges[@]}"; do
    luna_info "  reject peer range: $r"
  done

  # Idempotent: skip creation if the ACL already exists
  local acl_exists=false
  if [[ "${DRY_RUN:-false}" != true ]]; then
    incus network acl show "$FENCE_ACL_NAME" >/dev/null 2>&1 && acl_exists=true || true
  fi

  if [[ "$acl_exists" == false ]]; then
    # Create the ACL
    luna_run incus network acl create "$FENCE_ACL_NAME"
    # Allow the gateway FIRST — this rule must precede any reject rules so that
    # even if the firewall backend reorders rules, the allow is clearly first in
    # the ACL definition.
    luna_run incus network acl rule add "$FENCE_ACL_NAME" egress \
      action=allow "destination=${gw_ip}/32" state=enabled \
      description="allow gateway"
    # Reject all bridge peer hosts that are NOT the gateway
    for r in "${reject_ranges[@]}"; do
      luna_run incus network acl rule add "$FENCE_ACL_NAME" egress \
        action=reject "destination=${r}" state=enabled \
        description="reject bridge peers (not gateway)"
    done
  else
    # The ACL is a network-level resource shared across container recreations
    # (--replace deletes the instance, never the ACL), so an existing ACL is
    # reused verbatim — including any stale or wrong rules it may carry.
    luna_warn "fence: ACL '$FENCE_ACL_NAME' already exists — reusing it AS-IS (existing rules are NOT verified or updated)"
    luna_warn "fence: if you changed --fence-gateway or suspect drift, detach, delete, and re-run:"
    luna_warn "fence:   incus config device set $INSTANCE eth0 security.acls="
    luna_warn "fence:   incus network acl delete $FENCE_ACL_NAME"
    luna_warn "fence: verify with: bash seeds/harness-corpus/probes/060-incus-fence-acl-gateway-guard.sh"
  fi

  # Attach the ACL to the container NIC
  luna_run incus config device set "$INSTANCE" eth0 "security.acls=${FENCE_ACL_NAME}"
}

preflight_incus_reachable() {
  command -v incus >/dev/null 2>&1 || luna_die "Incus CLI not found. Install and initialize Incus before creating Luna containers."
  if ! incus info >/dev/null 2>&1; then
    if [[ "$INIT_INCUS" == true ]]; then
      luna_run incus admin init --minimal
    else
      luna_die "Incus daemon is not reachable or not initialized. Re-run with --init-incus to run 'incus admin init --minimal'."
    fi
  fi
}

preflight_incus_baseline() {
  incus storage show default >/dev/null 2>&1 || luna_die "Incus storage pool 'default' is missing"
  incus network show incusbr0 >/dev/null 2>&1 || luna_die "Incus network 'incusbr0' is missing"
  [[ "$(incus profile device get default root pool 2>/dev/null)" == "default" ]] || luna_die "Incus default profile root disk must use pool=default"
  [[ "$(incus profile device get default root path 2>/dev/null)" == "/" ]] || luna_die "Incus default profile root disk must mount path=/"
  [[ "$(incus profile device get default eth0 network 2>/dev/null)" == "incusbr0" ]] || luna_die "Incus default profile eth0 must use network=incusbr0"
}

prepare_repo() {
  if [[ "$SKIP_CLONE" == true ]]; then
    if [[ "$DRY_RUN" == true ]]; then
      luna_run test -d "$REPO_PATH/.git"
    else
      [[ -d "$REPO_PATH/.git" ]] || luna_die "--skip-clone requires $REPO_PATH to be a git clone"
    fi
    return 0
  fi

  if [[ "$DRY_RUN" == true ]]; then
    luna_run mkdir -p "$(dirname "$REPO_PATH")"
    printf '+ if repo missing: git clone --branch %q %q %q\n' "$BRANCH" "$REPO_URL" "$REPO_PATH"
    printf '+ if repo exists: git -C %q pull --ff-only\n' "$REPO_PATH"
    return 0
  fi

  if [[ -d "$REPO_PATH/.git" ]]; then
    if [[ -n "$(git -C "$REPO_PATH" status --porcelain)" ]]; then
      luna_die "$REPO_PATH has uncommitted changes; commit/stash or use a clean path"
    fi
    git -C "$REPO_PATH" fetch origin "$BRANCH"
    git -C "$REPO_PATH" checkout "$BRANCH"
    git -C "$REPO_PATH" pull --ff-only origin "$BRANCH"
  else
    mkdir -p "$(dirname "$REPO_PATH")"
    git clone --branch "$BRANCH" "$REPO_URL" "$REPO_PATH"
  fi
}

render_cloud_init() {
  cat <<EOF
#cloud-config
package_update: true
packages:
  - ca-certificates
  - curl
  - git
  - unzip
runcmd:
  # --bind-host 127.0.0.1 is explicit and load-bearing: the in-container chat
  # server must bind loopback (the Incus host proxy is the sole ingress and
  # targets 127.0.0.1 inside the container). It also keeps the in-container
  # install from auto-resolving a bind — there is no tailnet inside the
  # container, so leaving it unset would emit a misleading "no Tailscale" warn.
  # Public exposure is controlled at the HOST proxy (--listen-addr), not here.
  - [ bash, -lc, "/root/luna/scripts/luna-server-install --profile ${PROFILE} --repo-dir /root/luna --luna-home /root/.luna --bind-host 127.0.0.1" ]
EOF
}

set_cloud_init() {
  if [[ "$DRY_RUN" == true ]]; then
    printf '+ incus config set %q cloud-init.user-data - <<CLOUD_INIT\n' "$INSTANCE"
    render_cloud_init
    printf 'CLOUD_INIT\n'
    return 0
  fi
  render_cloud_init | incus config set "$INSTANCE" cloud-init.user-data -
}

instance_exists() {
  incus info "$INSTANCE" >/dev/null 2>&1
}

luna_info "Preparing Luna Incus container: $INSTANCE"
printf 'Profile: %s\n' "$PROFILE"
printf 'Branch: %s\n' "$BRANCH"
printf 'Repo mount: %s -> /root/luna\n' "$REPO_PATH"
printf 'State mount: %s -> /root/.luna\n' "$STATE_PATH"
printf 'Client URL: ws://%s:%s/ui\n' "$HOST" "$HOST_WS_PORT"

INSTANCE_ALREADY_EXISTS=false
if [[ "$DRY_RUN" == false ]]; then
  preflight_incus_reachable
  if instance_exists; then
    INSTANCE_ALREADY_EXISTS=true
    if [[ "$REPLACE" == true ]]; then
      preflight_incus_baseline
    else
      luna_info "Incus instance '$INSTANCE' already exists; leaving it unchanged"
      printf 'Use --replace to delete and recreate it, or run scripts/luna-server-install inside the container to repair the server.\n'
      exit 0
    fi
  else
    preflight_incus_baseline
  fi
else
  printf '+ command -v incus\n'
  printf '+ incus info\n'
fi

prepare_repo
luna_run mkdir -p "$STATE_PATH" "$STATE_PATH/claude" "$STATE_PATH/logs" "$STATE_PATH/run"

# Host-specific Claude Code executable overrides commonly break after mounting
# state into a Linux container. luna-server-install will detect a container-local
# executable after dependencies are installed.
luna_remove_env "$STATE_PATH/.env" "LUNA_CLAUDE_CODE_EXECUTABLE"
luna_upsert_env "$STATE_PATH/.env" "CLAUDE_CONFIG_DIR" "/root/.luna/claude"
luna_upsert_env "$STATE_PATH/.env" "LUNA_REPO_ROOT" "/root/luna"
# In-container chat-server bind. The Incus proxy device is the SOLE ingress and
# it connects to 127.0.0.1:4753 inside the container (see `connect=tcp:127.0.0.1`
# below), so loopback is strictly safer than 0.0.0.0 with zero functional loss —
# nothing else can reach the in-container server. Public exposure is governed by
# the host-side --listen-addr / --i-understand-public knob, not this bind.
luna_upsert_env "$STATE_PATH/.env" "LUNA_UI_WS_HOST" "127.0.0.1"
luna_upsert_env "$STATE_PATH/.env" "LUNA_PROFILE" "$PROFILE"
luna_upsert_env "$STATE_PATH/.env" "LUNA_CHAT_SERVER_NAME" "$CHAT_SERVER_NAME"
luna_upsert_env "$STATE_PATH/.env" "LUNA_HOME" "$CONTAINER_LUNA_HOME"
luna_upsert_env "$STATE_PATH/.env" "LUNA_DB_PATH" "$CONTAINER_LUNA_HOME/luna.db"
luna_upsert_env "$STATE_PATH/.env" "LUNA_MEMORY_DB" "$CONTAINER_LUNA_HOME/memory.db"
luna_upsert_env "$STATE_PATH/.env" "LUNA_ANALYTICS_DB_PATH" "$CONTAINER_LUNA_HOME/analytics.duckdb"
luna_upsert_env "$STATE_PATH/.env" "LUNA_EVENTS_JSONL_PATH" "$CONTAINER_LUNA_HOME/events.jsonl"
luna_upsert_env "$STATE_PATH/.env" "LUNA_${PROFILE_ENV}_WS_URL" "ws://${HOST}:${HOST_WS_PORT}/ui"
luna_upsert_env "$STATE_PATH/.env" "LUNA_EMBEDDER" "$EMBEDDER"
luna_upsert_env "$STATE_PATH/.env" "LUNA_OLLAMA_BASE_URL" "$OLLAMA_BASE_URL"
luna_upsert_env "$STATE_PATH/.env" "LUNA_OLLAMA_EMBED_MODEL" "$OLLAMA_EMBED_MODEL"
luna_upsert_env "$STATE_PATH/.env" "LUNA_OLLAMA_EMBED_DIMENSION" "$OLLAMA_EMBED_DIMENSION"
luna_upsert_env "$STATE_PATH/.env" "LUNA_OLLAMA_PROBE_TIMEOUT_MS" "$OLLAMA_PROBE_TIMEOUT_MS"

if luna_env_has_token "$STATE_PATH/.env"; then
  luna_info "Existing UI token found; preserving it"
elif [[ -n "$TOKEN" ]]; then
  luna_upsert_env "$STATE_PATH/.env" "UI_WS_TOKEN" "$TOKEN"
  luna_upsert_env "$STATE_PATH/.env" "LUNA_${PROFILE_ENV}_UI_WS_TOKEN" "$TOKEN"
else
  luna_die "UI token is required. Pass --token or pre-create $STATE_PATH/.env with UI_WS_TOKEN."
fi

luna_upsert_env "$STATE_PATH/.env" "LUNA_RUNTIME_SCOPE" "incus-container"

if [[ "$ENABLE_DANGEROUS_LOCAL_SHELL" == true ]]; then
  luna_upsert_env "$STATE_PATH/.env" "LUNA_${PROFILE_ENV}_DANGEROUS_AUTO_APPROVE_LOCAL_SHELL" "1"
  luna_run touch "$STATE_PATH/allow-dangerous-local-shell"
  if [[ "$DRY_RUN" == false ]]; then
    chmod 0600 "$STATE_PATH/allow-dangerous-local-shell"
  fi
fi

if [[ "$DRY_RUN" == false && "$REPLACE" == true && "$INSTANCE_ALREADY_EXISTS" == true ]]; then
  luna_run incus delete "$INSTANCE" --force
fi

if [[ "$DRY_RUN" == true && "$REPLACE" == true ]]; then
  luna_run incus delete "$INSTANCE" --force
fi

luna_run incus init "$IMAGE" "$INSTANCE" \
  --config security.nesting=true \
  --config boot.autostart=true \
  --config boot.autorestart=true

set_cloud_init

luna_run incus config device add "$INSTANCE" luna-repo disk \
  source="$REPO_PATH" path=/root/luna shift=true
luna_run incus config device add "$INSTANCE" luna-home disk \
  source="$STATE_PATH" path=/root/.luna shift=true
luna_run incus config device add "$INSTANCE" "ws${HOST_WS_PORT}" proxy \
  "listen=tcp:${LISTEN_ADDR}:${HOST_WS_PORT}" "connect=tcp:127.0.0.1:4753" bind=host
luna_run incus config device add "$INSTANCE" "control${HOST_CONTROL_PORT}" proxy \
  "listen=tcp:${LISTEN_ADDR}:${HOST_CONTROL_PORT}" "connect=tcp:127.0.0.1:4754" bind=host

apply_fence_acl

luna_run incus start "$INSTANCE"
luna_run incus exec "$INSTANCE" -- cloud-init status --wait
# cloud-init can report success even when a runcmd task failed internally. Fail
# early with an actionable hint if the in-container luna-server-install never got
# far enough to render its systemd unit. Probe the unit under /etc/systemd/system
# — a CONTAINER-FS-only artifact the in-container install uniquely produces. (Do
# NOT probe /root/.luna/.env: $STATE_PATH is bind-mounted there and host-written
# before the container boots, so it exists regardless of install success.)
STATUS_SERVICE="$(luna_service_name "$PROFILE")"
if [[ "$DRY_RUN" == false ]]; then
  incus exec "$INSTANCE" -- test -f "/etc/systemd/system/$STATUS_SERVICE" ||
    luna_die "In-container luna-server-install failed: systemd unit $STATUS_SERVICE not rendered. Check 'incus logs $INSTANCE' for details."
fi
luna_run incus exec "$INSTANCE" -- test -w /root/luna
luna_run incus exec "$INSTANCE" -- systemctl status "$STATUS_SERVICE"

# ── Host-side auto-update timer (ON by default) ───────────────────────────────
# The autodeploy timer polls GitHub from the HOST (GitHub cannot reach the box)
# and drives luna-update-server against this container when the branch moved
# and no WebSocket sessions are active. Provisioning enables it by default.
# Opt out: --no-auto-update here, `luna-autodeploy uninstall-timer <profile>`
# later, or deploy.autoUpdate = false in the registry (timer no-ops).
install_autoupdate_timer() {
  local registry_file="${LUNA_SERVERS_CONFIG:-/etc/luna/servers.toml}"

  # The timer machinery is registry-driven: seed the registry from the repo
  # template when absent. An existing (operator-edited) file is never touched.
  if [[ ! -f "$registry_file" ]]; then
    if [[ "$DRY_RUN" == true ]]; then
      luna_run mkdir -p "$(dirname "$registry_file")"
      luna_run install -m 0600 "$SCRIPT_DIR/seeds/servers.toml" "$registry_file"
    elif mkdir -p "$(dirname "$registry_file")" 2>/dev/null &&
         install -m 0600 "$SCRIPT_DIR/seeds/servers.toml" "$registry_file" 2>/dev/null; then
      luna_info "Seeded server registry $registry_file from scripts/seeds/servers.toml"
    else
      luna_warn "could not seed $registry_file — auto-update timer not installed. Seed it (see scripts/seeds/servers.toml) and run: $SCRIPT_DIR/luna-autodeploy install-timer $PROFILE"
      return 0
    fi
  fi

  if luna_run "$SCRIPT_DIR/luna-autodeploy" install-timer "$PROFILE"; then
    luna_info "Auto-update timer enabled for '$PROFILE' — disable with: $SCRIPT_DIR/luna-autodeploy uninstall-timer $PROFILE"
  else
    luna_warn "auto-update timer install failed for '$PROFILE' (container itself is fine). Retry with: $SCRIPT_DIR/luna-autodeploy install-timer $PROFILE"
  fi
}

if [[ "$AUTO_UPDATE" == true ]]; then
  install_autoupdate_timer
else
  luna_info "Auto-update timer skipped (--no-auto-update) — enable later with: $SCRIPT_DIR/luna-autodeploy install-timer $PROFILE"
fi

luna_info "Container ready"
printf 'Client config:\n'
printf 'LUNA_%s_WS_URL=ws://%s:%s/ui\n' "$PROFILE_ENV" "$HOST" "$HOST_WS_PORT"
printf 'LUNA_%s_UI_WS_TOKEN=<redacted>\n' "$PROFILE_ENV"
