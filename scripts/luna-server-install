#!/usr/bin/env bash
# Install the Luna chat server as a systemd service.

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/luna-deploy.sh
source "$SCRIPT_DIR/lib/luna-deploy.sh"

export HOME="${HOME:-/root}"

PROFILE="${LUNA_PROFILE:-stable}"
REPO_DIR="${LUNA_REPO_DIR:-/root/luna}"
LUNA_HOME="${LUNA_HOME:-/root/.luna}"
SERVICE_DIR="${LUNA_SERVICE_DIR:-/etc/systemd/system}"
SERVICE_NAME=""
TOKEN="${UI_WS_TOKEN:-${LUNA_UI_WS_TOKEN:-}}"
# Long-lived Claude model-auth token (a `claude setup-token` value). Taken ONLY
# from the environment or --claude-token-file — NEVER a positional/value flag —
# so the secret never lands in argv / shell history / `ps`. When present, the
# default account is pointed at env:CLAUDE_CODE_OAUTH_TOKEN (durable, no
# idle-expiry); the value goes to the gitignored .env, never the repo.
CLAUDE_TOKEN="${CLAUDE_CODE_OAUTH_TOKEN:-}"
CLAUDE_TOKEN_FILE=""
# The chat server's own bind. When unset, it is auto-resolved after arg parsing
# (luna_resolve_bind_addr): the host's Tailscale IP if a tailnet is present (so a
# fresh remote install serves tailnet peers out of the box), else loopback. The
# WS layer is plaintext ws:// with the token in the URL, so a public 0.0.0.0 bind
# leaks the token to anything on the wire — reaching 0.0.0.0 must be a CONSCIOUS
# choice (--i-understand-public, or an explicit 0.0.0.0 via LUNA_UI_WS_HOST /
# --bind-host). An explicit env/flag value always wins over auto-resolution.
BIND_HOST="${LUNA_UI_WS_HOST:-}"
I_UNDERSTAND_PUBLIC=false
DRY_RUN=false
SKIP_DEPS=false
ENABLE_SERVICE=true
START_SERVICE=true
UNITS_ONLY=false
ROTATE_TOKEN=false
EMBEDDER="${LUNA_EMBEDDER:-}"
OLLAMA_BASE_URL="${LUNA_OLLAMA_BASE_URL:-}"
OLLAMA_EMBED_MODEL="${LUNA_OLLAMA_EMBED_MODEL:-}"
OLLAMA_EMBED_DIMENSION="${LUNA_OLLAMA_EMBED_DIMENSION:-}"
OLLAMA_PROBE_TIMEOUT_MS="${LUNA_OLLAMA_PROBE_TIMEOUT_MS:-}"
OLLAMA_PROBE_ATTEMPTS="${LUNA_OLLAMA_PROBE_ATTEMPTS:-}"
OLLAMA_PROBE_BACKOFF_MS="${LUNA_OLLAMA_PROBE_BACKOFF_MS:-}"

usage() {
  cat <<'EOF'
Usage: scripts/luna-server-install [options]

Options:
  --dry-run                 Print the files/commands without changing the host.
  --profile <name>          Runtime profile name. Default: stable.
  --repo-dir <path>         Luna monorepo path. Default: /root/luna.
  --luna-home <path>        Luna state path. Default: /root/.luna.
  --service-dir <path>      systemd unit directory. Default: /etc/systemd/system.
  --service-name <name>     Override generated unit name.
  --token <token>           UI WebSocket token to write if no token exists.
  --rotate-token            Replace existing UI token with --token.
  --claude-token-file <path>
                            File holding a long-lived `claude setup-token`
                            (sk-ant-oat01…). Written to .env as
                            CLAUDE_CODE_OAUTH_TOKEN and the default account is
                            pointed at it (durable model auth, no idle-expiry).
                            The token is NEVER passed as a flag value or printed;
                            you may also supply it via the CLAUDE_CODE_OAUTH_TOKEN
                            env var. Omit it to use the interactive
                            claude-code:login setup flow instead.
  --bind-host <host>        LUNA_UI_WS_HOST value. Default: auto — the host's
                            Tailscale IP if a tailnet is present (serves remote
                            peers), else 127.0.0.1 loopback.
  --i-understand-public     Bind the chat server to 0.0.0.0 (all interfaces).
                            UNSAFE without Tailscale/a private interface: ws://
                            is plaintext and carries the token in the URL.
  --embedder <name>         Memory embedder: stub or ollama. Omitted preserves/defaults.
  --ollama-base-url <url>   Ollama base URL for LUNA_EMBEDDER=ollama.
  --ollama-embed-model <m>  Ollama embedding model. Default in code: embeddinggemma.
  --ollama-embed-dimension <n>
                             Optional expected embedding dimension.
  --ollama-probe-timeout-ms <n>
                             Optional startup probe timeout.
  --ollama-probe-attempts <n>
                            Optional max probe retry attempts (clamped to 5, default 3).
  --ollama-probe-backoff-ms <n>
                            Optional probe backoff interval in milliseconds.
  --skip-deps               Do not install apt packages or Bun.
  --no-enable               Do not run systemctl enable.
  --no-start                Do not start/restart the service.
  --units-only              Re-render supervisor + pager units only; never
                            mutate env/deps/state and never restart. Used by the
                            independent guardian to reconcile unit drift safely.
  -h, --help                Show this help.

This script never prints token values. Existing tokens in .env are preserved
unless --rotate-token is supplied.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY_RUN=true; shift ;;
    --profile) PROFILE="${2:?missing --profile value}"; shift 2 ;;
    --repo-dir) REPO_DIR="${2:?missing --repo-dir value}"; shift 2 ;;
    --luna-home) LUNA_HOME="${2:?missing --luna-home value}"; shift 2 ;;
    --service-dir) SERVICE_DIR="${2:?missing --service-dir value}"; shift 2 ;;
    --service-name) SERVICE_NAME="${2:?missing --service-name value}"; shift 2 ;;
    --token) TOKEN="${2:?missing --token value}"; shift 2 ;;
    --claude-token-file) CLAUDE_TOKEN_FILE="${2:?missing --claude-token-file value}"; shift 2 ;;
    --rotate-token) ROTATE_TOKEN=true; shift ;;
    --bind-host) BIND_HOST="${2:?missing --bind-host value}"; shift 2 ;;
    --i-understand-public) I_UNDERSTAND_PUBLIC=true; BIND_HOST="0.0.0.0"; shift ;;
    --embedder) EMBEDDER="${2:?missing --embedder value}"; shift 2 ;;
    --ollama-base-url) OLLAMA_BASE_URL="${2:?missing --ollama-base-url value}"; shift 2 ;;
    --ollama-embed-model) OLLAMA_EMBED_MODEL="${2:?missing --ollama-embed-model value}"; shift 2 ;;
    --ollama-embed-dimension) OLLAMA_EMBED_DIMENSION="${2:?missing --ollama-embed-dimension value}"; shift 2 ;;
    --ollama-probe-timeout-ms) OLLAMA_PROBE_TIMEOUT_MS="${2:?missing --ollama-probe-timeout-ms value}"; shift 2 ;;
    --ollama-probe-attempts) OLLAMA_PROBE_ATTEMPTS="${2:?missing --ollama-probe-attempts value}"; shift 2 ;;
    --ollama-probe-backoff-ms) OLLAMA_PROBE_BACKOFF_MS="${2:?missing --ollama-probe-backoff-ms value}"; shift 2 ;;
    --skip-deps) SKIP_DEPS=true; shift ;;
    --no-enable) ENABLE_SERVICE=false; shift ;;
    --no-start) START_SERVICE=false; shift ;;
    --units-only) UNITS_ONLY=true; START_SERVICE=false; SKIP_DEPS=true; shift ;;
    -h|--help) usage; exit 0 ;;
    *) luna_die "unknown option: $1" ;;
  esac
done

luna_validate_profile "$PROFILE"

# Resolve the Claude token from --claude-token-file (preferred) over the
# CLAUDE_CODE_OAUTH_TOKEN env var. Strip CR/LF only. Held in memory, never echoed.
if [[ -n "$CLAUDE_TOKEN_FILE" ]]; then
  [[ -r "$CLAUDE_TOKEN_FILE" ]] || luna_die "--claude-token-file not readable: $CLAUDE_TOKEN_FILE"
  CLAUDE_TOKEN="$(cat -- "$CLAUDE_TOKEN_FILE")"
fi
# Strip ALL whitespace (CR/LF/tab/space) from whichever source. OAuth setup-tokens
# contain none, so this just normalizes a file's trailing newline AND makes a
# blank-but-whitespace value collapse to empty — matching chooseDefaultSecretRef's
# .trim() in the seed, so the [[ -n ]] gate below can't write a junk token to .env
# while the seed falls back to claude-code:login.
CLAUDE_TOKEN="$(printf '%s' "$CLAUDE_TOKEN" | tr -d '[:space:]')"

# When neither LUNA_UI_WS_HOST nor --bind-host chose a bind, auto-resolve it:
# the host's Tailscale IP if a tailnet is present (so a fresh remote install
# serves tailnet peers), else loopback with a warning (luna_resolve_bind_addr).
if [[ -z "$BIND_HOST" ]]; then
  BIND_HOST="$(luna_resolve_bind_addr)"
fi

# Loud one-line warning whenever the EFFECTIVE bind is the public wildcard. The
# WS layer is plaintext ws:// with the token in the URL, so 0.0.0.0 has no
# transport confidentiality and MUST sit behind Tailscale/a private interface.
# --i-understand-public is the explicit opt-in; an explicit LUNA_UI_WS_HOST /
# --bind-host of 0.0.0.0 is also honored (and warned about).
if [[ "$BIND_HOST" == "0.0.0.0" ]]; then
  luna_warn "binding chat server to 0.0.0.0 (public): plaintext ws:// + token-in-URL has NO transport confidentiality — MUST be behind Tailscale or a private interface (opt-in via --i-understand-public)"
fi
: "$I_UNDERSTAND_PUBLIC"

if [[ -z "$SERVICE_NAME" ]]; then
  SERVICE_NAME="$(luna_service_name "$PROFILE")"
fi
CHAT_SERVER_NAME="${SERVICE_NAME%.service}"

ENV_FILE="$LUNA_HOME/.env"
SERVICE_FILE="$SERVICE_DIR/$SERVICE_NAME"

install_deps() {
  [[ "$SKIP_DEPS" == false ]] || return 0
  if [[ "$DRY_RUN" == true ]]; then
    luna_run apt-get update
    luna_run apt-get install -y ca-certificates curl git unzip
    luna_run bash -lc 'command -v bun >/dev/null || curl -fsSL https://bun.sh/install | bash'
    return 0
  fi
  if command -v apt-get >/dev/null 2>&1; then
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y ca-certificates curl git unzip
  fi
  if ! command -v bun >/dev/null 2>&1 && [[ ! -x "$HOME/.bun/bin/bun" ]]; then
    curl -fsSL https://bun.sh/install | bash
    export PATH="$HOME/.bun/bin:$PATH"
  fi
}

write_service() {
  local bun_bin="$1"
  if [[ "$DRY_RUN" == true ]]; then
    printf 'Would write %s:\n' "$SERVICE_FILE"
    render_service "$bun_bin"
    return 0
  fi
  mkdir -p "$SERVICE_DIR"
  render_service "$bun_bin" > "$SERVICE_FILE"
}

render_service() {
  local bun_bin="$1"
  local bun_dir
  bun_dir="$(dirname "$bun_bin")"
  # HOME and PATH are LOAD-BEARING for a system service: systemd (verified on
  # systemd 259) sets NO $HOME for a root service and a PATH without the Bun dir.
  # Bun/claude/credential paths rely on $HOME (~/.bun, ~/.claude), so omitting it
  # silently lands the server in setup-mode. CLAUDE_CONFIG_DIR is also redundantly
  # set here (in addition to .env) so a missing .env can't strand the credential
  # dir. Logs go to append-files (not journald) to match the operator workflow.
  # Liveness ladder (L1+L2), motivated by the Sol autopsy:
  # - Type=notify + WatchdogSec: the app sends READY=1 once the WS server
  #   listens (both normal and setup mode) and health-GATED WATCHDOG=1 beats
  #   every ~30s (apps/ui-web/scripts/sd-notify.ts). A wedged-but-alive
  #   process stops beating and pid 1 restarts it — the failure class bare
  #   Restart= can never see. NotifyAccess=all because Bun has no
  #   unix-datagram API, so beats arrive from a spawned systemd-notify child.
  # - StartLimit* + OnFailure: repeated failed starts stop the thrash and
  #   fire the luna-alert@ pager (L2) so a human hears about it — Sol died
  #   silently for 50 days because no failure path ever paged.
  #   INVARIANT (two failure classes, window must hold Burst cycles of BOTH):
  #     wedged-at-start:  cycle = TimeoutStartSec + RestartSec        = 65s
  #     wedged-after-READY (watchdog kill): cycle = boot-to-READY +
  #                        WatchdogSec + RestartSec                   ~ 155s
  #   StartLimitIntervalSec >= StartLimitBurst * worst-cycle, or the loop
  #   never accumulates Burst starts in one window, the unit never enters
  #   failed state, OnFailure/pager NEVER fires, and it restart-loops
  #   silently forever — the Sol failure mode this unit exists to kill.
  #   10 * 155 = 1550 <= 1800. Burst=10 also tolerates legitimate onboarding
  #   churn (setup→login→self-restart cycles).
  # - The alert unit is rendered per-profile (concrete name, no %i template):
  #   dev + stable co-installed on one host must not share a template whose
  #   baked-in LUNA_HOME/pager.env would belong to whichever installed last.
  cat <<EOF
[Unit]
Description=Luna chat server (${PROFILE})
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=1800
StartLimitBurst=10
OnFailure=luna-alert-${CHAT_SERVER_NAME}.service

[Service]
Type=notify
NotifyAccess=all
WatchdogSec=90
TimeoutStartSec=60
WorkingDirectory=${REPO_DIR}/apps/ui-web
Environment=HOME=${HOME}
Environment=PATH=${bun_dir}:/usr/local/bin:/usr/bin:/bin
Environment=CLAUDE_CONFIG_DIR=${LUNA_HOME}/claude
EnvironmentFile=-${ENV_FILE}
ExecStart=${bun_bin} run scripts/chat-server.ts
Restart=always
RestartSec=5
StandardOutput=append:${LUNA_HOME}/logs/${CHAT_SERVER_NAME}.log
StandardError=append:${LUNA_HOME}/logs/${CHAT_SERVER_NAME}-error.log

[Install]
WantedBy=multi-user.target
EOF
}

# ── Liveness ladder L2: failure pager unit ───────────────────────────────────
# Rendered per-profile with a CONCRETE name (luna-alert-<unit>.service, no %i
# template): dev and stable co-install on one host is a supported shape, and a
# shared template would bake in whichever profile installed last — its
# LUNA_HOME, its pager.env — so the other profile's failures would page with
# the wrong (possibly token-less) config. Type=oneshot, fire-and-forget; the
# pager script owns cooldown/no-token behavior and ALWAYS exits 0 so the
# pager itself can never crash-loop.
ALERT_SERVICE_FILE="$SERVICE_DIR/luna-alert-${CHAT_SERVER_NAME}.service"

render_alert_service() {
  cat <<EOF
[Unit]
Description=Luna failure pager (${CHAT_SERVER_NAME})

[Service]
Type=oneshot
Environment=LUNA_HOME=${LUNA_HOME}
EnvironmentFile=-${LUNA_HOME}/pager.env
ExecStart=${REPO_DIR}/scripts/luna-pager ${CHAT_SERVER_NAME}
EOF
}

write_alert_service() {
  if [[ "$DRY_RUN" == true ]]; then
    printf 'Would write %s:\n' "$ALERT_SERVICE_FILE"
    render_alert_service
    return 0
  fi
  mkdir -p "$SERVICE_DIR"
  render_alert_service > "$ALERT_SERVICE_FILE"
}

luna_info "Installing Luna server profile: $PROFILE"
printf 'Repo: %s\n' "$REPO_DIR"
printf 'State: %s\n' "$LUNA_HOME"
printf 'Service: %s\n' "$SERVICE_FILE"

if [[ "$DRY_RUN" == false ]]; then
  [[ -d "$REPO_DIR/.git" ]] || luna_die "$REPO_DIR is not a git clone"
fi

if [[ "$UNITS_ONLY" == false ]] && { ! luna_env_has_token "$ENV_FILE" || [[ "$ROTATE_TOKEN" == true ]]; }; then
  [[ -n "$TOKEN" ]] ||
    luna_die "UI_WS_TOKEN is required. Pass --token, set UI_WS_TOKEN, or create $ENV_FILE before installing."
fi

install_deps
BUN_BIN="$(luna_find_bun)"

if [[ "$DRY_RUN" == false ]]; then
  [[ -x "$BUN_BIN" ]] || luna_die "Bun not found at $BUN_BIN"
fi

if [[ "$UNITS_ONLY" == false ]]; then
luna_run mkdir -p "$LUNA_HOME" "$LUNA_HOME/claude" "$LUNA_HOME/logs" "$LUNA_HOME/run"
# Harden the Claude OAuth credential dir: owner-only (700). It holds the
# high-value Claude.ai subscription token, so deny group/other entirely.
luna_run chmod 700 "$LUNA_HOME/claude"

luna_upsert_env "$ENV_FILE" "CLAUDE_CONFIG_DIR" "$LUNA_HOME/claude"
luna_upsert_env "$ENV_FILE" "LUNA_REPO_ROOT" "$REPO_DIR"
luna_upsert_env "$ENV_FILE" "LUNA_UI_WS_HOST" "$BIND_HOST"
luna_upsert_env "$ENV_FILE" "LUNA_PROFILE" "$PROFILE"
luna_upsert_env "$ENV_FILE" "LUNA_CHAT_SERVER_NAME" "$CHAT_SERVER_NAME"
luna_upsert_env "$ENV_FILE" "LUNA_HOME" "$LUNA_HOME"
luna_upsert_env "$ENV_FILE" "LUNA_DB_PATH" "$LUNA_HOME/luna.db"
luna_upsert_env "$ENV_FILE" "LUNA_MEMORY_DB" "$LUNA_HOME/memory.db"
luna_upsert_env "$ENV_FILE" "LUNA_ANALYTICS_DB_PATH" "$LUNA_HOME/analytics.duckdb"
luna_upsert_env "$ENV_FILE" "LUNA_EVENTS_JSONL_PATH" "$LUNA_HOME/events.jsonl"
luna_upsert_env "$ENV_FILE" "LUNA_EMBEDDER" "$EMBEDDER"
luna_upsert_env "$ENV_FILE" "LUNA_OLLAMA_BASE_URL" "$OLLAMA_BASE_URL"
luna_upsert_env "$ENV_FILE" "LUNA_OLLAMA_EMBED_MODEL" "$OLLAMA_EMBED_MODEL"
luna_upsert_env "$ENV_FILE" "LUNA_OLLAMA_EMBED_DIMENSION" "$OLLAMA_EMBED_DIMENSION"
luna_upsert_env "$ENV_FILE" "LUNA_OLLAMA_PROBE_TIMEOUT_MS" "$OLLAMA_PROBE_TIMEOUT_MS"
luna_upsert_env "$ENV_FILE" "LUNA_OLLAMA_PROBE_ATTEMPTS" "$OLLAMA_PROBE_ATTEMPTS"
luna_upsert_env "$ENV_FILE" "LUNA_OLLAMA_PROBE_BACKOFF_MS" "$OLLAMA_PROBE_BACKOFF_MS"

if luna_env_has_token "$ENV_FILE" && [[ "$ROTATE_TOKEN" == false ]]; then
  luna_info "Existing UI token found; preserving it"
else
  luna_upsert_env "$ENV_FILE" "UI_WS_TOKEN" "$TOKEN"
fi

# Durable Claude model auth: when a token was supplied, write it to .env (mode
# 600, gitignored) so the account can point at env:CLAUDE_CODE_OAUTH_TOKEN. The
# value is never printed; only the upsert helper writes it.
if [[ -n "$CLAUDE_TOKEN" ]]; then
  luna_upsert_env "$ENV_FILE" "CLAUDE_CODE_OAUTH_TOKEN" "$CLAUDE_TOKEN"
  luna_info "Durable Claude token written to .env (account will use env:CLAUDE_CODE_OAUTH_TOKEN)"
fi

if [[ "$SKIP_DEPS" == false ]]; then
  luna_run "$BUN_BIN" install --cwd "$REPO_DIR" --frozen-lockfile
fi

# Build the web SPA so chat-server serves it on :4753 (reachable via the existing
# tailnet proxy, no extra infra). Always run — SPA source changes without
# touching deps — and NOT gated by --skip-deps (that flag is apt/bun-install
# only). The guarded build refuses to bake VITE_UI_WS_TOKEN, which deploy never sets.
luna_run "$BUN_BIN" run --cwd "$REPO_DIR" --filter "@luna/ui-web" build

luna_configure_claude_executable "$ENV_FILE" "$REPO_DIR"

# Seed the default account so the server boots straight into NORMAL mode rather
# than setup-mode. Only when a durable token was supplied — otherwise leave the
# accounts table empty so first boot enters the interactive setup-mode login
# (which seeds claude-code:login). The token is passed via the subprocess ENV
# (not argv) and only the POINTER ref is ever written/printed. Non-fatal.
if [[ -n "$CLAUDE_TOKEN" && "$DRY_RUN" == false ]]; then
  if ( cd "$REPO_DIR" && CLAUDE_CODE_OAUTH_TOKEN="$CLAUDE_TOKEN" LUNA_DB_PATH="$LUNA_HOME/luna.db" \
        "$BUN_BIN" run apps/ui-web/scripts/seed-default-account.ts "$LUNA_HOME/luna.db" ); then
    :
  else
    luna_warn "default-account seed failed — server may start in setup-mode; re-run apps/ui-web/scripts/seed-default-account.ts after install"
  fi
elif [[ -n "$CLAUDE_TOKEN" ]]; then
  luna_info "[dry-run] would seed default account (secret_ref=env:CLAUDE_CODE_OAUTH_TOKEN)"
fi
fi

# Version-skew guard: the unit rendered above demands READY=1 (Type=notify),
# which only S1+ code sends. Re-rendering the unit against an older checkout
# (or after a rollback across the S1 boundary) turns the rollback safety net
# into an unpaged activating→timeout→restart spiral. Warn loudly; the runbook
# ordering is: deploy + verify the code FIRST, then re-run this installer.
if [[ ! -f "$REPO_DIR/apps/ui-web/scripts/sd-notify.ts" ]]; then
  luna_warn "checkout at $REPO_DIR lacks apps/ui-web/scripts/sd-notify.ts — the Type=notify unit will start-timeout against this code; update the checkout BEFORE restarting the service"
fi

write_service "$BUN_BIN"
write_alert_service

# Pager secret file: create ATOMICALLY with owner-only perms if absent (umask
# in a subshell — no world-readable window between create and chmod), and
# enforce 0600 on a pre-existing file (the operator writes
# TELEGRAM_PAGER_TOKEN/LUNA_PAGER_CHAT_ID by hand later). Units-only is a
# strict supervisor reconciliation path and never mutates state.
if [[ "$UNITS_ONLY" == true ]]; then
  :
elif [[ "$DRY_RUN" == false ]]; then
  if [[ ! -f "$LUNA_HOME/pager.env" ]]; then
    ( umask 077; printf '# TELEGRAM_PAGER_TOKEN=\n# LUNA_PAGER_CHAT_ID=\n' > "$LUNA_HOME/pager.env" )
  else
    chmod 600 "$LUNA_HOME/pager.env"
  fi
else
  luna_run touch "$LUNA_HOME/pager.env"
  luna_run chmod 600 "$LUNA_HOME/pager.env"
fi

if [[ "$DRY_RUN" == false ]]; then
  systemctl daemon-reload
  if [[ "$ENABLE_SERVICE" == true ]]; then
    systemctl enable "$SERVICE_NAME"
  fi
  if [[ "$START_SERVICE" == true ]]; then
    systemctl restart "$SERVICE_NAME"
  fi
else
  luna_run systemctl daemon-reload
  [[ "$ENABLE_SERVICE" == false ]] || luna_run systemctl enable "$SERVICE_NAME"
  [[ "$START_SERVICE" == false ]] || luna_run systemctl restart "$SERVICE_NAME"
fi

luna_info "Luna server install complete"
