#!/usr/bin/env bash
# Independent host control plane for Luna. systemd owns fast liveness; this
# timer-driven oneshot owns deep health, evidence capture, repair, and updates.
set -euo pipefail

SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
SCRIPT_DIR="$(dirname "$SELF")"
source "$SCRIPT_DIR/lib/luna-deploy.sh"
source "$SCRIPT_DIR/lib/luna-registry.sh"

PIN_BASE="${LUNA_GUARDIAN_PIN_BASE:-/usr/local/lib/luna-guardian}"
STATE_DIR="${LUNA_GUARDIAN_STATE_DIR:-/var/lib/luna-guardian}"
SYSTEMD_DIR="${LUNA_TEST_SYSTEMD_DIR:-/etc/systemd/system}"

# Deep-health debounce journal, loaded by health_journal_read.
HJ_NEGATIVE=0
HJ_NEGATIVE_AT=0
HJ_UNKNOWN=0
HJ_LAST_REPAIR=0

load_profile() {
  luna_load_server "$1"
  [[ -n "$P_SERVICE_NAME" ]] || luna_die "profile '$1' has no service name"
}

run_runtime() {
  if [[ -n "$P_INCUS" ]]; then incus exec "$P_INCUS" -- "$@"; else "$@"; fi
}

redact() {
  sed -E \
    -e 's#bot[0-9]+:[A-Za-z0-9_-]+#bot<redacted>#g' \
    -e 's#([?&](token|access_token|api_key)=)[^&[:space:]]+#\1<redacted>#g' \
    -e 's#([A-Za-z0-9_]*(TOKEN|SECRET|PASSWORD|API_KEY)[A-Za-z0-9_]*[=:][[:space:]]*)[^[:space:]]+#\1<redacted>#gI'
}

diagnose() {
  local profile="$1" dir stamp out tmp runtime_repo
  load_profile "$profile"
  runtime_repo="$P_REPO"
  [[ -z "$P_INCUS" ]] || runtime_repo="/root/luna"
  dir="$STATE_DIR/incidents/$profile"
  mkdir -p "$dir"; chmod 700 "$STATE_DIR" "$STATE_DIR/incidents" "$dir" 2>/dev/null || true
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"; out="$dir/$stamp.txt"; tmp="$out.tmp.$$"
  {
    printf 'profile=%s\ncaptured_at=%s\nrepo=%s\ncontainer=%s\nunit=%s\n' \
      "$profile" "$stamp" "$P_REPO" "$P_INCUS" "$P_SERVICE_NAME"
    printf '\n[git]\n'; git -C "$P_REPO" status --short --branch 2>&1 || true
    git -C "$P_REPO" rev-parse HEAD 2>&1 || true
    printf '\n[unit]\n'; run_runtime systemctl show "$P_SERVICE_NAME" \
      -p ActiveState -p SubState -p Result -p Type -p WatchdogUSec \
      -p NRestarts -p ExecMainStatus --no-pager 2>&1 || true
    printf '\n[ready]\n'; run_runtime curl -fsS --max-time 4 \
      "http://127.0.0.1:$P_PORT/readyz" 2>&1 || true
    printf '\n[capacity]\n'; run_runtime df -h "$runtime_repo" 2>&1 || true
    if [[ "$P_LAYOUT" == "releases" ]]; then
      # Releases-layout evidence: where current/previous point, whether the
      # resolved release is complete, the mirror's branch tip, and deploy-root
      # capacity — the four questions a 3am responder asks first.
      printf '\n[releases]\n'
      printf 'current -> %s\n' "$(readlink "$P_DEPLOY_ROOT/current" 2>/dev/null || printf '<unreadable>')"
      printf 'previous -> %s\n' "$(readlink "$P_DEPLOY_ROOT/previous" 2>/dev/null || printf '<unreadable>')"
      local _cur_phys
      _cur_phys="$(cd -P "$P_DEPLOY_ROOT/current" 2>/dev/null && pwd || true)"
      printf 'resolved sha: %s\n' "${_cur_phys##*/}"
      if [[ -n "$_cur_phys" && -f "$_cur_phys/.complete" ]]; then
        printf '.complete: present\n'
      else
        printf '.complete: MISSING\n'
      fi
      printf 'mirror origin/%s: %s\n' "$P_BRANCH" \
        "$(git --git-dir "$P_DEPLOY_ROOT/mirror.git" rev-parse "origin/$P_BRANCH" 2>&1 || true)"
      df -h "$P_DEPLOY_ROOT" 2>&1 || true
    fi
    printf '\n[journal]\n'; run_runtime journalctl -u "$P_SERVICE_NAME" \
      --no-pager -n 80 2>&1 || true
  } | redact > "$tmp"
  # diagnose usually runs inside $(...) in luna_warn arguments (errexit is
  # suspended there), so a failed capture must be visible IN THE PAGE TEXT: a
  # dead-obvious marker instead of a path to a file that does not exist.
  chmod 600 "$tmp" 2>/dev/null || true
  if ! mv "$tmp" "$out" || [[ ! -s "$out" ]]; then
    rm -f "$tmp" 2>/dev/null || true
    printf 'INCIDENT-CAPTURE-FAILED'
    return 1
  fi
  printf '%s\n' "$out"
}

# Classified deep-health probe. Exit codes are luna_runtime_matches_checkout's:
#   0 HEALTHY, 1 NEGATIVE (the server answered and the answer was wrong),
#   3 INCONCLUSIVE (no usable answer).
#
# A NEGATIVE at check_profile can escalate to `luna-autodeploy --repair`, which
# tries a plain guarded unit restart before a full rebuild and defers+pages
# when the engine's in-primitive session guard reports live/unknown sessions —
# it never drops the operator mid-conversation. A single INCONCLUSIVE must
# still never reach that path (only an unbroken run of them, see
# check_profile), and is re-probed once here because a wedged incus exec or a
# 4s curl timeout is the single most common transient. A NEGATIVE returns
# immediately: a genuine build mismatch must not pay for the transient budget.
#
# All other callers treat any non-zero as "not proven", exactly as before.
runtime_health() {
  local rc=0
  luna_runtime_matches_checkout "$P_REPO" "$P_PORT" "$P_INCUS" "$P_SERVICE_NAME" || rc=$?
  # The test seam is deterministic, so re-probing it only wastes time.
  if (( rc == 3 )) && [[ "${LUNA_TEST_RUNTIME_MATCHES_CHECKOUT+set}" != "set" ]]; then
    sleep "${LUNA_GUARDIAN_HEALTH_RETRY_DELAY:-5}"
    rc=0
    luna_runtime_matches_checkout "$P_REPO" "$P_PORT" "$P_INCUS" "$P_SERVICE_NAME" || rc=$?
    if (( rc == 0 )); then luna_warn "runtime health recovered on re-probe"; fi
  fi
  return "$rc"
}

# Post-repair verification. A forced restart guarantees the server is booting,
# so the first probes are expected to be INCONCLUSIVE; poll to a deadline rather
# than reading boot latency as a failed repair (which pages and writes a second
# incident file). Returns the last probe's code.
wait_runtime_healthy() {
  local deadline rc=0 started now
  deadline="${LUNA_GUARDIAN_REPAIR_VERIFY_SEC:-60}"
  if [[ ! "$deadline" =~ ^[0-9]+$ ]]; then deadline=60; fi
  if [[ "${LUNA_TEST_RUNTIME_MATCHES_CHECKOUT+set}" == "set" ]]; then
    runtime_health || rc=$?
    return "$rc"
  fi
  started="$(date +%s)"
  while :; do
    rc=0
    runtime_health || rc=$?
    if (( rc == 0 )); then return 0; fi
    now="$(date +%s)"
    if (( now < started || now - started >= deadline )); then return "$rc"; fi
    sleep "${LUNA_GUARDIAN_HEALTH_RETRY_DELAY:-5}"
  done
}

unit_hardened() {
  local type watchdog
  if [[ "${LUNA_TEST_GUARDIAN_UNIT_HARDENED+set}" == "set" ]]; then
    [[ "$LUNA_TEST_GUARDIAN_UNIT_HARDENED" == "true" ]]
    return
  fi
  type="$(run_runtime systemctl show "$P_SERVICE_NAME" -p Type --value 2>/dev/null || true)"
  watchdog="$(run_runtime systemctl show "$P_SERVICE_NAME" -p WatchdogUSec --value 2>/dev/null || true)"
  [[ "$type" == notify && -n "$watchdog" && "$watchdog" != 0 && "$watchdog" != 0us ]]
}

host_unit_property() {
  systemctl show "$1" -p "$2" --value 2>/dev/null || true
}

installed_engine_sha() {
  local profile="$1" dir
  dir="$(cd -P "$PIN_BASE/current-$profile" 2>/dev/null && pwd)" || return 1
  [[ "${dir##*/}" == engine@* ]] || return 1
  printf '%s' "${dir##*/engine@}"
}

guardian_engine_matches_checkout() {
  local profile="$1" repo_sha engine_sha
  repo_sha="$(git -C "$P_REPO" rev-parse HEAD 2>/dev/null)" || return 1
  engine_sha="$(installed_engine_sha "$profile" 2>/dev/null)" || return 1
  [[ "$repo_sha" == "$engine_sha" ]]
}

guardian_control_plane_adopted() {
  local profile="$1"
  local guardian="luna-guardian-$profile.timer" legacy="luna-autodeploy-$profile.timer"
  [[ "$(host_unit_property "$guardian" LoadState)" == "loaded" ]] &&
    [[ "$(host_unit_property "$guardian" UnitFileState)" == "enabled" ]] &&
    [[ "$(host_unit_property "$guardian" ActiveState)" == "active" ]] &&
    [[ "$(host_unit_property "$legacy" LoadState)" == "not-found" ]] &&
    [[ "$(host_unit_property "$legacy" UnitFileState)" != "enabled" ]] &&
    [[ "$(host_unit_property "$legacy" ActiveState)" != "active" ]]
}

status_value() {
  local file="$1" key="$2"
  [[ -r "$file" ]] || return 1
  sed -n "s/^${key}=//p" "$file" | head -1
}

# Returns non-zero when the record could not be durably written — the same
# contract as health_journal_write. Callers MUST check (with a non-fatal warn):
# the status file is the release-acceptance heartbeat, and a silently no-opped
# write would let accept_profile attest stale evidence while every tick claims
# success. It cannot be `set -e`'s job: run_check's whole dynamic extent runs
# errexit-suspended (see health_journal_write's note).
write_guardian_status() {
  local profile="$1" outcome="$2" proof="${3:-false}" file tmp repo_sha engine_sha now previous_sha previous_outcome previous_count count=0
  local previous_runtime runtime_count=0
  file="$STATE_DIR/status-$profile"; tmp="$file.tmp.$$"
  mkdir -p "$STATE_DIR" || return 1
  chmod 700 "$STATE_DIR" 2>/dev/null || true
  repo_sha="$(git -C "$P_REPO" rev-parse HEAD 2>/dev/null || true)"
  engine_sha="$(installed_engine_sha "$profile" 2>/dev/null || true)"
  now="$(date +%s)"
  previous_sha="$(status_value "$file" repo_sha 2>/dev/null || true)"
  previous_outcome="$(status_value "$file" outcome 2>/dev/null || true)"
  previous_count="$(status_value "$file" consecutive_healthy 2>/dev/null || true)"
  if [[ "$outcome" == "healthy" && "$repo_sha" == "$engine_sha" ]]; then
    if [[ "$previous_outcome" == "healthy" && "$previous_sha" == "$repo_sha" && "$previous_count" =~ ^[0-9]+$ ]]; then
      count=$((previous_count + 1))
    else
      count=1
    fi
  fi
  # consecutive_runtime_healthy: the accept-grade promotion evidence. Counted
  # at the CHECKOUT sha, independent of engine match, so it ACCRUES during the
  # outcome=deferred window a new deploy sits in while the engine pin lags —
  # the strict consecutive_healthy above is structurally 0 there (repo_sha !=
  # engine_sha), which is exactly the bootstrap deadlock this key resolves.
  # Per-sha reset comes free from the stored repo_sha: a new HEAD restarts the
  # streak at 1; an unproven tick (proof=false) resets it to 0.
  previous_runtime="$(status_value "$file" consecutive_runtime_healthy 2>/dev/null || true)"
  if [[ "$proof" == true ]]; then
    if [[ "$previous_sha" == "$repo_sha" && "$previous_runtime" =~ ^[0-9]+$ ]]; then
      runtime_count=$((previous_runtime + 1))
    else
      runtime_count=1
    fi
  fi
  if ! ( umask 077; printf 'profile=%s\ncompleted_at=%s\nrepo_sha=%s\nengine_sha=%s\noutcome=%s\nconsecutive_healthy=%s\nconsecutive_runtime_healthy=%s\n' \
      "$profile" "$now" "$repo_sha" "$engine_sha" "$outcome" "$count" "$runtime_count" > "$tmp" ); then
    rm -f "$tmp" 2>/dev/null || true
    return 1
  fi
  if ! mv "$tmp" "$file"; then
    rm -f "$tmp" 2>/dev/null || true
    return 1
  fi
}

# ── deep-health debounce journal ─────────────────────────────────────────────
# Each `luna-guardian check` is a separate systemd oneshot process, so the
# strike counters that debounce the destructive repair path cannot live in
# memory. $STATE_DIR is the existing durable 0700 location (the pinned unit
# exports LUNA_GUARDIAN_STATE_DIR) and status_value() already parses key=value.
#
# This file is a cache of EVIDENCE, never a source of authority: any missing,
# unreadable, malformed, stale or SHA-mismatched record reads as all-zero, which
# can only make the guardian more conservative, never less. The one exception is
# last_repair_at, which is honoured unconditionally so that a deploy performed by
# the repair itself cannot disarm the anti-flap cooldown.
health_journal_path() { printf '%s/health-%s' "$STATE_DIR" "$1"; }

# health_journal_read <profile> — populates HJ_NEGATIVE, HJ_NEGATIVE_AT,
# HJ_UNKNOWN, HJ_LAST_REPAIR. Always succeeds. Must be called before
# health_journal_write.
health_journal_read() {
  local profile="$1" file window now repo_sha updated stored_sha raw negative_at=0
  file="$(health_journal_path "$profile")"
  HJ_NEGATIVE=0; HJ_NEGATIVE_AT=0; HJ_UNKNOWN=0; HJ_LAST_REPAIR=0
  window="${LUNA_GUARDIAN_HEALTH_WINDOW_SEC:-900}"
  if [[ ! "$window" =~ ^[0-9]+$ ]]; then window=900; fi
  now="$(date +%s)"

  raw="$(status_value "$file" last_repair_at 2>/dev/null || true)"
  if [[ "$raw" =~ ^[0-9]+$ ]]; then HJ_LAST_REPAIR="$raw"; fi

  repo_sha="$(git -C "$P_REPO" rev-parse HEAD 2>/dev/null || true)"
  updated="$(status_value "$file" updated_at 2>/dev/null || true)"
  stored_sha="$(status_value "$file" repo_sha 2>/dev/null || true)"
  # A new HEAD changes the question being asked, so prior readings are not
  # evidence. A stale or clock-skewed record ages the strikes out.
  [[ -n "$repo_sha" && "$stored_sha" == "$repo_sha" ]] || return 0
  [[ "$updated" =~ ^[0-9]+$ ]] || return 0
  if (( now < updated || now - updated > window )); then return 0; fi

  raw="$(status_value "$file" consecutive_unknown 2>/dev/null || true)"
  if [[ "$raw" =~ ^[0-9]+$ ]]; then HJ_UNKNOWN="$raw"; fi

  # The negative streak ages against negative_at — the time of the last NEGATIVE
  # reading — and NOT against updated_at. Every tick rewrites updated_at, and an
  # INCONCLUSIVE tick carries the streak forward, so measuring freshness from
  # the last write would turn "K consecutive within the window" into "K ever":
  # two blips today plus one blip hours later would force a restart. A journal
  # with no negative_at (written by an older engine) reads as no evidence.
  raw="$(status_value "$file" negative_at 2>/dev/null || true)"
  if [[ "$raw" =~ ^[0-9]+$ ]]; then negative_at="$raw"; fi
  (( negative_at > 0 && now >= negative_at && now - negative_at <= window )) || return 0
  raw="$(status_value "$file" consecutive_negative 2>/dev/null || true)"
  if [[ "$raw" =~ ^[0-9]+$ ]]; then HJ_NEGATIVE="$raw"; HJ_NEGATIVE_AT="$negative_at"; fi
  return 0
}

# health_journal_write <profile> <negatives> <unknowns> [last_repair_at] [negative_at]
# Omitting a trailing argument carries the current value forward. The HJ_*
# globals are updated to what was written, so a later carry-forward write in the
# same process cannot resurrect a superseded value.
#
# Returns non-zero when the record could not be durably written (ENOSPC, a
# read-only $STATE_DIR). Callers MUST check: a silently no-op journal makes the
# debounce read all-zero on every tick, which either paralyses escalation or —
# far worse — leaves the anti-flap cooldown unarmed, turning the destructive
# branch into a forced rebuild every single tick. It cannot be `set -e`'s job:
# run_check invokes check_profile from an `if` condition, which suspends -e for
# the whole dynamic extent.
health_journal_write() {
  local profile="$1" negatives="$2" unknowns="$3" last="${4:-$HJ_LAST_REPAIR}" negative_at="${5:-$HJ_NEGATIVE_AT}"
  local file tmp now repo_sha
  file="$(health_journal_path "$profile")"; tmp="$file.tmp.$$"
  mkdir -p "$STATE_DIR" || return 1
  chmod 700 "$STATE_DIR" 2>/dev/null || true
  now="$(date +%s)"
  repo_sha="$(git -C "$P_REPO" rev-parse HEAD 2>/dev/null || true)"
  if ! ( umask 077; printf 'profile=%s\nupdated_at=%s\nrepo_sha=%s\nconsecutive_negative=%s\nnegative_at=%s\nconsecutive_unknown=%s\nlast_repair_at=%s\n' \
      "$profile" "$now" "$repo_sha" "$negatives" "$negative_at" "$unknowns" "$last" > "$tmp" ); then
    rm -f "$tmp" 2>/dev/null || true
    return 1
  fi
  if ! mv "$tmp" "$file"; then
    rm -f "$tmp" 2>/dev/null || true
    return 1
  fi
  HJ_NEGATIVE="$negatives"; HJ_UNKNOWN="$unknowns"
  HJ_LAST_REPAIR="$last"; HJ_NEGATIVE_AT="$negative_at"
}

# health_journal_zero_recorded <profile> — pure read: true iff the STORED record
# already says all-zero strikes and its last_repair_at matches what this tick
# would carry forward, so an all-zero write would change nothing. Deliberately
# reads the RAW file (status_value), NOT the validated HJ_* view: a stored
# NONZERO strike under an older sha must still be overwritten by zeros, or a
# rollback inside the freshness window would resurrect it. An absent file counts
# as all-zero (healthy ticks never create it). A stale updated_at on an all-zero
# record is harmless: freshness only ages NONZERO strikes.
health_journal_zero_recorded() {
  local profile="$1" file raw stored_last=0
  file="$(health_journal_path "$profile")"
  raw="$(status_value "$file" consecutive_negative 2>/dev/null || true)"
  [[ -z "$raw" || "$raw" == 0 ]] || return 1
  raw="$(status_value "$file" consecutive_unknown 2>/dev/null || true)"
  [[ -z "$raw" || "$raw" == 0 ]] || return 1
  raw="$(status_value "$file" negative_at 2>/dev/null || true)"
  [[ -z "$raw" || "$raw" == 0 ]] || return 1
  raw="$(status_value "$file" last_repair_at 2>/dev/null || true)"
  if [[ "$raw" =~ ^[0-9]+$ ]]; then stored_last="$raw"; fi
  [[ "$stored_last" == "$HJ_LAST_REPAIR" ]]
}

# Guardian installation and the deploy transaction both read executable files
# from the mutable checkout. Share the updater's mkdir-lock protocol so a manual
# deploy cannot start between the runtime trust proof and immutable pin
# publication (and Guardian cannot copy a half-applied checkout).
GUARDIAN_UPDATE_LOCK=""
GUARDIAN_UPDATE_LOCK_HELD=false

guardian_process_fingerprint() {
  local pid="$1"
  if [[ -r "/proc/$pid/stat" ]]; then
    sed 's/^.*) //' "/proc/$pid/stat" 2>/dev/null | awk '{print $20}'
  else
    ps -p "$pid" -o lstart= 2>/dev/null | tr -d '\n'
  fi
}

guardian_update_lock_owner_alive() {
  local lock="$1" pid fingerprint current
  [[ -r "$lock/owner" ]] || return 1
  pid="$(sed -n 's/^pid=//p' "$lock/owner" | head -1)"
  fingerprint="$(sed -n 's/^fingerprint=//p' "$lock/owner" | head -1)"
  [[ "$pid" =~ ^[0-9]+$ && -n "$fingerprint" ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  current="$(guardian_process_fingerprint "$pid")"
  [[ -n "$current" && "$current" == "$fingerprint" ]]
}

release_guardian_update_lock() {
  if [[ "$GUARDIAN_UPDATE_LOCK_HELD" == true ]]; then
    rm -rf "$GUARDIAN_UPDATE_LOCK" 2>/dev/null || true
    GUARDIAN_UPDATE_LOCK_HELD=false
  fi
}

acquire_guardian_update_lock() {
  local profile="$1" update_state lock fingerprint
  update_state="${LUNA_UPDATE_STATE_DIR:-${LUNA_HOME:-${HOME:-/root}/.luna}/update}"
  lock="$update_state/lock-$profile"
  mkdir -p "$update_state"; chmod 700 "$update_state" 2>/dev/null || true
  if ! mkdir "$lock" 2>/dev/null; then
    if guardian_update_lock_owner_alive "$lock"; then
      luna_warn "DEFERRED: update lock is held for profile '$profile'; guardian pin unchanged"
      return 10
    fi
    luna_warn "removing stale update lock for profile '$profile'"
    rm -rf "$lock"
    mkdir "$lock" || return 10
  fi
  fingerprint="$(guardian_process_fingerprint "$$")"
  [[ -n "$fingerprint" ]] || { rm -rf "$lock"; return 10; }
  ( umask 077; printf 'pid=%s\nfingerprint=%s\n' "$$" "$fingerprint" > "$lock/owner" )
  # Reader-shape re-verify of our own ownership record (implies -s, and catches
  # a partial pid-without-fingerprint write): an unwitnessable claim would be
  # classified stale and STOLEN mid-critical-section by another contender. This
  # function already runs errexit-suspended (`|| lock_rc=$?` at the call site),
  # so the explicit check is load-bearing.
  if ! guardian_update_lock_owner_alive "$lock"; then
    rm -rf "$lock"
    luna_warn "cannot record update-lock ownership for profile '$profile'; treating as contention"
    return 10
  fi
  GUARDIAN_UPDATE_LOCK="$lock"
  GUARDIAN_UPDATE_LOCK_HELD=true
  trap release_guardian_update_lock EXIT INT TERM
}

refresh_guardian_if_needed() {
  local profile="$1" repo_sha engine_dir engine_sha candidate rc=0 pinned min se_rc=0 stored_sha window pending_count
  repo_sha="$(git -C "$P_REPO" rev-parse HEAD 2>/dev/null)" || return 1
  engine_dir="$(cd -P "$SCRIPT_DIR" 2>/dev/null && pwd)" || return 1
  engine_sha="${engine_dir##*/engine@}"
  [[ "$engine_sha" != "$engine_dir" && "$engine_sha" == "$repo_sha" ]] && return 0

  # The mutable checkout is trusted only after runtime_health proved that this
  # exact HEAD is the normal, serving build. Installation creates a new
  # immutable engine directory and atomically flips the profile symlink; this
  # running process keeps its old files until it exits.
  candidate="$P_REPO/scripts/luna-guardian"
  if [[ ! -x "$candidate" ]] || ! bash -n "$candidate"; then
    luna_warn "healthy repo cannot refresh guardian: invalid $candidate"
    return 1
  fi
  # ── accept-grade promotion gate ────────────────────────────────────────────
  # A single runtime_health probe used to be enough for the supervisor to
  # advance its OWN engine pin — one probe, self-promotion. The pin may now
  # only advance to a sha with accept-grade stored evidence: >= min proven
  # cycles (consecutive_runtime_healthy, written by the every-tick heartbeat
  # at the CHECKOUT sha, so it accrues while the pin lags) verified through
  # guardian_status_evidence — the same code path `accept` uses.
  #
  # The gate applies ONLY when an existing pin would be REPLACED by a
  # different sha ([[ -n pinned && pinned != repo_sha ]]):
  #   - pinned empty  = bootstrap/first install: there is no working pin to
  #     keep, so gating would only delay protection — ungated.
  #   - pinned == repo_sha = nothing is advancing: fall through so a
  #     checkout-run converged check hits install_guardian's converged
  #     fast-path no-op exactly as before.
  # A deferred gate returns 0: the CURRENT pin keeps working (this tick's own
  # runtime_health already passed at the call site), and evidence accrues via
  # the heartbeat — starvation-free by construction. Repairs are structurally
  # unaffected: check_profile runs the repair ladder BEFORE its post-repair
  # call into this function, so the gate can only defer the pin advance that
  # FOLLOWS a repair, never the repair itself.
  #
  # LUNA_GUARDIAN_PROMOTE_MIN_CYCLES: 0 disables the gate (operator escape
  # hatch — also the escape from the documented limitation that a timer
  # cadence LONGER than LUNA_GUARDIAN_HEALTH_WINDOW_SEC (default 900s) reads
  # every stored heartbeat as stale and quietly starves auto-promotion;
  # `install` by hand is the other escape). Otherwise 2..10, default/fallback
  # 2 (accept parity).
  pinned="$(installed_engine_sha "$profile" 2>/dev/null || true)"
  if [[ -n "$pinned" && "$pinned" != "$repo_sha" ]]; then
    min="${LUNA_GUARDIAN_PROMOTE_MIN_CYCLES:-2}"
    if [[ "$min" != "0" ]]; then
      if [[ "$min" =~ ^[0-9]+$ ]] && (( 10#$min >= 2 && 10#$min <= 10 )); then
        min=$((10#$min))
      else
        min=2
      fi
      # Freshness window: same validation discipline as health_journal_read —
      # non-numeric values (e.g. a systemd-style "15m") fall back to 900
      # instead of poisoning the arithmetic freshness test, and 0 (under which
      # every heartbeat, always ~cadence seconds old, reads as stale) is
      # treated as invalid too. Either would otherwise starve auto-promotion
      # permanently and silently.
      window="${LUNA_GUARDIAN_HEALTH_WINDOW_SEC:-900}"
      if [[ ! "$window" =~ ^[0-9]+$ ]] || (( 10#$window == 0 )); then window=900; fi
      se_rc=0
      guardian_status_evidence "$profile" "$repo_sha" "$min" consecutive_runtime_healthy \
        "$window" no || se_rc=$?
      if (( se_rc != 0 )); then
        # One log line per STATE CHANGE, not per tick (phase-3 rule): the
        # stored repo_sha differs from the candidate exactly on the first tick
        # a new candidate appears — the gate runs before this tick's status
        # write, and every later tick (including a mid-accumulation
        # proof=false blip) stores repo_sha=candidate and stays silent.
        stored_sha="$(status_value "$STATE_DIR/status-$profile" repo_sha 2>/dev/null || true)"
        if [[ "$stored_sha" != "$repo_sha" ]]; then
          # se_rc=1 means the stored record does not attest the candidate:
          # SE_COUNT still holds the PREVIOUS sha's counter (guardian_status_
          # evidence reads it before the sha check), so the candidate's proven
          # count is structurally 0 — printing the stale counter here would
          # tell the operator "57/2 proven cycles" while deferring.
          pending_count="${SE_COUNT:-0}"
          if (( se_rc == 1 )); then pending_count=0; fi
          luna_warn "guardian engine promotion pending: ${pinned:0:12} -> ${repo_sha:0:12} (${pending_count}/$min proven cycles)"
        fi
        return 0
      fi
    fi
  fi
  luna_warn "advancing guardian engine ${engine_sha:0:12} -> ${repo_sha:0:12}${SE_COUNT:+ (${SE_COUNT} proven cycles)}"
  # Pass the current cadence through: `install` defaults --interval to 1min, so
  # a bare install here would silently reset a custom timer cadence on every
  # engine advance — undoing the very preservation the check-tick drift gate
  # provides. guardian_timer_interval prefers the durable desired-interval
  # record and falls back to the installed timer, then 1min.
  "$candidate" install "$profile" --interval "$(guardian_timer_interval "$profile")" || rc=$?
  if (( rc == 10 )); then
    luna_warn "guardian engine refresh deferred by update transaction/lock"
    return 0
  fi
  return "$rc"
}

update_then_refresh() {
  local profile="$1" update="$2" rc=0; shift 2
  "$update" "$profile" "$@" || rc=$?
  # autodeploy exit 1 recovered a bad forward commit by rolling back; exit >=2
  # means the rollback itself failed. Only an unrecoverable failure pages.
  if (( rc >= 2 )); then return "$rc"; fi
  # A deferred update is also successful. Deep health prevents it from
  # promoting an unverified checkout or a build that does not match HEAD.
  if runtime_health; then refresh_guardian_if_needed "$profile"; return; fi
  return "$rc"
}

reconcile_unit_if_idle() {
  local profile="$1" n
  unit_hardened && return 0
  if ! n="$(luna_active_ws_count "$P_PORT" "$P_INCUS")"; then
    luna_warn "unit drift: session count unknown; deferring"; return 1
  fi
  if (( n > 0 )); then luna_warn "unit drift: $n active session(s); deferring"; return 1; fi
  luna_warn "reconciling supervisor unit before repair restart"
  # Releases layout: the installer must render THROUGH current and skip the
  # .git guard (--layout releases); in-container paths follow the bind-mounted
  # deploy root (LUNA_CONTAINER_DEPLOY_ROOT seam, default /root/luna).
  local _cdr="${LUNA_CONTAINER_DEPLOY_ROOT:-/root/luna}"
  if [[ -n "$P_INCUS" ]]; then
    if [[ "$P_LAYOUT" == "releases" ]]; then
      run_runtime "$_cdr/current/scripts/luna-server-install" --profile "$profile" \
        --repo-dir "$_cdr/current" --luna-home /root/.luna --units-only --no-enable --no-start --layout releases
    else
      run_runtime /root/luna/scripts/luna-server-install --profile "$profile" \
        --repo-dir /root/luna --luna-home /root/.luna --units-only --no-enable --no-start
    fi
  else
    if [[ "$P_LAYOUT" == "releases" ]]; then
      "$P_REPO/scripts/luna-server-install" --profile "$profile" \
        --repo-dir "$P_REPO" --units-only --no-enable --no-start --layout releases
    else
      "$P_REPO/scripts/luna-server-install" --profile "$profile" \
        --repo-dir "$P_REPO" --units-only --no-enable --no-start
    fi
  fi
}

check_profile() {
  local profile="$1" update="$SCRIPT_DIR/luna-autodeploy" cp_interval
  load_profile "$profile"
  [[ -x "$update" ]] || luna_die "pinned updater missing: $update"
  # Desired-vs-actual reconcile: repair only on drift, and preserve the timer's
  # installed cadence instead of resetting a custom --interval to 1min on every
  # repair. control_plane_units_current adds CONTENT drift (a truncated or
  # hand-edited unit) to the adoption-state checks. Residual: if the TIMER file
  # itself is the drifted artifact its cadence is unreadable, so the repair
  # renders the 1min default until the next explicit `install --interval`.
  cp_interval="$(guardian_timer_interval "$profile")"
  if ! guardian_control_plane_adopted "$profile" ||
     ! control_plane_units_current "$profile" "$cp_interval" "$PIN_BASE/current-$profile" ||
     ! control_plane_loaded_current "$profile"; then
    # Desired unit content embeds THIS invocation's STATE_DIR/PIN_BASE/LUNA_HOME.
    # The timer-driven tick inherits them from the unit itself, so it can never
    # disagree; only a manual run with debug overrides (LUNA_GUARDIAN_STATE_DIR=
    # /tmp/dbg ...) can. Such a run must not "repair" the live control plane to
    # point at its debug paths — that would disarm the real repair cooldown and
    # orphan the real status history. Refuse loudly; `install` remains the
    # deliberate way to change the recorded environment.
    if guardian_env_conflicts_with_installed "$profile"; then
      luna_warn "control-plane drift detected, but the installed service unit declares a different guardian environment (STATE_DIR/PIN_BASE/LUNA_HOME) than this invocation — refusing to rewrite the live control plane from a non-default environment; run 'luna-guardian install $profile' from the intended environment to change it deliberately"
    else
      luna_warn "control-plane drift detected; reconciling pinned guardian units"
      render_control_plane "$profile" "$cp_interval" "$PIN_BASE/current-$profile"
    fi
  fi
  local health_rc=0 strikes unknown_limit unknown_repair cooldown
  local negatives=0 unknowns=0 now elapsed rc=0 pager_rc=0 reason=""
  local write_negatives=0 write_unknowns=0 write_negative_at=0
  strikes="${LUNA_GUARDIAN_HEALTH_STRIKES:-3}"
  unknown_limit="${LUNA_GUARDIAN_HEALTH_UNKNOWN_LIMIT:-15}"
  unknown_repair="${LUNA_GUARDIAN_HEALTH_UNKNOWN_REPAIR_LIMIT:-30}"
  cooldown="${LUNA_GUARDIAN_REPAIR_COOLDOWN_SEC:-1800}"
  if [[ ! "$strikes" =~ ^[1-9][0-9]*$ ]]; then strikes=3; fi
  if [[ ! "$unknown_limit" =~ ^[1-9][0-9]*$ ]]; then unknown_limit=15; fi
  if [[ ! "$unknown_repair" =~ ^[1-9][0-9]*$ ]]; then unknown_repair=30; fi
  if [[ ! "$cooldown" =~ ^[0-9]+$ ]]; then cooldown=1800; fi
  health_journal_read "$profile"
  runtime_health || health_rc=$?
  now="$(date +%s)"
  if (( health_rc == 0 )); then
    : # counters stay at zero
  elif (( health_rc != 1 )); then
    # INCONCLUSIVE: we have no answer, so a single reading never repairs. The
    # negative streak is carried forward untouched; it ages out against
    # negative_at rather than against this write.
    unknowns=$(( HJ_UNKNOWN + 1 ))
    write_negatives="$HJ_NEGATIVE"; write_unknowns="$unknowns"; write_negative_at="$HJ_NEGATIVE_AT"
    if (( unknowns >= unknown_repair )); then
      # Sustained ignorance is not ignorance about a blip. A runtime that has
      # not produced one usable answer in $unknown_repair consecutive ticks
      # (a wedged event loop that holds the port open, a stopped container) is
      # evidence of a real outage, and a forced restart is the only thing that
      # recovers it. Still gated by the same cooldown as a NEGATIVE escalation.
      reason="deep health INCONCLUSIVE for $unknowns consecutive checks"
    else
      luna_warn "deep health INCONCLUSIVE ($unknowns consecutive); runtime state unknown — no repair"
      if (( unknowns % unknown_limit == 0 )); then
        # Page a human well before the repair threshold. Modulo, not >=, so a
        # wedged probe does not page on every subsequent tick.
        luna_warn "runtime state unknown for $unknowns consecutive checks; incident=$(diagnose "$profile")"
        pager_rc=2
      fi
    fi
  else
    negatives=$(( HJ_NEGATIVE + 1 ))
    write_negatives="$negatives"; write_unknowns=0; write_negative_at="$now"
    if (( negatives >= strikes )); then
      reason="deep health failed $negatives consecutive checks"
    else
      luna_warn "deep health NEGATIVE ($negatives/$strikes consecutive); deferring repair to the next tick"
    fi
  fi

  local escalate=false
  if [[ -n "$reason" ]]; then
    elapsed=$(( now - HJ_LAST_REPAIR ))
    if (( HJ_LAST_REPAIR > 0 && now < HJ_LAST_REPAIR )); then
      # The clock moved backwards. An unreadable clock is a reason to refuse the
      # destructive action, not a licence to skip the protection — the same
      # fail-safe choice health_journal_read makes for a future updated_at.
      luna_warn "$reason but last_repair_at is in the future (clock skew); refusing forced repair"
    elif (( HJ_LAST_REPAIR > 0 && elapsed < cooldown )); then
      # Anti-flap: a forced rebuild+restart that did not fix the runtime must
      # not be retried every tick. Repeating it is the restart loop this whole
      # change exists to prevent.
      luna_warn "$reason but a forced repair ran ${elapsed}s ago; suppressed for $(( cooldown - elapsed ))s"
    elif health_journal_write "$profile" 0 0 "$now" 0; then
      # Arm the cooldown and clear the streak BEFORE the destructive action, so
      # a crash or a failed repair cannot re-escalate on the next tick.
      escalate=true
      luna_warn "$reason; incident=$(diagnose "$profile")"
    else
      # Without a durable journal the restart rate cannot be bounded at all, so
      # forcing here would rebuild production on every tick. Refuse and page.
      luna_warn "cannot arm the repair cooldown in $(health_journal_path "$profile"); refusing forced repair"
      pager_rc=2
    fi
  fi
  if [[ "$escalate" != true ]]; then
    # Zero-skip lives at THIS call site only: the arming write (above) and the
    # post-repair write (below) are structurally unable to skip, so the phase-1
    # arm-before-act contract cannot be weakened even by a refactor of the write
    # function. A converged healthy tick writes nothing; a stored nonzero strike
    # always gets its explicit zero overwrite.
    if (( write_negatives == 0 && write_unknowns == 0 && write_negative_at == 0 )) &&
       health_journal_zero_recorded "$profile"; then
      : # already recorded as all-zero; rewriting would only churn updated_at
    else
      health_journal_write "$profile" "$write_negatives" "$write_unknowns" \
        "$HJ_LAST_REPAIR" "$write_negative_at" ||
        luna_warn "health journal write failed; deep-health debounce is not persisting"
    fi
  fi

  if ! unit_hardened; then
    # A server with live/unknown sessions stays untouched; the normal updater
    # below still runs, and its own fail-closed session guard defers.
    if reconcile_unit_if_idle "$profile"; then escalate=true; fi
  fi
  if [[ "$escalate" != true ]]; then
    # Everything short of an armed escalation still runs the gentle updater.
    # --from-timer has its own fail-closed active-session guard and never drops
    # the operator, and it is the only path that pulls fixes and advances the
    # guardian engine pin, so suppressing it on non-healthy ticks would freeze
    # both for as long as the probe stays flaky.
    update_then_refresh "$profile" "$update" --from-timer || rc=$?
    if (( pager_rc > rc )); then rc="$pager_rc"; fi
    return "$rc"
  fi
  # Armed escalation goes through the unattended repair ladder (--repair):
  # rung 1 plain guarded unit restart, rung 2 full rebuild of the current ref.
  # The engine's in-primitive session guard fails closed; rc=3 means
  # live/unknown sessions, so we PAGE (return 2 rides
  # OnFailure=luna-guardian-alert) instead of dropping the operator. rc=4 means
  # a CONCURRENT UPDATE holds the profile lock — no sessions were evaluated —
  # and must page with that reason, never masquerade as a session-guard defer.
  # Cooldown bounding is unchanged: last_repair_at was armed BEFORE
  # escalate=true, so the whole ladder — both rungs, any rollback, and every
  # deferred-page case — consumes one arming per cooldown window.
  local repair_rc=0
  "$update" "$profile" --repair || repair_rc=$?
  if (( repair_rc == 0 )) && wait_runtime_healthy && unit_hardened; then
    health_journal_write "$profile" 0 0 "$HJ_LAST_REPAIR" 0 ||
      luna_warn "health journal write failed after a successful repair"
    refresh_guardian_if_needed "$profile"
    return
  fi
  if (( repair_rc == 3 )); then
    luna_warn "repair DEFERRED by session guard — live or unknown sessions; paging instead of dropping the operator; incident=$(diagnose "$profile")"
    return 2
  fi
  if (( repair_rc == 4 )); then
    luna_warn "repair DEFERRED — a concurrent update holds the profile lock (update-lock contention; no session-guard defer occurred); paging for visibility; incident=$(diagnose "$profile")"
    return 2
  fi
  luna_warn "repair failed; incident=$(diagnose "$profile")"; return 2
}

run_check() {
  local profile="$1" rc=0 outcome proof=false
  load_profile "$profile"
  if [[ "$P_TIMER_ALLOWED" != "true" ]]; then
    # Converge, don't re-apply: once the units are gone, later ticks are silent.
    # The status heartbeat still writes every tick (outcome=disabled).
    if ! guardian_units_absent "$profile"; then
      luna_warn "deploy.timer=false; removing guardian units for profile '$profile'"
      uninstall_guardian "$profile"
    fi
    write_guardian_status "$profile" "disabled" false ||
      luna_warn "guardian status write failed for profile '$profile' ($STATE_DIR/status-$profile); heartbeat/consecutive_healthy attestation is not persisting"
    return 0
  fi
  if check_profile "$profile"; then
    # The probe trio, captured once: proof=true means this tick witnessed the
    # runtime serving the checkout HEAD from a hardened, adopted control plane
    # — regardless of whether the guardian's OWN engine pin has caught up yet.
    # outcome=healthy additionally requires the engine match, byte-identical
    # to the old truth table.
    if runtime_health && unit_hardened && guardian_control_plane_adopted "$profile"; then
      proof=true
    fi
    if [[ "$proof" == true ]] && guardian_engine_matches_checkout "$profile"; then
      outcome="healthy"
    else
      # Connected sessions may safely defer a unit restart. That is not a pager
      # failure, but it must not advance the release acceptance counter.
      outcome="deferred"
    fi
  else
    rc=$?; outcome="failed"
  fi
  write_guardian_status "$profile" "$outcome" "$proof" ||
    luna_warn "guardian status write failed for profile '$profile' ($STATE_DIR/status-$profile); heartbeat/consecutive_healthy attestation is not persisting"
  return "$rc"
}

# ── desired control-plane state (pure renderers) ─────────────────────────────
# Single source of truth for both the write path (guardian_unit_write) and the
# reconcile predicate (control_plane_units_current). Equality is compared as
# `[[ "$(cat file)" == "$(renderer)" ]]`: command substitution strips trailing
# newlines on BOTH sides and the writer emits exactly one final newline, so the
# comparison is byte-exact modulo trailing newlines — pre-phase-3 heredoc-written
# files compare equal to identical desired content (no rewrite storm), and ANY
# interior drift rewrites that one file.
desired_guardian_service() {
  local profile="$1" current="$2"
  local luna_home="${LUNA_HOME:-${HOME:-/root}/.luna}"
  cat <<EOF
[Unit]
Description=Luna guardian ($profile) - deep health, recovery, updates
After=network-online.target incus.service
Wants=network-online.target
OnFailure=luna-guardian-alert-$profile.service

[Service]
Type=oneshot
Environment=HOME=/root
Environment=LUNA_HOME=$luna_home
Environment=LUNA_GUARDIAN_STATE_DIR=$STATE_DIR
ExecStart=$current/luna-guardian check $profile
TimeoutStartSec=12min
EOF
}

desired_guardian_alert() {
  local profile="$1" current="$2"
  local luna_home="${LUNA_HOME:-${HOME:-/root}/.luna}"
  cat <<EOF
[Unit]
Description=Luna guardian failure pager ($profile)
[Service]
Type=oneshot
Environment=LUNA_HOME=$luna_home
EnvironmentFile=-$luna_home/pager.env
ExecStart=$current/luna-pager luna-guardian-$profile
EOF
}

desired_guardian_timer() {
  local profile="$1" interval="$2"
  cat <<EOF
[Unit]
Description=Luna guardian ($profile) timer
[Timer]
OnActiveSec=90s
OnUnitInactiveSec=$interval
AccuracySec=10s
Persistent=true
[Install]
WantedBy=timers.target
EOF
}

# guardian_unit_write <path> <content> — write only on difference, then verify.
# A no-op (content already current) writes nothing and stays silent; a real
# write is atomic (tmp + mv), re-read afterwards (the mutation must prove its
# effect), marks CP_UNITS_CHANGED so the caller reloads at most once, and logs
# exactly one line naming the unit that actually changed.
CP_UNITS_CHANGED=false
guardian_unit_write() {
  local path="$1" content="$2" tmp
  if [[ "$(cat "$path" 2>/dev/null)" == "$content" ]]; then return 0; fi
  tmp="$path.tmp.$$"
  if ! printf '%s\n' "$content" > "$tmp"; then
    rm -f "$tmp" 2>/dev/null || true
    luna_die "control plane: cannot write $path"
  fi
  if ! mv "$tmp" "$path"; then
    rm -f "$tmp" 2>/dev/null || true
    luna_die "control plane: cannot write $path"
  fi
  [[ "$(cat "$path" 2>/dev/null)" == "$content" ]] ||
    luna_die "POSTCONDITION: $path content does not match the rendered unit after write"
  CP_UNITS_CHANGED=true
  luna_warn "control plane: updated ${path##*/}"
}

# control_plane_units_current <profile> <interval> <current> — pure read: all
# three unit files match their rendered desired text. This is what makes a
# truncated or hand-edited service/alert unit visible to the reconcile gate;
# guardian_control_plane_adopted only checks timer/legacy unit STATE.
control_plane_units_current() {
  local profile="$1" interval="$2" current="$3"
  [[ "$(cat "$SYSTEMD_DIR/luna-guardian-$profile.service" 2>/dev/null)" == \
     "$(desired_guardian_service "$profile" "$current")" ]] || return 1
  [[ "$(cat "$SYSTEMD_DIR/luna-guardian-alert-$profile.service" 2>/dev/null)" == \
     "$(desired_guardian_alert "$profile" "$current")" ]] || return 1
  [[ "$(cat "$SYSTEMD_DIR/luna-guardian-$profile.timer" 2>/dev/null)" == \
     "$(desired_guardian_timer "$profile" "$interval")" ]] || return 1
}

# control_plane_loaded_current <profile> — systemd's LOADED definitions are not
# stale for any guardian unit. The byte-level compare above reads the DISK; it
# cannot see a daemon-reload that failed (or a crash between a unit write and
# its reload), which leaves systemd executing the old in-memory definition
# forever while every later tick reads converged-silent. systemd exposes
# exactly this as NeedDaemonReload. Only an explicit "yes" is drift: an empty
# answer is a stub/transport absence, and absence of an answer is not proof.
control_plane_loaded_current() {
  local profile="$1" unit
  for unit in "luna-guardian-$profile.service" \
    "luna-guardian-alert-$profile.service" \
    "luna-guardian-$profile.timer"; do
    [[ "$(host_unit_property "$unit" NeedDaemonReload)" != "yes" ]] || return 1
  done
  return 0
}

# guardian_env_conflicts_with_installed <profile> — true iff the INSTALLED
# service unit explicitly declares a guardian environment (state dir, luna
# home, or engine pin base) different from this invocation's. Used by the
# check-tick drift gate to refuse rewriting the live control plane from a
# manual run with debug overrides. Absent/blank lines never conflict — a
# truncated unit must still be repairable.
guardian_env_conflicts_with_installed() {
  local profile="$1" unit installed
  unit="$SYSTEMD_DIR/luna-guardian-$profile.service"
  [[ -f "$unit" ]] || return 1
  local luna_home="${LUNA_HOME:-${HOME:-/root}/.luna}"
  installed="$(sed -n 's/^Environment=LUNA_GUARDIAN_STATE_DIR=//p' "$unit" 2>/dev/null | head -1)"
  if [[ -n "$installed" && "$installed" != "$STATE_DIR" ]]; then return 0; fi
  installed="$(sed -n 's/^Environment=LUNA_HOME=//p' "$unit" 2>/dev/null | head -1)"
  if [[ -n "$installed" && "$installed" != "$luna_home" ]]; then return 0; fi
  installed="$(sed -n 's/^ExecStart=//p' "$unit" 2>/dev/null | head -1)"
  if [[ -n "$installed" && "$installed" != "$PIN_BASE/current-$profile/"* ]]; then return 0; fi
  return 1
}

# Durable desired-interval record, in the STATE_DIR pattern. Deriving desired
# cadence from the installed timer alone would self-bless any hand-edit of
# OnUnitInactiveSec (the drift gate renders desired content with the edited
# value and compares equal), permanently exempting the guardian's own tick
# cadence from drift repair. The record captures operator INTENT at install
# time; the installed timer is only a fallback for pre-record installs.
guardian_interval_record_path() { printf '%s/interval-%s' "$STATE_DIR" "$1"; }

# record_guardian_interval <profile> <interval> — returns non-zero when the
# record could not be durably written (same contract as write_guardian_status /
# health_journal_write; callers MUST warn). Equal stored value writes nothing.
record_guardian_interval() {
  local profile="$1" interval="$2" file tmp
  file="$(guardian_interval_record_path "$profile")"; tmp="$file.tmp.$$"
  [[ "$(status_value "$file" interval 2>/dev/null || true)" == "$interval" ]] && return 0
  mkdir -p "$STATE_DIR" || return 1
  chmod 700 "$STATE_DIR" 2>/dev/null || true
  if ! ( umask 077; printf 'profile=%s\ninterval=%s\nrecorded_at=%s\n' \
      "$profile" "$interval" "$(date +%s)" > "$tmp" ); then
    rm -f "$tmp" 2>/dev/null || true
    return 1
  fi
  if ! mv "$tmp" "$file"; then
    rm -f "$tmp" 2>/dev/null || true
    return 1
  fi
}

# guardian_timer_interval <profile> — the DESIRED timer cadence: the durable
# record first (operator intent, hand-edit-proof), the installed timer second
# (pre-record installs), 1min last. Also what refresh_guardian_if_needed passes
# through so an engine advance preserves a custom --interval.
guardian_timer_interval() {
  local profile="$1" interval
  interval="$(status_value "$(guardian_interval_record_path "$profile")" interval 2>/dev/null || true)"
  if [[ ! "$interval" =~ ^[0-9]+(ms|s|min|h|d|w)$ ]]; then
    interval="$(sed -n 's/^OnUnitInactiveSec=//p' "$SYSTEMD_DIR/luna-guardian-$profile.timer" 2>/dev/null | head -1)"
  fi
  [[ "$interval" =~ ^[0-9]+(ms|s|min|h|d|w)$ ]] || interval="1min"
  printf '%s' "$interval"
}

# guardian_units_absent <profile> — pure read: all three unit files gone AND the
# timer unit not loaded. The disallowed-profile tick converges to silence on it.
guardian_units_absent() {
  local profile="$1"
  [[ ! -e "$SYSTEMD_DIR/luna-guardian-$profile.service" &&
     ! -e "$SYSTEMD_DIR/luna-guardian-$profile.timer" &&
     ! -e "$SYSTEMD_DIR/luna-guardian-alert-$profile.service" ]] || return 1
  [[ "$(host_unit_property "luna-guardian-$profile.timer" LoadState)" != "loaded" ]]
}

render_control_plane() {
  local profile="$1" interval="$2" current="$3"
  local guardian_timer="luna-guardian-$profile.timer" legacy_timer="luna-autodeploy-$profile.timer"
  local guardian_service="$SYSTEMD_DIR/luna-guardian-$profile.service"
  local guardian_alert="$SYSTEMD_DIR/luna-guardian-alert-$profile.service"
  local legacy_service="$SYSTEMD_DIR/luna-autodeploy-$profile.service"
  local legacy_removed=false
  [[ -x "$current/luna-guardian" && -x "$current/luna-pager" ]] ||
    luna_die "guardian engine is incomplete: $current"
  # Desired-vs-actual: write (and later reload) ONLY the units that differ. A
  # fully converged render writes nothing and reloads nothing. Ordering is the
  # phase-2 transactional handoff, unchanged: prove the guardian first, then
  # retire the legacy trigger — never report adoption while both are enabled.
  # Reload budget: 0 converged, 1 on unit drift, ≤2 on the once-ever legacy
  # handoff (deliberate: the second reload preserves the prove-then-retire order).
  CP_UNITS_CHANGED=false
  guardian_unit_write "$guardian_service" "$(desired_guardian_service "$profile" "$current")"
  guardian_unit_write "$guardian_alert" "$(desired_guardian_alert "$profile" "$current")"
  guardian_unit_write "$SYSTEMD_DIR/$guardian_timer" "$(desired_guardian_timer "$profile" "$interval")"
  local reloaded=false
  if [[ "$CP_UNITS_CHANGED" == true ]]; then
    systemctl daemon-reload || luna_die "daemon-reload failed after unit render"
    reloaded=true
  elif ! control_plane_loaded_current "$profile"; then
    # Bytes are current but systemd says its LOADED definitions are stale — a
    # prior reload failed or a crash landed between write and reload. Retry the
    # reload; without this the stale in-memory unit would run forever behind a
    # converged-silent disk state.
    luna_warn "control plane: unit files current but systemd reports stale loaded definitions (NeedDaemonReload); reloading"
    systemctl daemon-reload || luna_die "daemon-reload failed after unit render"
    reloaded=true
  fi
  if [[ "$reloaded" == true ]]; then
    # The reload must prove its effect: only an explicit "yes" fails (the
    # helper treats an unanswered query as not-stale, so stubs/transport
    # absence cannot false-alarm).
    control_plane_loaded_current "$profile" ||
      luna_die "POSTCONDITION: systemd still reports stale unit definitions after daemon-reload"
  fi
  if [[ "$(host_unit_property "$guardian_timer" LoadState)" != "loaded" ||
        "$(host_unit_property "$guardian_timer" UnitFileState)" != "enabled" ||
        "$(host_unit_property "$guardian_timer" ActiveState)" != "active" ]]; then
    systemctl enable --now "$guardian_timer"
  fi
  [[ "$(host_unit_property "$guardian_timer" LoadState)" == "loaded" &&
     "$(host_unit_property "$guardian_timer" UnitFileState)" == "enabled" &&
     "$(host_unit_property "$guardian_timer" ActiveState)" == "active" ]] ||
    luna_die "guardian timer failed to become loaded, enabled, and active"

  if [[ "$(host_unit_property "$legacy_timer" LoadState)" != "not-found" ]]; then
    systemctl disable --now "$legacy_timer" || luna_die "failed to disable legacy timer $legacy_timer"
  fi
  if [[ -e "$SYSTEMD_DIR/$legacy_timer" || -e "$legacy_service" ]]; then
    rm -f "$SYSTEMD_DIR/$legacy_timer" "$legacy_service"
    [[ ! -e "$SYSTEMD_DIR/$legacy_timer" && ! -e "$legacy_service" ]] ||
      luna_die "POSTCONDITION: legacy autodeploy units still present after removal"
    legacy_removed=true
  fi
  if [[ "$legacy_removed" == true ]]; then
    systemctl daemon-reload || luna_die "daemon-reload failed after legacy timer retirement"
  fi
  guardian_control_plane_adopted "$profile" ||
    luna_die "guardian handoff verification failed; inspect guardian and legacy timer state"
}

publish_engine() {
  local root="$1" sha="$2" pin="$3"
  local lock="$PIN_BASE/.engine-$sha.lock"
  local tmp="$pin.tmp.$$" attempt owner
  [[ -f "$pin/.complete" ]] && return 0

  for ((attempt = 1; attempt <= 50; attempt++)); do
    if mkdir "$lock" 2>/dev/null; then
      # An ownership claim nobody can witness is not a claim: if the pid record
      # cannot be written and re-read, the stale-classifier below would steal
      # this lock mid-critical-section. Self-release and re-contend instead.
      if ! printf '%s\n' "$$" > "$lock/pid" 2>/dev/null || [[ ! -s "$lock/pid" ]]; then
        rm -rf "$lock" "$tmp"
        sleep 0.1
        continue
      fi
      rm -rf "$tmp"
      [[ ! -e "$pin" || -f "$pin/.complete" ]] || rm -rf "$pin"
      if [[ ! -f "$pin/.complete" ]]; then
        mkdir -p "$tmp/lib"
        cp "$root/scripts/luna-guardian" "$root/scripts/luna-autodeploy" \
          "$root/scripts/luna-update-server" "$root/scripts/luna-server-install" \
          "$root/scripts/luna-doctor" "$root/scripts/luna-pager" "$tmp/"
        cp "$root/scripts/lib/"*.sh "$tmp/lib/"
        chmod +x "$tmp"/luna-*; bash -n "$tmp"/luna-* "$tmp/lib/"*.sh
        touch "$tmp/.complete"; mv "$tmp" "$pin"
      fi
      rm -rf "$lock"
      return 0
    fi
    [[ -f "$pin/.complete" ]] && return 0
    owner="$(cat "$lock/pid" 2>/dev/null || true)"
    if [[ ! "$owner" =~ ^[0-9]+$ ]] || ! kill -0 "$owner" 2>/dev/null; then
      rm -rf "$lock"
      continue
    fi
    sleep 0.1
  done
  luna_die "timed out waiting for guardian engine publication $pin"
}

prune_engines() {
  local keep=5 index=0 dir link target protected=" " known_broken=" " pruned_any=false
  # PRECONDITION: every live pin must resolve before anything is deleted. A
  # dangling current-* would otherwise silently drop out of the protected set
  # and its engine could be pruned. Refusal only warns — pruning is optional,
  # breaking a pin is not. A pin that resolves but is missing its .complete is
  # PRE-EXISTING corruption prune cannot cause and will not touch (the target
  # joins the protected set): warn with the right attribution and remember it,
  # so the postcondition below cannot blame prune for it — this run's install
  # must not fail for a defect prune provably did not create.
  for link in "$PIN_BASE"/current-*; do
    [[ -e "$link" || -L "$link" ]] || continue
    if ! target="$(cd -P "$link" 2>/dev/null && pwd)"; then
      luna_warn "prune refused: ${link##*/} does not resolve; not pruning any engines this run"
      return 0
    fi
    if [[ ! -f "$target/.complete" ]]; then
      luna_warn "prune: ${link##*/} resolves to an engine missing its .complete marker (pre-existing corruption, not caused by prune; the engine is protected from pruning)"
      known_broken+="$link "
    fi
    protected+="$target "
  done
  # shellcheck disable=SC2012
  for dir in $(ls -dt "$PIN_BASE"/engine@* 2>/dev/null || true); do
    index=$((index + 1))
    if (( index <= keep )); then continue; fi
    if [[ "$protected" == *" $dir "* ]]; then continue; fi
    pruned_any=true
    rm -rf "$dir" || luna_warn "prune: could not remove $dir"
  done
  # POSTCONDITION: the kept set still contains every engine a current-* pin
  # resolves into — prune must never break the pin the guardian runs from.
  # Fatal only when prune actually deleted something this run (the breakage is
  # then plausibly ours); otherwise it is the pre-existing corruption warned
  # about above, and killing THIS profile's completed install over it would
  # misattribute the defect.
  for link in "$PIN_BASE"/current-*; do
    [[ -e "$link" || -L "$link" ]] || continue
    [[ "$known_broken" != *" $link "* ]] || continue
    target="$(cd -P "$link" 2>/dev/null && pwd || true)"
    if [[ -z "$target" || ! -f "$target/.complete" ]]; then
      if [[ "$pruned_any" == true ]]; then
        luna_die "POSTCONDITION: engine prune broke ${link##*/} (resolves to '${target:-<unresolvable>}')"
      fi
      luna_warn "engine pin ${link##*/} is broken (resolves to '${target:-<unresolvable>}') but prune deleted nothing this run — pre-existing corruption"
    fi
  done
}

install_guardian() {
  local profile="$1" interval="$2" root sha pin current linktmp pending lock_rc=0
  local resolved pin_phys
  load_profile "$profile"
  [[ "$P_TIMER_ALLOWED" == "true" ]] || luna_die \
    "guardian is not allowed for profile '$profile' (registry deploy.timer=false)"
  root="$(cd "$SCRIPT_DIR/.." && pwd)"
  sha="$(git -C "$root" rev-parse HEAD 2>/dev/null || shasum "$SELF" | awk '{print $1}')"
  pin="$PIN_BASE/engine@$sha"; current="$PIN_BASE/current-$profile"
  # CONVERGED FAST-PATH (pure reads, so no lock is needed; a stale read
  # worst-cases as one skipped tick and mutates nothing): when the pin already
  # resolves to this exact engine, the engine is COMPLETE (the same -x checks
  # render_control_plane would die on — a pin that lost luna-pager must not
  # read as converged silence), and the control plane is byte-current with no
  # stale loaded definitions, there is nothing to install — return silently
  # after converging the durable interval record. The converged install
  # performs no lock, no probe, no publish, no flip, no render, and no prune.
  if [[ "$(installed_engine_sha "$profile" 2>/dev/null || true)" == "$sha" && -f "$pin/.complete" &&
        -x "$current/luna-guardian" && -x "$current/luna-pager" ]] &&
     guardian_control_plane_adopted "$profile" &&
     control_plane_units_current "$profile" "$interval" "$current" &&
     control_plane_loaded_current "$profile"; then
    record_guardian_interval "$profile" "$interval" ||
      luna_warn "cannot record desired interval in $(guardian_interval_record_path "$profile"); a hand-edited timer cadence would self-bless"
    return 0
  fi
  acquire_guardian_update_lock "$profile" || lock_rc=$?
  (( lock_rc == 0 )) || return "$lock_rc"
  pending="${LUNA_UPDATE_STATE_DIR:-${LUNA_HOME:-${HOME:-/root}/.luna}/update}/transaction-$profile"
  if [[ -f "$pending" ]]; then
    luna_warn "DEFERRED: update transaction is pending for profile '$profile'; guardian pin unchanged"
    return 10
  fi
  if ! runtime_health; then
    luna_warn "DEFERRED: runtime does not prove checkout HEAD for profile '$profile'; guardian pin unchanged"
    return 10
  fi
  mkdir -p "$PIN_BASE" "$STATE_DIR"; chmod 700 "$STATE_DIR"
  publish_engine "$root" "$sha" "$pin"
  [[ -f "$pin/.complete" ]] ||
    luna_die "POSTCONDITION: published engine $pin is missing its .complete marker"
  # luna_atomic_replace is load-bearing: an `mv` onto an existing
  # symlink-to-directory without GNU `-T` dereferences the destination and
  # drops the new link *inside* the old engine instead of replacing it, so the
  # pin never advances. And because exactly that silent no-op once lied for a
  # week, the flip must PROVE its effect: re-resolve the link and require it
  # to land on the just-published pin (both sides resolved physically, so a
  # symlinked PIN_BASE cannot false-alarm).
  linktmp="$current.tmp.$$"
  rm -f "$linktmp"
  ln -s "$pin" "$linktmp" || luna_die "cannot stage engine link $linktmp"
  luna_atomic_replace "$linktmp" "$current" || luna_die "cannot publish engine link $current"
  resolved="$(cd -P "$current" 2>/dev/null && pwd || true)"
  pin_phys="$(cd -P "$pin" 2>/dev/null && pwd || true)"
  [[ -n "$resolved" && "$resolved" == "$pin_phys" ]] ||
    luna_die "POSTCONDITION: engine pin flip did not land — current-$profile resolves to '${resolved:-<unresolvable>}', expected $pin"
  render_control_plane "$profile" "$interval" "$current"
  # Record operator intent AFTER the render proved the cadence took effect, so
  # the check-tick drift gate can distinguish a hand-edited OnUnitInactiveSec
  # from a deliberate --interval. Non-fatal: without the record the installed
  # timer is still the fallback (pre-record behaviour), just self-blessing.
  record_guardian_interval "$profile" "$interval" ||
    luna_warn "cannot record desired interval in $(guardian_interval_record_path "$profile"); a hand-edited timer cadence would self-bless"
  prune_engines
  printf 'luna-guardian: installed %s (engine %s, interval %s)\n' \
    "$profile" "$(printf '%s' "$sha" | cut -c1-12)" "$interval"
}

adopt_profile() {
  local profile="$1" update_state pending
  load_profile "$profile"
  [[ "$P_TIMER_ALLOWED" == "true" ]] || luna_die \
    "guardian is not allowed for profile '$profile' (registry deploy.timer=false)"
  if guardian_control_plane_adopted "$profile"; then
    printf 'luna-guardian: already adopted %s\n' "$profile"
    return 0
  fi
  update_state="${LUNA_UPDATE_STATE_DIR:-${LUNA_HOME:-${HOME:-/root}/.luna}/update}"
  pending="$update_state/transaction-$profile"
  if [[ -f "$pending" ]]; then
    printf 'luna-guardian: adoption deferred for %s — update transaction pending\n' "$profile"
    return 10
  fi
  if ! runtime_health; then
    printf 'luna-guardian: adoption deferred for %s — runtime does not prove checkout HEAD\n' "$profile"
    return 10
  fi
  install_guardian "$profile" "1min"
  guardian_control_plane_adopted "$profile" ||
    luna_die "adoption did not establish the guardian control plane"
  printf 'luna-guardian: adopted %s\n' "$profile"
}

# guardian_status_evidence <profile> <expected_sha> <min_cycles> <count_key> <max_age_sec> <require_engine_outcome>
# The status-file evidence verifier — accept_profile's exact check sequence,
# extracted so the promotion gate consumes THE SAME code path instead of
# forking a second evidence format. Pure read. Preserves accept's check ORDER
# with distinct return codes so accept can keep its die messages byte-identical:
#   1  the stored record does not attest <expected_sha> (and, when
#      require_engine_outcome=yes, engine_sha/outcome must also attest it)
#   3  the counter under <count_key> is missing/non-numeric/below <min_cycles>
#   2  the heartbeat (completed_at) is stale beyond <max_age_sec> or in the future
#   0  evidence sufficient
# Exports SE_COUNT (the raw stored counter) for message interpolation.
SE_COUNT=""
guardian_status_evidence() {
  local profile="$1" expected="$2" min_cycles="$3" count_key="$4" max_age="$5" require="$6"
  local status_file status_sha status_engine status_outcome completed now
  status_file="$STATE_DIR/status-$profile"
  status_sha="$(status_value "$status_file" repo_sha 2>/dev/null || true)"
  status_engine="$(status_value "$status_file" engine_sha 2>/dev/null || true)"
  status_outcome="$(status_value "$status_file" outcome 2>/dev/null || true)"
  SE_COUNT="$(status_value "$status_file" "$count_key" 2>/dev/null || true)"
  completed="$(status_value "$status_file" completed_at 2>/dev/null || true)"
  now="$(date +%s)"
  if [[ "$require" == yes ]]; then
    [[ "$status_sha" == "$expected" && "$status_engine" == "$expected" && "$status_outcome" == "healthy" ]] || return 1
  else
    [[ "$status_sha" == "$expected" ]] || return 1
  fi
  [[ "$SE_COUNT" =~ ^[0-9]+$ && "$SE_COUNT" -ge "$min_cycles" ]] || return 3
  [[ "$completed" =~ ^[0-9]+$ && "$completed" -le "$now" && $((now - completed)) -le "$max_age" ]] || return 2
  return 0
}

accept_profile() {
  local profile="$1" expected="$2" min_cycles="$3" repo_sha engine_sha pending doctor status_file guardian_exec
  local i result se_rc=0
  load_profile "$profile"
  [[ "$expected" =~ ^[0-9a-fA-F]{40,64}$ ]] || luna_die "--expected-sha must be a full immutable git SHA"
  [[ "$min_cycles" =~ ^[0-9]+$ && "$min_cycles" -ge 2 && "$min_cycles" -le 10 ]] ||
    luna_die "--min-cycles must be between 2 and 10"
  repo_sha="$(git -C "$P_REPO" rev-parse HEAD 2>/dev/null)" || luna_die "cannot read checkout HEAD"
  [[ "$repo_sha" == "$expected" ]] || luna_die "checkout HEAD $repo_sha does not match expected $expected"
  pending="${LUNA_UPDATE_STATE_DIR:-${LUNA_HOME:-${HOME:-/root}/.luna}/update}/transaction-$profile"
  [[ ! -f "$pending" ]] || luna_die "update transaction is still pending: $pending"
  guardian_control_plane_adopted "$profile" || luna_die "guardian control plane is not fully adopted"
  guardian_exec="$(host_unit_property "luna-guardian-$profile.service" ExecStart)"
  [[ "$guardian_exec" == *"$PIN_BASE/current-$profile/luna-guardian check $profile"* ]] ||
    luna_die "guardian service ExecStart is not pinned to the current $profile engine"
  engine_sha="$(installed_engine_sha "$profile" 2>/dev/null || true)"
  [[ "$engine_sha" == "$expected" ]] || luna_die "guardian engine $engine_sha does not match expected $expected"

  for ((i = 1; i <= min_cycles; i++)); do
    systemctl start "luna-guardian-$profile.service" || luna_die "guardian cycle $i failed to start"
    result="$(host_unit_property "luna-guardian-$profile.service" Result)"
    [[ "$result" == "success" ]] || luna_die "guardian cycle $i result=$result"
    runtime_health || luna_die "guardian cycle $i failed exact runtime health"
    unit_hardened || luna_die "guardian cycle $i found an unhardened runtime unit"
  done

  guardian_control_plane_adopted "$profile" || luna_die "guardian control plane drifted during acceptance"
  repo_sha="$(git -C "$P_REPO" rev-parse HEAD 2>/dev/null)" || luna_die "cannot reread checkout HEAD"
  engine_sha="$(installed_engine_sha "$profile" 2>/dev/null || true)"
  [[ "$repo_sha" == "$expected" && "$engine_sha" == "$expected" ]] ||
    luna_die "accepted SHA changed during guardian cycles"
  [[ ! -f "$pending" ]] || luna_die "guardian cycles left a pending update transaction"

  doctor="$PIN_BASE/current-$profile/luna-doctor"
  [[ -x "$doctor" ]] || luna_die "pinned doctor missing: $doctor"
  "$doctor" "$profile" || luna_die "luna-doctor rejected the live topology"

  # Human acceptance verifies via the SHARED evidence code path (the promotion
  # gate reads the same function); the rc→message mapping keeps every die
  # message byte-identical to the pre-extraction inline checks.
  guardian_status_evidence "$profile" "$expected" "$min_cycles" consecutive_healthy 120 yes || se_rc=$?
  case "$se_rc" in
    0) : ;;
    1) luna_die "guardian status does not attest the expected healthy SHA" ;;
    3) luna_die "guardian has only ${SE_COUNT:-0} consecutive healthy cycle(s); need $min_cycles" ;;
    *) luna_die "guardian status heartbeat is stale or invalid" ;;
  esac
  printf 'luna-guardian: ACCEPTED %s at %s (%s consecutive healthy cycles)\n' \
    "$profile" "$expected" "$SE_COUNT"
}

uninstall_guardian() {
  local profile="$1" f
  # Converged-absent: nothing to remove, so remove nothing, reload nothing, and
  # say nothing — a disallowed profile's steady-state tick must be silent.
  if guardian_units_absent "$profile"; then
    return 0
  fi
  systemctl disable --now "luna-guardian-$profile.timer" 2>/dev/null || true
  rm -f "$SYSTEMD_DIR/luna-guardian-$profile.service" \
    "$SYSTEMD_DIR/luna-guardian-$profile.timer" \
    "$SYSTEMD_DIR/luna-guardian-alert-$profile.service"
  for f in "$SYSTEMD_DIR/luna-guardian-$profile.service" \
    "$SYSTEMD_DIR/luna-guardian-$profile.timer" \
    "$SYSTEMD_DIR/luna-guardian-alert-$profile.service"; do
    [[ ! -e "$f" ]] || luna_die "POSTCONDITION: guardian unit removal left $f in place"
  done
  systemctl daemon-reload
}

cmd="${1:-}"; profile="${2:-}"
[[ -n "$cmd" && -n "$profile" ]] || { echo "usage: luna-guardian check|diagnose|adopt|install|accept|uninstall <profile>" >&2; exit 2; }
luna_validate_profile "$profile"
case "$cmd" in
  check) run_check "$profile" ;;
  diagnose) diagnose "$profile" ;;
  adopt) adopt_profile "$profile" ;;
  install)
    shift 2; interval=1min
    while [[ $# -gt 0 ]]; do
      case "$1" in --interval) interval="${2:?}"; shift 2 ;; *) luna_die "unknown option: $1" ;; esac
    done
    [[ "$interval" =~ ^[0-9]+(ms|s|min|h|d|w)$ ]] || luna_die "invalid interval: $interval"
    install_guardian "$profile" "$interval"
    ;;
  accept)
    shift 2; expected=""; min_cycles=2
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --expected-sha) expected="${2:?}"; shift 2 ;;
        --min-cycles) min_cycles="${2:?}"; shift 2 ;;
        *) luna_die "unknown option: $1" ;;
      esac
    done
    [[ -n "$expected" ]] || luna_die "accept requires --expected-sha <full-sha>"
    accept_profile "$profile" "$expected" "$min_cycles"
    ;;
  uninstall) uninstall_guardian "$profile" ;;
  *) luna_die "unknown command: $cmd" ;;
esac
