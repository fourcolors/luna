#!/usr/bin/env bash
# shellcheck disable=SC2174  # mkdir -p -m 0700 applies mode to deepest dir only - acknowledged; known-red follow-up
#
# luna-autodeploy — poll a channel's upstream branch and, when it has MOVED,
# invoke scripts/luna-update-server to bring the running server to it (fetch +
# reset + conditional bun install + restart + readiness probe + AUTO-ROLLBACK).
#
# This is the pull-based deploy TRIGGER that was the missing glue: GitHub can't
# reach luna-host (Tailscale) and CI can't reach luna-host, so the box polls GitHub.
# It is a thin, SAFE wrapper around the already-tested luna-update-server:
#
#   * NO-OP (quiet exit 0) when the channel is already at origin/<branch>, so a
#     frequent timer only ever restarts the server when the branch actually moved.
#   * CONNECT-AWARE: it DEFERS (exit 0, retry next tick) when the channel has
#     active WebSocket sessions, so it never drops the operator
#     mid-conversation. The guard lives INSIDE luna-update-server (the restart
#     primitive); the check here is only a cheap fast-path defer. BOTH human
#     override levers (--force and --allow-active) are HUMAN-ONLY: each
#     requires an operator reason (--force "why" / --allow-active "why" or
#     LUNA_FORCE_REASON=...) and forwards a logged --operator-override to the
#     engine. Automation (guardian, timers) must use --repair, which honours
#     the engine's session guard fail-closed.
#   * The systemd unit log (journalctl -u luna-autodeploy-<profile>) is the audit
#     trail: each run prints what it did and the from->to SHAs.
#
# AUTO-UPDATE BY DEFAULT (owner decision 2026-07): new hosts use the independent
# one-minute guardian timer. This script remains its apply trigger and the
# migration entrypoint for older 3min/15min updater-only timers. A legacy tick
# adopts the guardian only after the running build proves checkout HEAD and no
# update transaction is pending. deploy.autoUpdate=false disables branch
# movement but not guardian health/repair. Manual one-command deploys always
# work regardless of that knob.
#
# Usage:
#   luna-autodeploy <profile> [--force "reason"] [--allow-active "reason"] [--repair] [--dry-run] [--from-timer]
#   luna-autodeploy <profile> --validate
#   luna-autodeploy install-timer <profile>  [--interval <systemd-time>]
#     (interval default: registry deploy.timerInterval, else 3min)
#   luna-autodeploy uninstall-timer <profile>
#
# --from-timer marks a machine-initiated run (baked into the timer unit's
# ExecStart): it makes the run respect the deploy.autoUpdate knob. It grants
# nothing else — deferral and rollback behave exactly like a manual run.
#
# Profile config is DATA-DRIVEN from /etc/luna/servers.toml (or LUNA_SERVERS_CONFIG).
# Set LUNA_REGISTRY_DISABLE=1 to fall back to the hardcoded case (one-flag rollback).
#
# Built-in profiles (hardcoded fallback — kill-switch/rollback ONLY, luna-host topology):
#   dev    : host repo /root/luna/dev/repo,    branch dev,    incus container luna-dev,    WS :4753 (in container)
#   stable : host repo /root/luna/stable/repo, branch master, incus container luna-stable, WS :4753 (incusd proxy)
#
# NOTE: the hardcoded stable case below still uses bare-host (--repo-dir) as the
# LEGACY PRE-REGISTRY fallback (kill-switch/rollback path only). The registry
# (Phase 1b) correctly reflects stable's REAL runtime: the luna-stable incus
# container. Do not mistake the fallback bare-host for the production topology.
#
# Exit: 0 = up-to-date / deferred / deployed-clean / validate-ok;
#       1 = update failed but luna-update-server rolled back;
#       2 = bad usage or CRITICAL (rollback failed) or validate-failed;
#       3 = repair deferred by session guard (--repair mode only);
#       4 = repair deferred by update-lock contention — a concurrent update
#           holds the profile lock; NOT a session-guard defer (--repair only).
set -euo pipefail

SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
UPDATE_SERVER="$(dirname "$SELF")/luna-update-server"

# Source shared deploy helpers (luna_active_ws_count and friends). The lib
# defines luna_info/luna_warn/luna_die, but this script intentionally uses its
# own echo-based logging (bracketed profile prefix), so the lib functions are
# present but not called here — no naming conflict, sourcing is safe.
# shellcheck source=scripts/lib/luna-deploy.sh
source "$(dirname "$SELF")/lib/luna-deploy.sh"

# Source the registry reader (provides luna_load_server).
# shellcheck source=scripts/lib/luna-registry.sh
source "$(dirname "$SELF")/lib/luna-registry.sh"

# ── S22c: engine selection (LUNA_DEPLOY_ENGINE) ───────────────────────────────
# Chooses which engine performs the deploy. DEFAULT IS BASH: with the variable
# unset this returns the pinned bash engine and behaviour is bit-for-bit what
# it was before this function existed. S23 is the slice that flips the default,
# and it is deliberately a separate, signed-off change - this one only makes
# the choice expressible.
#
# BOTH FAILURE MODES ARE LOUD, and that is the deliberate part:
#
#   - an UNRECOGNISED value refuses rather than falling back to bash. A typo
#     ("binry") that silently ran bash would leave an operator believing they
#     had soaked the binary when they had not, which is the exact class of
#     silent-wrong-answer this arc exists to remove. A refusal stops the
#     profile updating until it is fixed, which the guardian surfaces.
#
#   - LUNA_DEPLOY_ENGINE=binary with no usable binary in the pin ALSO refuses,
#     for the same reason: the operator asked for the binary, and quietly
#     giving them bash answers a question they did not ask.
#
# THE BINARY NEEDS A SUBCOMMAND AND THE BASH ENGINE MUST NOT HAVE ONE.
# luna-update-server has a FLAG-ONLY surface (`--profile stable --ref ...`);
# deploy-cli replaces three scripts and so dispatches on `update|autodeploy|
# guardian`. Returning only a path made the call site exec bare flags against
# the binary, which citty rejects with "Unknown command stable" (exit 1) before
# reaching any of its own logic - a confusing parse error standing in for the
# intended failure. This function therefore emits the full argv PREFIX, and the
# caller execs it followed by the shared flags.
#
# THE BINARY IS NOT BESIDE THE PINNED BASH ENGINE, and the first version of
# this function assumed it was. luna_pin_engine copies luna-update-server and
# lib/ into /usr/local/lib/luna/deploy-engine@<sha>/ and NOTHING ELSE, so
# `dirname($pinned_engine)/deploy-cli` names a path no code ever writes -
# LUNA_DEPLOY_ENGINE=binary hit the refusal below on every real host. deploy-cli
# is published by guardian into its own pin (scripts/luna-guardian:1216-1219),
# which is the directory autodeploy itself was exec'd from. So the caller passes
# that directory explicitly rather than deriving it from the wrong artifact.
#
# Args:   luna_select_engine <pinned_engine_path> <binary_search_dir>
# Stdout: argv prefix to exec, one field per line (path, then any subcommand)
# Return: 0 on success; 1 on any refusal (message on stderr)
luna_select_engine() {
  local pinned_engine="$1"
  local binary_dir="$2"
  local choice="${LUNA_DEPLOY_ENGINE:-bash}"
  case "$choice" in
    bash)
      # Flag-only surface: the path IS the whole prefix.
      printf '%s\n' "$pinned_engine"
      ;;
    binary)
      local cli
      cli="${binary_dir}/deploy-cli"
      if [[ ! -x "$cli" ]]; then
        printf 'luna-autodeploy: LUNA_DEPLOY_ENGINE=binary but no executable deploy-cli at %s; refusing rather than silently running bash\n' "$cli" >&2
        return 1
      fi
      # `update` names which of the three scripts this invocation replaces.
      printf '%s\n%s\n' "$cli" "update"
      ;;
    *)
      printf 'luna-autodeploy: LUNA_DEPLOY_ENGINE=%s is not one of bash|binary; refusing rather than silently choosing one\n' "$choice" >&2
      return 1
      ;;
  esac
}

# ── F11: pinned-copy engine quarantine ───────────────────────────────────────
# Before the REAL luna-update-server invocation, copy the engine bundle (the
# binary + its lib/ siblings) to a content-addressed directory OUTSIDE the
# working tree.  This prevents self-mutation: luna-update-server does
# `git reset --hard`, which would overwrite the running script if the commit
# being deployed touches scripts/.
#
# Args:   luna_pin_engine <repo_dir>
# Stdout: path of the pinned engine binary (caller should use this path)
# Stderr: warnings only (fall-safe: always echoes a usable path)
#
# Test seam:
#   LUNA_TEST_PIN_DIR — override the pin base dir (default /usr/local/lib/luna)
#
luna_pin_engine() {
  # repo_dir kept for API compatibility (callers pass it); sha now from engine repo (FIX 2)
  # shellcheck disable=SC2034
  local repo_dir="$1"
  local engine_src="$UPDATE_SERVER"
  local lib_src
  lib_src="$(dirname "$engine_src")/lib"

  # ── FIX 2: Stamp from the ENGINE's own repo, not the deploy target ──────────
  # The engine lives beside this script; use its repo for the sha so the cache
  # key reflects the engine version being quarantined, not the target's HEAD.
  local sha
  local engine_repo
  engine_repo="$(dirname "$engine_src")"
  sha="$(git -C "$engine_repo" rev-parse HEAD 2>/dev/null)" || \
    sha="$(sha1sum "$engine_src" 2>/dev/null | cut -c1-40)" || \
    sha=""
  if [[ -z "$sha" ]]; then
    printf 'luna-autodeploy WARNING: could not determine HEAD sha for %s; running in-tree engine; self-mutation hazard present\n' "$engine_repo" >&2
    printf '%s' "$engine_src"
    return 0
  fi

  # ── Resolve pin dir ─────────────────────────────────────────────────────────
  local pin_base="${LUNA_TEST_PIN_DIR:-/usr/local/lib/luna}"
  local pin_dir="${pin_base}/deploy-engine@${sha}"

  # ── FIX 1: Idempotency gate on .complete marker, not executable bit ─────────
  # If the dir exists WITH .complete it is fully populated — reuse it.
  if [[ -f "${pin_dir}/.complete" ]]; then
    printf '%s' "${pin_dir}/luna-update-server"
    return 0
  fi

  # If the dir exists WITHOUT .complete it is a stale partial from a prior crash —
  # remove it so we start fresh rather than running a libless engine.
  if [[ -d "$pin_dir" ]]; then
    rm -rf "$pin_dir"
  fi

  # ── Populate atomically via a tmp sibling ───────────────────────────────────
  local tmp_dir="${pin_dir}.tmp.$$"
  # Clean up tmp on any early-exit failure path
  _pin_cleanup() { rm -rf "$tmp_dir" 2>/dev/null || true; }

  if ! mkdir -p "$tmp_dir" 2>/dev/null; then
    printf 'luna-autodeploy WARNING: could not create pin dir %s; running in-tree engine; self-mutation hazard present\n' "$pin_dir" >&2
    printf '%s' "$engine_src"
    return 0
  fi

  # Copy engine binary
  if ! cp "$engine_src" "${tmp_dir}/luna-update-server" 2>/dev/null; then
    printf 'luna-autodeploy WARNING: could not copy engine to %s; running in-tree engine; self-mutation hazard present\n' "$pin_dir" >&2
    _pin_cleanup
    printf '%s' "$engine_src"
    return 0
  fi
  chmod +x "${tmp_dir}/luna-update-server"
  # Verify the effect, not the command: a copied-but-unexecutable engine would
  # later fail with rc=126, which do_deploy reports as "CRITICAL rollback may
  # have failed" — a misdiagnosis. Fall back to the in-tree engine instead.
  if [[ ! -x "${tmp_dir}/luna-update-server" ]]; then
    printf 'luna-autodeploy WARNING: pinned engine in %s is not executable; running in-tree engine; self-mutation hazard present\n' "$pin_dir" >&2
    _pin_cleanup
    printf '%s' "$engine_src"
    return 0
  fi

  # Copy lib/ alongside so the engine's $(dirname $SELF)/lib/... sourcing resolves
  if ! cp -r "$lib_src" "${tmp_dir}/lib" 2>/dev/null; then
    printf 'luna-autodeploy WARNING: could not copy lib/ to %s; running in-tree engine; self-mutation hazard present\n' "$pin_dir" >&2
    _pin_cleanup
    printf '%s' "$engine_src"
    return 0
  fi

  # Completeness marker: written LAST so a partial is never seen as complete.
  # A failed marker write must not publish a dir that every later reader would
  # classify as a stale partial and delete out from under a running engine.
  if ! touch "${tmp_dir}/.complete" 2>/dev/null; then
    printf 'luna-autodeploy WARNING: could not mark pin dir %s complete; running in-tree engine; self-mutation hazard present\n' "$pin_dir" >&2
    _pin_cleanup
    printf '%s' "$engine_src"
    return 0
  fi

  # Atomic publish: mv wins the race; if pin_dir already exists (concurrent
  # deploy won) reuse it as long as it's complete.
  if ! mv "$tmp_dir" "$pin_dir" 2>/dev/null; then
    _pin_cleanup
    if [[ -f "${pin_dir}/.complete" ]]; then
      # Concurrent deploy already published a complete dir — use it.
      printf '%s' "${pin_dir}/luna-update-server"
      return 0
    fi
    printf 'luna-autodeploy WARNING: could not publish pin dir %s; running in-tree engine; self-mutation hazard present\n' "$pin_dir" >&2
    printf '%s' "$engine_src"
    return 0
  fi

  # ── FIX 3: Prune old pin dirs (keep 5 most-recent), best-effort ─────────────
  local _prune_max=5
  local _old_dirs
  # shellcheck disable=SC2012
  _old_dirs="$(ls -dt "${pin_base}/deploy-engine@"* 2>/dev/null | tail -n +"$(( _prune_max + 1 ))")" || true
  if [[ -n "$_old_dirs" ]]; then
    while IFS= read -r _old; do
      # Never prune the dir just published — mtime ordering under concurrent
      # publishers must not be able to select the engine we are about to run.
      if [[ "$_old" == "$pin_dir" ]]; then continue; fi
      rm -rf "$_old" 2>/dev/null || true
    done <<< "$_old_dirs"
  fi

  # Final effect check before handing the path to the caller: a concurrent
  # run's prune (or any other interference) may have removed the pin between
  # publish and use. Fall back to the in-tree engine rather than exec a path
  # that no longer exists.
  if [[ ! -f "${pin_dir}/.complete" || ! -x "${pin_dir}/luna-update-server" ]]; then
    printf 'luna-autodeploy WARNING: pinned engine %s vanished before use; running in-tree engine; self-mutation hazard present\n' "$pin_dir" >&2
    printf '%s' "$engine_src"
    return 0
  fi

  printf '%s' "${pin_dir}/luna-update-server"
}

# ── profile config ───────────────────────────────────────────────────────────
# P_TIMER_ALLOWED / P_AUTO_UPDATE / P_TIMER_INTERVAL are set by
# luna_load_server; the hardcoded fallback sets them inline.
P_REPO="" P_BRANCH="" P_INCUS="" P_PORT="" P_SERVICE_NAME="" P_TIMER_ALLOWED=""
P_AUTO_UPDATE="" P_TIMER_INTERVAL="" P_MAX_SESSION_DEFER=""
# Releases layout (registry-only; the hardcoded fallback below NEVER sets
# these — it stays inplace forever as the one-flag kill switch, pinned by a
# static grep test). Empty P_LAYOUT reads as inplace at every consumer.
P_LAYOUT="" P_DEPLOY_ROOT="" P_RELEASES_KEEP=""
P_UPDATE_ARGS=()

profile_config() {
  local _profile="$1"

  # Registry-driven path: use luna_load_server unless kill-switch is set.
  local _registry_file="${LUNA_SERVERS_CONFIG:-/etc/luna/servers.toml}"
  if [[ "${LUNA_REGISTRY_DISABLE:-0}" != "1" && -f "$_registry_file" ]]; then
    # luna_load_server exits 2 on unknown profile or security violation.
    luna_load_server "$_profile"
    return
  fi

  # ── HARDCODED FALLBACK (kill-switch LUNA_REGISTRY_DISABLE=1, or no registry file) ──
  # This is the original profile_config() case preserved byte-for-byte.
  # P_TIMER_ALLOWED mirrors the data that would come from the registry.
  case "$_profile" in
    dev)
      P_REPO="${LUNA_DEV_REPO_DIR:-/root/luna/dev/repo}"
      P_BRANCH="${LUNA_DEV_BRANCH:-dev}"
      P_INCUS="${LUNA_DEV_INCUS:-luna-dev}"
      P_PORT="${LUNA_DEV_WS_PORT:-4753}"
      P_UPDATE_ARGS=(--profile dev --incus "$P_INCUS" --ref "origin/$P_BRANCH")
      P_SERVICE_NAME="luna-dev-chat-server.service"
      P_TIMER_ALLOWED="true"
      P_AUTO_UPDATE="true"
      P_TIMER_INTERVAL="3min"
      P_MAX_SESSION_DEFER="4h"
      ;;
    stable)
      P_REPO="${LUNA_STABLE_REPO_DIR:-/root/luna/stable/repo}"
      P_BRANCH="${LUNA_STABLE_BRANCH:-master}"
      # LEGACY PRE-REGISTRY BARE-HOST FALLBACK (kill-switch/rollback only).
      # In production, stable runs INSIDE the luna-stable incus container —
      # the registry (Phase 1b) is authoritative for the real topology.
      # This P_INCUS="" / --repo-dir path is ONLY reached when
      # LUNA_REGISTRY_DISABLE=1 is set (one-flag rollback) or the registry
      # file is absent. Do NOT use this as a reference for the actual runtime.
      P_INCUS=""
      P_PORT="${LUNA_STABLE_WS_PORT:-4753}"
      P_UPDATE_ARGS=(--profile stable --repo-dir "$P_REPO" --ref "origin/$P_BRANCH")
      P_SERVICE_NAME="luna-chat-server.service"
      # Timer stays DISALLOWED in the fallback: this branch encodes the legacy
      # bare-host topology where an unattended restart was never designed. The
      # default-on auto-update policy applies to the registry-driven production
      # path (the seed registry ships stable with deploy.timer = true).
      P_TIMER_ALLOWED="false"
      P_AUTO_UPDATE="true"
      P_TIMER_INTERVAL="15min"
      P_MAX_SESSION_DEFER="4h"
      ;;
    *) echo "luna-autodeploy: unknown profile '$_profile' (want dev|stable)" >&2; exit 2 ;;
  esac
}

# ── deploy one channel ───────────────────────────────────────────────────────
FORCE=false ALLOW_ACTIVE=false DRY_RUN=false INTERVAL="" VALIDATE=false FROM_TIMER=false
REPAIR=false FORCE_REASON="" ALLOW_ACTIVE_REASON=""

# Durable completion marker for the legacy-timer -> guardian migration, in the
# guardian's own STATE_DIR pattern (the pinned guardian unit exports
# LUNA_GUARDIAN_STATE_DIR, so guardian-spawned autodeploy inherits it; the
# legacy timer uses the identical default). The marker is a CACHE, never
# authority: adopt rc==0 is the proof (the guardian either verified adoption on
# its fast path or asserted it after install), the marker only stops the
# MIGRATING/"already adopted" log loop and the per-tick runtime probe.
# Post-adoption drift repair is owned by the guardian's own reconcile.
guardian_migration_marker() {
  printf '%s/migrated-%s' "${LUNA_GUARDIAN_STATE_DIR:-/var/lib/luna-guardian}" "$1"
}

record_migration() {
  local profile="$1" marker tmp
  marker="$(guardian_migration_marker "$profile")"
  if ! mkdir -p -m 0700 "$(dirname "$marker")" 2>/dev/null; then
    echo "[autodeploy:$profile] WARNING: could not record guardian migration completion ($marker); will re-verify next tick" >&2
    return 0
  fi
  tmp="$marker.tmp.$$"
  if ! ( umask 077; printf 'profile=%s\nmigrated_at=%s\n' "$profile" "$(date +%s)" > "$tmp" 2>/dev/null ); then
    rm -f "$tmp" 2>/dev/null || true
    echo "[autodeploy:$profile] WARNING: could not record guardian migration completion ($marker); will re-verify next tick" >&2
    return 0
  fi
  if ! mv "$tmp" "$marker" 2>/dev/null || [[ ! -s "$marker" ]]; then
    rm -f "$tmp" 2>/dev/null || true
    echo "[autodeploy:$profile] WARNING: could not record guardian migration completion ($marker); will re-verify next tick" >&2
    return 0
  fi
}

# Existing hosts predate the guardian and still enter through the legacy timer.
# The first legacy tick may deploy the commit that introduces this function
# using the already-loaded old script. On the NEXT tick, this check runs before
# the up-to-date/autoUpdate no-op and atomically hands control to the guardian.
# Installation failure is loud and leaves the legacy timer enabled so it can
# retry; successful installation disables that timer itself. Once adoption has
# succeeded the durable marker makes every later tick a silent -f test — the
# weeks of "MIGRATING legacy timer" / "already adopted" every 60s came from
# never recording completion. An already-adopted host self-heals by paying
# exactly one more noisy tick (adopt's fast path answers rc=0), then silence.
maybe_migrate_guardian() {
  local profile="$1" pending_transaction="$2" candidate="$P_REPO/scripts/luna-guardian" rc=0 marker
  [[ "$FROM_TIMER" == true && "$DRY_RUN" != true && "$P_TIMER_ALLOWED" == "true" ]] || return 0
  marker="$(guardian_migration_marker "$profile")"
  # The marker alone is NOT authority (see the comment above): it silences the
  # steady state only while the guardian control plane is actually present. If
  # this legacy tick is running while the guardian timer unit is GONE (units
  # restored from a pre-migration backup, an operator reinstalling the legacy
  # timer after removing the guardian), the marker must not suppress
  # re-adoption forever — that would be a silent self-healing regression. The
  # unit-file existence test is the cheap actual-state conjunct that keeps the
  # marker a cache.
  local guardian_timer_unit="${LUNA_TEST_SYSTEMD_DIR:-/etc/systemd/system}/luna-guardian-$profile.timer"
  [[ ! -f "$marker" || ! -e "$guardian_timer_unit" ]] || return 0
  [[ -x "$candidate" ]] || return 0
  [[ ! -f "$pending_transaction" ]] || {
    echo "[autodeploy:$profile] guardian migration deferred — update transaction recovery is pending"
    return 0
  }
  # Any non-zero, including INCONCLUSIVE (3), defers adoption and returns 0.
  # Deliberately not debounced: deferring costs one legacy tick and mutates
  # nothing, and a K-tick requirement here would stack with the two further
  # runtime proofs in adopt/install.
  if ! luna_runtime_matches_checkout "$P_REPO" "$P_PORT" "$P_INCUS" "$P_SERVICE_NAME"; then
    echo "[autodeploy:$profile] guardian migration deferred — runtime does not prove checkout HEAD"
    return 0
  fi
  if ! bash -n "$candidate"; then
    echo "[autodeploy:$profile] CRITICAL — guardian candidate failed syntax validation" >&2
    return 2
  fi

  echo "[autodeploy:$profile] MIGRATING legacy timer -> independent guardian"
  "$candidate" adopt "$profile" || rc=$?
  case "$rc" in
    0)
      echo "[autodeploy:$profile] guardian adopted; legacy timer retired"
      record_migration "$profile"
      ;;
    10) echo "[autodeploy:$profile] guardian adoption deferred; legacy timer retained" ;;
    *)
      echo "[autodeploy:$profile] CRITICAL — guardian migration failed; legacy timer retained for retry" >&2
      return 2
      ;;
  esac
}

do_deploy() {
  local profile="$1"; profile_config "$profile"

  [[ -x "$UPDATE_SERVER" ]] || { echo "luna-autodeploy: $UPDATE_SERVER not found/executable" >&2; exit 2; }
  [[ -d "$P_REPO/.git" ]] || { echo "luna-autodeploy: $P_REPO is not a git repo" >&2; exit 2; }

  local local_sha remote_sha update_state_dir pending_transaction
  local_sha="$(git -C "$P_REPO" rev-parse HEAD)"
  update_state_dir="${LUNA_UPDATE_STATE_DIR:-${LUNA_HOME:-${HOME:-/root}/.luna}/update}"
  pending_transaction="$update_state_dir/transaction-$profile"

  if ! maybe_migrate_guardian "$profile" "$pending_transaction"; then return 2; fi

  # Auto-update knob: a TIMER-initiated run respects deploy.autoUpdate; when
  # the operator set it to false the guardian still owns health/recovery, but
  # branch movement is ignored. A manual run ignores the knob — typing the
  # command is the consent the knob exists to gate.
  if [[ "$FROM_TIMER" == true && "$P_AUTO_UPDATE" != "true" ]]; then
    # Silent: this branch is only reachable from the timer, so no human ever
    # sees the echo — it was pure per-tick log noise (journalctl still
    # timestamps each unit run). A converged tick emits nothing.
    return 0
  fi

  # Releases layout: the ONLY fetch target is the bare mirror. With
  # P_REPO=<root>/current, an unforked fetch would write into an immutable
  # release's .git — an immutability violation and a stale-read hazard (the
  # engine resolves the target against the MIRROR's refs, so a release-side
  # fetch would leave the two views disagreeing). local_sha stays rev-parse
  # through current: by construction it IS the deployed release sha.
  if [[ "$P_LAYOUT" == "releases" ]]; then
    git --git-dir "$P_DEPLOY_ROOT/mirror.git" fetch origin "$P_BRANCH" --quiet
    remote_sha="$(git --git-dir "$P_DEPLOY_ROOT/mirror.git" rev-parse "origin/$P_BRANCH")"
  else
    git -C "$P_REPO" fetch origin "$P_BRANCH" --quiet
    remote_sha="$(git -C "$P_REPO" rev-parse "origin/$P_BRANCH")"
  fi

  if [[ "$local_sha" == "$remote_sha" && "$FORCE" != true && ! -f "$pending_transaction" ]]; then
    # Timer ticks converge to silence; a human typing the command still gets
    # feedback that nothing needed doing.
    [[ "$FROM_TIMER" == true ]] || echo "[autodeploy:$profile] up to date at ${local_sha:0:9} — no-op"
    return 0
  fi

  if [[ -f "$pending_transaction" ]]; then
    echo "[autodeploy:$profile] interrupted update journal found — recovery required before normal deploy"
  fi

  if [[ "$ALLOW_ACTIVE" != true && "$FORCE" != true ]]; then
    local n max_defer_secs
    if ! n="$(luna_active_ws_count "$P_PORT" "$P_INCUS")"; then
      echo "[autodeploy:$profile] DEFERRED — active-session count UNKNOWN; refusing unattended restart (origin ${remote_sha:0:9}; use --allow-active only after manual inspection)" >&2
      return 0
    fi
    max_defer_secs="$(luna_parse_systemd_duration "${P_MAX_SESSION_DEFER:-4h}")" || max_defer_secs=14400
    if [[ "$n" -gt 0 ]]; then
      if luna_session_defer_aged "$profile" "$max_defer_secs"; then
        # Standing sockets aged past deploy.maxSessionDefer: apply as STALENESS,
        # not as a human override. Timers must never construct --operator-override.
        echo "[autodeploy:$profile] STALE SESSION DEFER — $n active session(s) standing past deploy.maxSessionDefer=${P_MAX_SESSION_DEFER:-4h}; applying origin ${remote_sha:0:9} anyway (staleness, not an operator override)"
      else
        echo "[autodeploy:$profile] DEFERRED — $n active session(s); will retry next tick (origin ${remote_sha:0:9})"
        return 0
      fi
    else
      luna_session_defer_clear "$profile"
    fi
  fi

  echo "[autodeploy:$profile] deploying ${local_sha:0:9} -> ${remote_sha:0:9} (origin/$P_BRANCH)"
  # Human override levers forward to the engine as an explicit, logged
  # --operator-override reason. The engine's in-primitive session guard is the
  # invariant; these flags are the only (human-typed) way past it.
  local extra=()
  if [[ "$FORCE" == true ]]; then extra=(--operator-override "operator --force: $FORCE_REASON")
  elif [[ "$ALLOW_ACTIVE" == true ]]; then extra=(--operator-override "operator --allow-active: $ALLOW_ACTIVE_REASON")
  fi
  if [[ "$DRY_RUN" == true ]]; then
    echo "[autodeploy:$profile] DRY-RUN: $UPDATE_SERVER ${P_UPDATE_ARGS[*]} ${extra[*]:-}"
    return 0
  fi

  # F11: pin engine BEFORE the real exec so git-reset-hard cannot self-mutate it
  local pinned_engine
  pinned_engine="$(luna_pin_engine "$P_REPO")"

  # S22c: which engine runs, and with what argv prefix. Unset => the pinned
  # bash engine and a prefix of just its path, so this is bit-for-bit the
  # pre-S22c invocation.
  local engine_argv=() _line
  while IFS= read -r _line; do [[ -n "$_line" ]] && engine_argv+=("$_line"); done < <(luna_select_engine "$pinned_engine" "$(dirname "$UPDATE_SERVER")")
  (( ${#engine_argv[@]} > 0 )) || return 2

  # S22d: the binary delegates the topologies it does not own back to the bash
  # engine, and derives the shared library as dirname(engine)/lib/luna-deploy.sh
  # - the exact layout luna_pin_engine publishes. It cannot re-derive the pin
  # itself (the pin is chosen HERE, per invocation), so the path travels as an
  # environment variable. Handing over the PINNED path rather than the repo copy
  # is what keeps a delegated call on the same quarantined engine the gate
  # selected, even if the checkout mutates underneath it mid-run.
  #
  # Harmless for the bash engine, which never reads it: this stays bit-for-bit
  # the pre-S22c invocation when LUNA_DEPLOY_ENGINE is unset.
  local rc=0
  # LUNA_MAX_SESSION_DEFER carries the registry knob into the engine's in-
  # primitive session guard so bash and deploy-cli share one contract (outer
  # gate + inner guard). Not an operator override. Kept on the SAME physical
  # line as the pin env + engine argv expansion so engine-select's pin-prefix
  # invariant still holds.
  LUNA_DEPLOY_BASH_ENGINE="$pinned_engine" LUNA_MAX_SESSION_DEFER="${P_MAX_SESSION_DEFER:-4h}" "${engine_argv[@]}" "${P_UPDATE_ARGS[@]}" ${extra[@]+"${extra[@]}"} || rc=$?
  case "$rc" in
    0)
      # Engine exit 0 does NOT prove the checkout reached the target: the
      # engine legitimately exits 0 on lock-contention deferral (nothing
      # mutated) and after journal recovery to an OLDER recorded target. Both
      # are benign and self-correct next tick — but printing "OK — now at" for
      # them is a lie of the missing-postcondition class. Say what actually
      # happened; rc stays 0 (the hard no-op-reset guarantee lives in the
      # engine's own post-reset assert).
      local now_sha
      now_sha="$(git -C "$P_REPO" rev-parse HEAD 2>/dev/null || true)"
      if [[ "$now_sha" == "$remote_sha" ]]; then
        echo "[autodeploy:$profile] OK — now at ${remote_sha:0:9}"
      else
        echo "[autodeploy:$profile] engine exit 0 without reaching ${remote_sha:0:9} (HEAD ${now_sha:-unreadable}) — deferred by a concurrent update or recovered an older journaled target; will retry next tick"
      fi
      if ! maybe_migrate_guardian "$profile" "$pending_transaction"; then rc=2; fi
      ;;
    1) echo "[autodeploy:$profile] ROLLED BACK — update failed, recovered to ${local_sha:0:9}" >&2 ;;
    3) echo "[autodeploy:$profile] DEFERRED by engine session guard — will retry next tick"; rc=0 ;;
    *) echo "[autodeploy:$profile] CRITICAL rc=$rc — rollback may have failed; manual attention needed" >&2 ;;
  esac
  return "$rc"
}

# ── --repair: the guardian's unattended repair ladder ────────────────────────
# Rung 1: plain guarded unit restart (checkout untouched). Rung 2: full
# rebuild of the CURRENT ref — the checkout's HEAD at repair time, pinned
# explicitly below. Repair is not upgrade: P_UPDATE_ARGS carries
# --ref origin/<branch> and the engine fetches before resolving, so passing it
# through unchanged would advance production to whatever origin gained since
# the last gentle tick — ignoring deploy.autoUpdate=false and shipping commits
# no connect-aware flow ever gated. Pinning HEAD makes rung 2
# rebuild-even-if-current (FORCE semantic 1 without the session-guard
# override, resolving the old conflation) of the build that is already
# deployed. Both rungs run through the engine, whose in-primitive session
# guard fails closed; a defer (rc=3) is returned to the guardian, which pages
# instead of proceeding, and rung-1 update-lock contention (rc=4) is reported
# as contention, never as a session-guard defer. The existing rollback path
# (engine exit 1) is preserved on rung 2. do_repair does not run
# maybe_migrate_guardian.
do_repair() {
  local profile="$1"; profile_config "$profile"
  [[ -x "$UPDATE_SERVER" ]] || { echo "luna-autodeploy: $UPDATE_SERVER not found/executable" >&2; exit 2; }
  # Releases layout: refuse unattended repair on unreadable evidence — a
  # current that does not physically resolve means the deployed identity is
  # unknown, and rung 2 pinned to a guessed sha could ship the wrong build.
  if [[ "$P_LAYOUT" == "releases" ]] && ! (cd -P "$P_REPO" >/dev/null 2>&1); then
    echo "luna-autodeploy: current release link $P_REPO does not resolve — refusing unattended repair on unreadable evidence (manual remedy: ln -sfT releases/<sha> $P_REPO)" >&2
    exit 2
  fi
  [[ -d "$P_REPO/.git" ]] || { echo "luna-autodeploy: $P_REPO is not a git repo" >&2; exit 2; }
  # Pin the repair target to the checkout's CURRENT HEAD: strip the registry's
  # --ref pair (which names the moving origin/<branch>) and substitute HEAD.
  local cur_sha
  cur_sha="$(git -C "$P_REPO" rev-parse HEAD)" ||
    { echo "luna-autodeploy: cannot resolve HEAD in $P_REPO" >&2; exit 2; }
  local repair_args=() _skip_ref_value=false _arg
  for _arg in "${P_UPDATE_ARGS[@]}"; do
    if [[ "$_skip_ref_value" == true ]]; then _skip_ref_value=false; continue; fi
    if [[ "$_arg" == "--ref" ]]; then _skip_ref_value=true; continue; fi
    repair_args+=("$_arg")
  done
  repair_args+=(--ref "$cur_sha")
  if [[ "$DRY_RUN" == true ]]; then
    echo "[repair:$profile] DRY-RUN rung1: $UPDATE_SERVER ${repair_args[*]} --restart-only"
    echo "[repair:$profile] DRY-RUN rung2: $UPDATE_SERVER ${repair_args[*]}"
    return 0
  fi
  local pinned_engine rc=0
  pinned_engine="$(luna_pin_engine "$P_REPO")"
  echo "[repair:$profile] rung 1: plain unit restart (checkout untouched)"
  # THROUGH THE GATE, like do_deploy. This used to exec the pinned bash engine
  # directly, so guardian's whole unattended repair ladder ran bash whatever
  # LUNA_DEPLOY_ENGINE said - which made --restart-only unreachable for the
  # binary and left rung 2 (a FULL redeploy, below) outside the gate entirely.
  local repair_argv=() _rline
  while IFS= read -r _rline; do [[ -n "$_rline" ]] && repair_argv+=("$_rline"); done < <(luna_select_engine "$pinned_engine" "$(dirname "$UPDATE_SERVER")")
  (( ${#repair_argv[@]} > 0 )) || return 2
  LUNA_DEPLOY_BASH_ENGINE="$pinned_engine" "${repair_argv[@]}" "${repair_args[@]}" --restart-only || rc=$?
  case "$rc" in
    0) echo "[repair:$profile] REPAIRED by unit restart"; return 0 ;;
    3) echo "[repair:$profile] DEFERRED by session guard — live/unknown sessions; not escalating"; return 3 ;;
    4) echo "[repair:$profile] DEFERRED — a concurrent update holds the profile lock (no sessions were evaluated); not escalating"; return 4 ;;
  esac
  echo "[repair:$profile] rung 1 failed (rc=$rc); rung 2: full rebuild of current ref ${cur_sha:0:9}"
  rc=0
  LUNA_DEPLOY_BASH_ENGINE="$pinned_engine" "${repair_argv[@]}" "${repair_args[@]}" || rc=$?
  case "$rc" in
    0) echo "[repair:$profile] REPAIRED by full redeploy of ${cur_sha:0:9}" ;;
    1) echo "[repair:$profile] ROLLED BACK — full redeploy failed, recovered to previous" >&2 ;;
    3) echo "[repair:$profile] DEFERRED by session guard during full redeploy" ;;
    *) echo "[repair:$profile] CRITICAL rc=$rc — manual attention needed" >&2 ;;
  esac
  return "$rc"
}

# ── F7: --validate — existence checks on registry-declared infra ─────────────
# Distinct from --dry-run (which only renders flags). Checks that the referenced
# container / repo dir / systemd unit actually EXIST on this host.
#
# Test seams (mirrors LUNA_TEST_* pattern):
#   LUNA_TEST_VALIDATE_REPO    — override repo .git dir existence check
#   LUNA_TEST_VALIDATE_INCUS   — override incus container existence check
#   LUNA_TEST_VALIDATE_SERVICE — override systemd unit existence check
do_validate() {
  local profile="$1"; profile_config "$profile"
  local ok=true

  echo "[validate:$profile] Checking registry entries..."

  # 1. Repo dir / releases deploy-root shape
  # Releases layout replaces the plain .git check with the releases shape:
  # bare mirror + explicit origin refspec + current resolving to a .complete
  # release. Each broken element fails with its own named cause. The
  # LUNA_TEST_VALIDATE_REPO seam still short-circuits the whole group.
  local repo_ok
  if [[ "${LUNA_TEST_VALIDATE_REPO+set}" == "set" ]]; then
    repo_ok="$LUNA_TEST_VALIDATE_REPO"
    if [[ "$repo_ok" == "true" ]]; then
      echo "[validate:$profile] OK: repo dir $P_REPO"
    else
      echo "[validate:$profile] FAIL: repo dir $P_REPO not found or not a git repo" >&2
      ok=false
    fi
  elif [[ "$P_LAYOUT" == "releases" ]]; then
    local _mirror="$P_DEPLOY_ROOT/mirror.git" _cur_phys=""
    repo_ok="true"
    if [[ "$(git --git-dir "$_mirror" rev-parse --is-bare-repository 2>/dev/null)" != "true" ]]; then
      echo "[validate:$profile] FAIL: mirror $_mirror missing or not a bare repository" >&2
      repo_ok="false"
    elif [[ "$(git --git-dir "$_mirror" config --get remote.origin.fetch 2>/dev/null)" != *"refs/remotes/origin/"* ]]; then
      echo "[validate:$profile] FAIL: mirror $_mirror lacks the remote.origin.fetch refspec mapping to refs/remotes/origin/*" >&2
      repo_ok="false"
    fi
    _cur_phys="$(cd -P "$P_DEPLOY_ROOT/current" 2>/dev/null && pwd || true)"
    if [[ -z "$_cur_phys" || "$_cur_phys" != "$(cd -P "$P_DEPLOY_ROOT/releases" 2>/dev/null && pwd || printf '/nonexistent')/"* ]]; then
      echo "[validate:$profile] FAIL: $P_DEPLOY_ROOT/current does not resolve into $P_DEPLOY_ROOT/releases/" >&2
      repo_ok="false"
    elif [[ ! -f "$_cur_phys/.complete" ]]; then
      echo "[validate:$profile] FAIL: current release $_cur_phys is missing its .complete marker" >&2
      repo_ok="false"
    fi
    if [[ "$repo_ok" == "true" ]]; then
      echo "[validate:$profile] OK: releases deploy root $P_DEPLOY_ROOT (mirror + current -> ${_cur_phys##*/})"
    else
      ok=false
    fi
  elif [[ -d "$P_REPO/.git" ]]; then
    echo "[validate:$profile] OK: repo dir $P_REPO"
  else
    echo "[validate:$profile] FAIL: repo dir $P_REPO not found or not a git repo" >&2
    ok=false
  fi

  # 2. Incus container (only if incus is configured)
  if [[ -n "$P_INCUS" ]]; then
    local incus_ok
    if [[ "${LUNA_TEST_VALIDATE_INCUS+set}" == "set" ]]; then
      incus_ok="$LUNA_TEST_VALIDATE_INCUS"
    elif command -v incus >/dev/null 2>&1 && incus info "$P_INCUS" >/dev/null 2>&1; then
      incus_ok="true"
    else
      incus_ok="false"
    fi
    if [[ "$incus_ok" == "true" ]]; then
      echo "[validate:$profile] OK: incus container $P_INCUS"
    else
      echo "[validate:$profile] FAIL: incus container $P_INCUS not found or not running" >&2
      ok=false
    fi
  else
    echo "[validate:$profile] OK: bare-host mode (no incus container)"
  fi

  # 3. Systemd unit file (only if P_SERVICE_NAME is set)
  if [[ -n "$P_SERVICE_NAME" ]]; then
    local svc_ok
    if [[ "${LUNA_TEST_VALIDATE_SERVICE+set}" == "set" ]]; then
      svc_ok="$LUNA_TEST_VALIDATE_SERVICE"
    elif [[ -f "/etc/systemd/system/$P_SERVICE_NAME" ]] || \
         systemctl cat "$P_SERVICE_NAME" >/dev/null 2>&1; then
      svc_ok="true"
    else
      svc_ok="false"
    fi
    if [[ "$svc_ok" == "true" ]]; then
      echo "[validate:$profile] OK: systemd unit $P_SERVICE_NAME"
    else
      echo "[validate:$profile] FAIL: systemd unit $P_SERVICE_NAME not found" >&2
      ok=false
    fi
  fi

  if [[ "$ok" == "true" ]]; then
    echo "[validate:$profile] All checks passed."
    return 0
  else
    echo "[validate:$profile] Validation FAILED — check errors above." >&2
    return 2
  fi
}

# ── systemd timer install ─────────────────────────────────────────────────────
# Test seam:
#   LUNA_TEST_SYSTEMD_DIR — override the unit dir (default /etc/systemd/system)
install_timer() {
  local profile="$1"; profile_config "$profile"

  # (F5) Hard-reject timer install for any profile where the registry says
  # timer is not allowed. This enforces the opt-out rail in CODE, not just
  # data — even if someone edits the registry entry, this gate fires.
  if [[ "$P_TIMER_ALLOWED" != "true" ]]; then
    echo "luna-autodeploy: timers are not allowed for profile '$profile' (registry deploy.timer=false)." >&2
    echo "  This profile is deploy-by-hand only until the registry says otherwise." >&2
    echo "  If you intend to enable auto-deploy for this profile, set deploy.timer=true in the registry." >&2
    exit 2
  fi

  # Cadence: --interval wins, else the registry's deploy.timerInterval, else
  # 3min. The seed registry ships dev=3min, stable=15min.
  local interval="${INTERVAL:-${P_TIMER_INTERVAL:-3min}}"
  local unit_dir="${LUNA_TEST_SYSTEMD_DIR:-/etc/systemd/system}"
  local svc="$unit_dir/luna-autodeploy-$profile.service"
  local tmr="$unit_dir/luna-autodeploy-$profile.timer"

  # ExecStart points at the CHANNEL repo's OWN copy of this script
  # ($P_REPO/scripts/luna-autodeploy), not the provisioning checkout that may
  # have invoked us. This keeps the timer alive if the provisioning checkout
  # moves, and lets the channel run autodeploy fixes shipped through the very
  # branch it updates. Fall back to the running copy only when the channel copy
  # is not yet present (e.g. install-timer against a repo cloned later).
  local exec_bin="$P_REPO/scripts/luna-autodeploy"
  if [[ ! -x "$exec_bin" ]]; then
    echo "luna-autodeploy: channel copy $exec_bin not found — timer ExecStart falls back to $SELF" >&2
    exec_bin="$SELF"
  fi
  # Atomic tmp+mv writes: a crash mid-cat must never leave a truncated live
  # unit for systemd to load. (This is a human-invoked one-shot, not a loop, so
  # there is no convergence property to protect — just atomicity + effect.)
  cat > "$svc.tmp.$$" <<EOF
[Unit]
Description=Luna auto-deploy ($profile) — pull origin/$P_BRANCH and update if it moved
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# HOME is required so git/gh find credentials for the private remote (see
# memory: the unit running with HOME unset was a real auth footgun).
Environment=HOME=/root
# --from-timer: machine-initiated run — respects the deploy.autoUpdate knob
# and never bypasses the connect-aware active-session deferral.
ExecStart=$exec_bin $profile --from-timer
EOF
  if ! mv "$svc.tmp.$$" "$svc"; then
    rm -f "$svc.tmp.$$"
    echo "luna-autodeploy: cannot write $svc" >&2
    exit 2
  fi
  cat > "$tmr.tmp.$$" <<EOF
[Unit]
Description=Luna auto-deploy ($profile) timer — checks origin/$P_BRANCH every $interval

[Timer]
OnBootSec=2min
OnUnitActiveSec=$interval
AccuracySec=30s
Persistent=false

[Install]
WantedBy=timers.target
EOF
  if ! mv "$tmr.tmp.$$" "$tmr"; then
    rm -f "$tmr.tmp.$$"
    echo "luna-autodeploy: cannot write $tmr" >&2
    exit 2
  fi
  systemctl daemon-reload
  systemctl enable --now "luna-autodeploy-$profile.timer"
  # POSTCONDITION: the enable must have taken effect. Only a non-empty WRONG
  # answer fails — an empty answer means the systemctl in play never answered
  # the query (transport/stub), and absence of an answer is not proof of
  # failure (the same skip-unless-answered rule the MainPID check uses).
  local _t="luna-autodeploy-$profile.timer" _load _enabled _active
  _load="$(systemctl show "$_t" -p LoadState --value 2>/dev/null || true)"
  _enabled="$(systemctl show "$_t" -p UnitFileState --value 2>/dev/null || true)"
  _active="$(systemctl show "$_t" -p ActiveState --value 2>/dev/null || true)"
  if [[ ( -n "$_load" && "$_load" != "loaded" ) ||
        ( -n "$_enabled" && "$_enabled" != "enabled" ) ||
        ( -n "$_active" && "$_active" != "active" ) ]]; then
    echo "luna-autodeploy: POSTCONDITION: autodeploy timer failed to become loaded/enabled/active (LoadState=${_load:-?} UnitFileState=${_enabled:-?} ActiveState=${_active:-?})" >&2
    exit 2
  fi
  echo "luna-autodeploy: installed + enabled luna-autodeploy-$profile.timer (every $interval)"
  echo "  ExecStart=$exec_bin $profile --from-timer"
  systemctl list-timers "luna-autodeploy-$profile.timer" --no-pager 2>/dev/null | head -3 || true
}

uninstall_timer() {
  local profile="$1"
  local unit_dir="${LUNA_TEST_SYSTEMD_DIR:-/etc/systemd/system}"
  local tmr="$unit_dir/luna-autodeploy-$profile.timer"
  local svc="$unit_dir/luna-autodeploy-$profile.service"
  local load
  load="$(systemctl show "luna-autodeploy-$profile.timer" -p LoadState --value 2>/dev/null || true)"
  # Converged-absent: nothing installed and nothing loaded — remove nothing,
  # reload nothing, print nothing.
  if [[ ! -e "$tmr" && ! -e "$svc" && "$load" != "loaded" ]]; then
    return 0
  fi
  systemctl disable --now "luna-autodeploy-$profile.timer" 2>/dev/null || true
  rm -f "$tmr" "$svc"
  if [[ -e "$tmr" || -e "$svc" ]]; then
    echo "luna-autodeploy: POSTCONDITION: autodeploy units still present after removal" >&2
    exit 2
  fi
  systemctl daemon-reload
  echo "luna-autodeploy: removed luna-autodeploy-$profile timer + service"
}

# ── arg parse + dispatch ─────────────────────────────────────────────────────
CMD="${1:-}"
case "$CMD" in
  install-timer|uninstall-timer)
    SUBPROFILE="${2:?usage: luna-autodeploy $CMD <profile>}"; shift 2
    while [[ $# -gt 0 ]]; do case "$1" in --interval) INTERVAL="${2:?}"; shift 2 ;; *) echo "unknown arg: $1" >&2; exit 2 ;; esac; done
    # A plain if/else (not `A && B || C`): the list form suppressed `set -e`
    # inside install_timer (a failed unit write still exited 0) and ran
    # uninstall_timer whenever install_timer returned non-zero.
    if [[ "$CMD" == install-timer ]]; then
      install_timer "$SUBPROFILE"
    else
      uninstall_timer "$SUBPROFILE"
    fi
    ;;
  *)
    # A profile name (or unknown command) — must be a non-empty string.
    [[ -n "$CMD" && "$CMD" != "-h" && "$CMD" != "--help" ]] || { sed -n '2,58p' "$SELF" | sed 's/^# \{0,1\}//'; exit 0; }
    PROFILE="$CMD"; shift
    while [[ $# -gt 0 ]]; do case "$1" in
      --force) FORCE=true; shift
        if [[ $# -gt 0 && "$1" != --* ]]; then FORCE_REASON="$1"; shift; fi ;;
      --repair) REPAIR=true; shift ;;
      --allow-active) ALLOW_ACTIVE=true; shift
        if [[ $# -gt 0 && "$1" != --* ]]; then ALLOW_ACTIVE_REASON="$1"; shift; fi ;;
      --dry-run) DRY_RUN=true; shift ;;
      --validate) VALIDATE=true; shift ;;
      --from-timer) FROM_TIMER=true; shift ;;
      *) echo "unknown arg: $1" >&2; exit 2 ;;
    esac; done
    # --repair is the UNATTENDED entry: it must never be combined with a human
    # override lever (automation holding the hammer is what phase 2 removes).
    if [[ "$REPAIR" == true && ( "$FORCE" == true || "$ALLOW_ACTIVE" == true ) ]]; then
      echo "luna-autodeploy: --repair cannot be combined with --force/--allow-active" >&2; exit 2
    fi
    # --force is HUMAN-ONLY and requires an operator reason (inline or via
    # LUNA_FORCE_REASON), logged into the invoking unit's journal trail.
    if [[ "$FORCE" == true ]]; then
      FORCE_REASON="${FORCE_REASON:-${LUNA_FORCE_REASON:-}}"
      if [[ -z "$FORCE_REASON" ]]; then
        echo "luna-autodeploy: --force requires an operator reason: --force \"why\" or LUNA_FORCE_REASON=... (automation must use --repair)" >&2
        exit 2
      fi
      echo "[autodeploy:$PROFILE] FORCE by operator: $FORCE_REASON"
    fi
    # --allow-active is the SECOND human override lever past the engine's
    # session guard; it must meet the same audit bar as --force — an explicit
    # operator reason, logged into the invoking unit's journal trail. Without
    # this gate it would remain a reason-free synonym any future wrapper could
    # construct unattended.
    if [[ "$ALLOW_ACTIVE" == true ]]; then
      ALLOW_ACTIVE_REASON="${ALLOW_ACTIVE_REASON:-${LUNA_FORCE_REASON:-}}"
      if [[ -z "$ALLOW_ACTIVE_REASON" ]]; then
        echo "luna-autodeploy: --allow-active requires an operator reason: --allow-active \"why\" or LUNA_FORCE_REASON=... (automation must use --repair)" >&2
        exit 2
      fi
      echo "[autodeploy:$PROFILE] ALLOW-ACTIVE by operator: $ALLOW_ACTIVE_REASON"
    fi
    if [[ "$VALIDATE" == true ]]; then
      do_validate "$PROFILE"
    elif [[ "$REPAIR" == true ]]; then
      do_repair "$PROFILE"
    else
      do_deploy "$PROFILE"
    fi
    ;;
esac
