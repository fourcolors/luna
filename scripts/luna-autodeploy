#!/usr/bin/env bash
#
# luna-autodeploy — poll a channel's upstream branch and, when it has MOVED,
# invoke scripts/luna-update-server to bring the running server to it (fetch +
# reset + conditional bun install + restart + readiness probe + AUTO-ROLLBACK).
#
# This is the pull-based deploy TRIGGER that was the missing glue: GitHub can't
# reach jax-box (Tailscale) and CI can't reach jax-box, so the box polls GitHub.
# It is a thin, SAFE wrapper around the already-tested luna-update-server:
#
#   * NO-OP (quiet exit 0) when the channel is already at origin/<branch>, so a
#     frequent timer only ever restarts the server when the branch actually moved.
#   * CONNECT-AWARE: by default it DEFERS (exit 0, retry next tick) when the
#     channel has active WebSocket sessions, so it never drops the operator
#     mid-conversation. Override with --allow-active (or --force).
#   * The systemd unit log (journalctl -u luna-autodeploy-<profile>) is the audit
#     trail: each run prints what it did and the from->to SHAs.
#
# AUTO-UPDATE BY DEFAULT (owner decision 2026-07): new hosts use the independent
# one-minute guardian timer. This script remains its apply trigger and the
# migration entrypoint for older 3min/15min updater-only timers. A legacy tick
# adopts the guardian only after the running build proves checkout HEAD and no
# update transaction is pending. deploy.autoUpdate=false disables branch
# movement but not guardian health/repair. Manual one-command deploys always
# work regardless of that knob.
#
# Usage:
#   luna-autodeploy <profile> [--force] [--allow-active] [--dry-run] [--from-timer]
#   luna-autodeploy <profile> --validate
#   luna-autodeploy install-timer <profile>  [--interval <systemd-time>]
#     (interval default: registry deploy.timerInterval, else 3min)
#   luna-autodeploy uninstall-timer <profile>
#
# --from-timer marks a machine-initiated run (baked into the timer unit's
# ExecStart): it makes the run respect the deploy.autoUpdate knob. It grants
# nothing else — deferral and rollback behave exactly like a manual run.
#
# Profile config is DATA-DRIVEN from /etc/luna/servers.toml (or LUNA_SERVERS_CONFIG).
# Set LUNA_REGISTRY_DISABLE=1 to fall back to the hardcoded case (one-flag rollback).
#
# Built-in profiles (hardcoded fallback — kill-switch/rollback ONLY, jax-box topology):
#   dev    : host repo /root/luna/dev/repo,    branch dev,    incus container luna-dev,    WS :4753 (in container)
#   stable : host repo /root/luna/stable/repo, branch master, incus container luna-stable, WS :4753 (incusd proxy)
#
# NOTE: the hardcoded stable case below still uses bare-host (--repo-dir) as the
# LEGACY PRE-REGISTRY fallback (kill-switch/rollback path only). The registry
# (Phase 1b) correctly reflects stable's REAL runtime: the luna-stable incus
# container. Do not mistake the fallback bare-host for the production topology.
#
# Exit: 0 = up-to-date / deferred / deployed-clean / validate-ok;
#       1 = update failed but luna-update-server rolled back;
#       2 = bad usage or CRITICAL (rollback failed) or validate-failed.
set -euo pipefail

SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
UPDATE_SERVER="$(dirname "$SELF")/luna-update-server"

# Source shared deploy helpers (luna_active_ws_count and friends). The lib
# defines luna_info/luna_warn/luna_die, but this script intentionally uses its
# own echo-based logging (bracketed profile prefix), so the lib functions are
# present but not called here — no naming conflict, sourcing is safe.
# shellcheck source=scripts/lib/luna-deploy.sh
source "$(dirname "$SELF")/lib/luna-deploy.sh"

# Source the registry reader (provides luna_load_server).
# shellcheck source=scripts/lib/luna-registry.sh
source "$(dirname "$SELF")/lib/luna-registry.sh"

# ── F11: pinned-copy engine quarantine ───────────────────────────────────────
# Before the REAL luna-update-server invocation, copy the engine bundle (the
# binary + its lib/ siblings) to a content-addressed directory OUTSIDE the
# working tree.  This prevents self-mutation: luna-update-server does
# `git reset --hard`, which would overwrite the running script if the commit
# being deployed touches scripts/.
#
# Args:   luna_pin_engine <repo_dir>
# Stdout: path of the pinned engine binary (caller should use this path)
# Stderr: warnings only (fall-safe: always echoes a usable path)
#
# Test seam:
#   LUNA_TEST_PIN_DIR — override the pin base dir (default /usr/local/lib/luna)
#
luna_pin_engine() {
  # repo_dir kept for API compatibility (callers pass it); sha now from engine repo (FIX 2)
  # shellcheck disable=SC2034
  local repo_dir="$1"
  local engine_src="$UPDATE_SERVER"
  local lib_src
  lib_src="$(dirname "$engine_src")/lib"

  # ── FIX 2: Stamp from the ENGINE's own repo, not the deploy target ──────────
  # The engine lives beside this script; use its repo for the sha so the cache
  # key reflects the engine version being quarantined, not the target's HEAD.
  local sha
  local engine_repo
  engine_repo="$(dirname "$engine_src")"
  sha="$(git -C "$engine_repo" rev-parse HEAD 2>/dev/null)" || \
    sha="$(sha1sum "$engine_src" 2>/dev/null | cut -c1-40)" || \
    sha=""
  if [[ -z "$sha" ]]; then
    printf 'luna-autodeploy WARNING: could not determine HEAD sha for %s; running in-tree engine; self-mutation hazard present\n' "$engine_repo" >&2
    printf '%s' "$engine_src"
    return 0
  fi

  # ── Resolve pin dir ─────────────────────────────────────────────────────────
  local pin_base="${LUNA_TEST_PIN_DIR:-/usr/local/lib/luna}"
  local pin_dir="${pin_base}/deploy-engine@${sha}"

  # ── FIX 1: Idempotency gate on .complete marker, not executable bit ─────────
  # If the dir exists WITH .complete it is fully populated — reuse it.
  if [[ -f "${pin_dir}/.complete" ]]; then
    printf '%s' "${pin_dir}/luna-update-server"
    return 0
  fi

  # If the dir exists WITHOUT .complete it is a stale partial from a prior crash —
  # remove it so we start fresh rather than running a libless engine.
  if [[ -d "$pin_dir" ]]; then
    rm -rf "$pin_dir"
  fi

  # ── Populate atomically via a tmp sibling ───────────────────────────────────
  local tmp_dir="${pin_dir}.tmp.$$"
  # Clean up tmp on any early-exit failure path
  _pin_cleanup() { rm -rf "$tmp_dir" 2>/dev/null || true; }

  if ! mkdir -p "$tmp_dir" 2>/dev/null; then
    printf 'luna-autodeploy WARNING: could not create pin dir %s; running in-tree engine; self-mutation hazard present\n' "$pin_dir" >&2
    printf '%s' "$engine_src"
    return 0
  fi

  # Copy engine binary
  if ! cp "$engine_src" "${tmp_dir}/luna-update-server" 2>/dev/null; then
    printf 'luna-autodeploy WARNING: could not copy engine to %s; running in-tree engine; self-mutation hazard present\n' "$pin_dir" >&2
    _pin_cleanup
    printf '%s' "$engine_src"
    return 0
  fi
  chmod +x "${tmp_dir}/luna-update-server"

  # Copy lib/ alongside so the engine's $(dirname $SELF)/lib/... sourcing resolves
  if ! cp -r "$lib_src" "${tmp_dir}/lib" 2>/dev/null; then
    printf 'luna-autodeploy WARNING: could not copy lib/ to %s; running in-tree engine; self-mutation hazard present\n' "$pin_dir" >&2
    _pin_cleanup
    printf '%s' "$engine_src"
    return 0
  fi

  # Completeness marker: written LAST so a partial is never seen as complete
  touch "${tmp_dir}/.complete"

  # Atomic publish: mv wins the race; if pin_dir already exists (concurrent
  # deploy won) reuse it as long as it's complete.
  if ! mv "$tmp_dir" "$pin_dir" 2>/dev/null; then
    _pin_cleanup
    if [[ -f "${pin_dir}/.complete" ]]; then
      # Concurrent deploy already published a complete dir — use it.
      printf '%s' "${pin_dir}/luna-update-server"
      return 0
    fi
    printf 'luna-autodeploy WARNING: could not publish pin dir %s; running in-tree engine; self-mutation hazard present\n' "$pin_dir" >&2
    printf '%s' "$engine_src"
    return 0
  fi

  # ── FIX 3: Prune old pin dirs (keep 5 most-recent), best-effort ─────────────
  local _prune_max=5
  local _old_dirs
  # shellcheck disable=SC2012
  _old_dirs="$(ls -dt "${pin_base}/deploy-engine@"* 2>/dev/null | tail -n +"$(( _prune_max + 1 ))")" || true
  if [[ -n "$_old_dirs" ]]; then
    while IFS= read -r _old; do
      rm -rf "$_old" 2>/dev/null || true
    done <<< "$_old_dirs"
  fi

  printf '%s' "${pin_dir}/luna-update-server"
}

# ── profile config ───────────────────────────────────────────────────────────
# P_TIMER_ALLOWED / P_AUTO_UPDATE / P_TIMER_INTERVAL are set by
# luna_load_server; the hardcoded fallback sets them inline.
P_REPO="" P_BRANCH="" P_INCUS="" P_PORT="" P_SERVICE_NAME="" P_TIMER_ALLOWED=""
P_AUTO_UPDATE="" P_TIMER_INTERVAL=""
P_UPDATE_ARGS=()

profile_config() {
  local _profile="$1"

  # Registry-driven path: use luna_load_server unless kill-switch is set.
  local _registry_file="${LUNA_SERVERS_CONFIG:-/etc/luna/servers.toml}"
  if [[ "${LUNA_REGISTRY_DISABLE:-0}" != "1" && -f "$_registry_file" ]]; then
    # luna_load_server exits 2 on unknown profile or security violation.
    luna_load_server "$_profile"
    return
  fi

  # ── HARDCODED FALLBACK (kill-switch LUNA_REGISTRY_DISABLE=1, or no registry file) ──
  # This is the original profile_config() case preserved byte-for-byte.
  # P_TIMER_ALLOWED mirrors the data that would come from the registry.
  case "$_profile" in
    dev)
      P_REPO="${LUNA_DEV_REPO_DIR:-/root/luna/dev/repo}"
      P_BRANCH="${LUNA_DEV_BRANCH:-dev}"
      P_INCUS="${LUNA_DEV_INCUS:-luna-dev}"
      P_PORT="${LUNA_DEV_WS_PORT:-4753}"
      P_UPDATE_ARGS=(--profile dev --incus "$P_INCUS" --ref "origin/$P_BRANCH")
      P_SERVICE_NAME="luna-dev-chat-server.service"
      P_TIMER_ALLOWED="true"
      P_AUTO_UPDATE="true"
      P_TIMER_INTERVAL="3min"
      ;;
    stable)
      P_REPO="${LUNA_STABLE_REPO_DIR:-/root/luna/stable/repo}"
      P_BRANCH="${LUNA_STABLE_BRANCH:-master}"
      # LEGACY PRE-REGISTRY BARE-HOST FALLBACK (kill-switch/rollback only).
      # In production, stable runs INSIDE the luna-stable incus container —
      # the registry (Phase 1b) is authoritative for the real topology.
      # This P_INCUS="" / --repo-dir path is ONLY reached when
      # LUNA_REGISTRY_DISABLE=1 is set (one-flag rollback) or the registry
      # file is absent. Do NOT use this as a reference for the actual runtime.
      P_INCUS=""
      P_PORT="${LUNA_STABLE_WS_PORT:-4753}"
      P_UPDATE_ARGS=(--profile stable --repo-dir "$P_REPO" --ref "origin/$P_BRANCH")
      P_SERVICE_NAME="luna-chat-server.service"
      # Timer stays DISALLOWED in the fallback: this branch encodes the legacy
      # bare-host topology where an unattended restart was never designed. The
      # default-on auto-update policy applies to the registry-driven production
      # path (the seed registry ships stable with deploy.timer = true).
      P_TIMER_ALLOWED="false"
      P_AUTO_UPDATE="true"
      P_TIMER_INTERVAL="15min"
      ;;
    *) echo "luna-autodeploy: unknown profile '$_profile' (want dev|stable)" >&2; exit 2 ;;
  esac
}

# ── deploy one channel ───────────────────────────────────────────────────────
FORCE=false ALLOW_ACTIVE=false DRY_RUN=false INTERVAL="" VALIDATE=false FROM_TIMER=false

# Existing hosts predate the guardian and still enter through the legacy timer.
# The first legacy tick may deploy the commit that introduces this function
# using the already-loaded old script. On the NEXT tick, this check runs before
# the up-to-date/autoUpdate no-op and atomically hands control to the guardian.
# Installation failure is loud and leaves the legacy timer enabled so it can
# retry; successful installation disables that timer itself.
maybe_migrate_guardian() {
  local profile="$1" pending_transaction="$2" candidate="$P_REPO/scripts/luna-guardian" rc=0
  [[ "$FROM_TIMER" == true && "$DRY_RUN" != true && "$P_TIMER_ALLOWED" == "true" ]] || return 0
  [[ -x "$candidate" ]] || return 0
  [[ ! -f "$pending_transaction" ]] || {
    echo "[autodeploy:$profile] guardian migration deferred — update transaction recovery is pending"
    return 0
  }
  if ! luna_runtime_matches_checkout "$P_REPO" "$P_PORT" "$P_INCUS" "$P_SERVICE_NAME"; then
    echo "[autodeploy:$profile] guardian migration deferred — runtime does not prove checkout HEAD"
    return 0
  fi
  if ! bash -n "$candidate"; then
    echo "[autodeploy:$profile] CRITICAL — guardian candidate failed syntax validation" >&2
    return 2
  fi

  echo "[autodeploy:$profile] MIGRATING legacy timer -> independent guardian"
  "$candidate" adopt "$profile" || rc=$?
  case "$rc" in
    0) echo "[autodeploy:$profile] guardian adopted; legacy timer retired" ;;
    10) echo "[autodeploy:$profile] guardian adoption deferred; legacy timer retained" ;;
    *)
      echo "[autodeploy:$profile] CRITICAL — guardian migration failed; legacy timer retained for retry" >&2
      return 2
      ;;
  esac
}

do_deploy() {
  local profile="$1"; profile_config "$profile"

  [[ -x "$UPDATE_SERVER" ]] || { echo "luna-autodeploy: $UPDATE_SERVER not found/executable" >&2; exit 2; }
  [[ -d "$P_REPO/.git" ]] || { echo "luna-autodeploy: $P_REPO is not a git repo" >&2; exit 2; }

  local local_sha remote_sha update_state_dir pending_transaction
  local_sha="$(git -C "$P_REPO" rev-parse HEAD)"
  update_state_dir="${LUNA_UPDATE_STATE_DIR:-${LUNA_HOME:-${HOME:-/root}/.luna}/update}"
  pending_transaction="$update_state_dir/transaction-$profile"

  if ! maybe_migrate_guardian "$profile" "$pending_transaction"; then return 2; fi

  # Auto-update knob: a TIMER-initiated run respects deploy.autoUpdate; when
  # the operator set it to false the guardian still owns health/recovery, but
  # branch movement is ignored. A manual run ignores the knob — typing the
  # command is the consent the knob exists to gate.
  if [[ "$FROM_TIMER" == true && "$P_AUTO_UPDATE" != "true" ]]; then
    echo "[autodeploy:$profile] auto-update is OFF (deploy.autoUpdate=false) — timer run skipped; manual 'luna-autodeploy $profile' still deploys"
    return 0
  fi

  git -C "$P_REPO" fetch origin "$P_BRANCH" --quiet
  remote_sha="$(git -C "$P_REPO" rev-parse "origin/$P_BRANCH")"

  if [[ "$local_sha" == "$remote_sha" && "$FORCE" != true && ! -f "$pending_transaction" ]]; then
    echo "[autodeploy:$profile] up to date at ${local_sha:0:9} — no-op"
    return 0
  fi

  if [[ -f "$pending_transaction" ]]; then
    echo "[autodeploy:$profile] interrupted update journal found — recovery required before normal deploy"
  fi

  if [[ "$ALLOW_ACTIVE" != true && "$FORCE" != true ]]; then
    local n
    if ! n="$(luna_active_ws_count "$P_PORT" "$P_INCUS")"; then
      echo "[autodeploy:$profile] DEFERRED — active-session count UNKNOWN; refusing unattended restart (origin ${remote_sha:0:9}; use --allow-active only after manual inspection)" >&2
      return 0
    fi
    if [[ "$n" -gt 0 ]]; then
      echo "[autodeploy:$profile] DEFERRED — $n active session(s); will retry next tick (origin ${remote_sha:0:9})"
      return 0
    fi
  fi

  echo "[autodeploy:$profile] deploying ${local_sha:0:9} -> ${remote_sha:0:9} (origin/$P_BRANCH)"
  if [[ "$DRY_RUN" == true ]]; then
    echo "[autodeploy:$profile] DRY-RUN: $UPDATE_SERVER ${P_UPDATE_ARGS[*]}"
    return 0
  fi

  # F11: pin engine BEFORE the real exec so git-reset-hard cannot self-mutate it
  local pinned_engine
  pinned_engine="$(luna_pin_engine "$P_REPO")"

  local rc=0
  "$pinned_engine" "${P_UPDATE_ARGS[@]}" || rc=$?
  case "$rc" in
    0)
      echo "[autodeploy:$profile] OK — now at ${remote_sha:0:9}"
      if ! maybe_migrate_guardian "$profile" "$pending_transaction"; then rc=2; fi
      ;;
    1) echo "[autodeploy:$profile] ROLLED BACK — update failed, recovered to ${local_sha:0:9}" >&2 ;;
    *) echo "[autodeploy:$profile] CRITICAL rc=$rc — rollback may have failed; manual attention needed" >&2 ;;
  esac
  return "$rc"
}

# ── F7: --validate — existence checks on registry-declared infra ─────────────
# Distinct from --dry-run (which only renders flags). Checks that the referenced
# container / repo dir / systemd unit actually EXIST on this host.
#
# Test seams (mirrors LUNA_TEST_* pattern):
#   LUNA_TEST_VALIDATE_REPO    — override repo .git dir existence check
#   LUNA_TEST_VALIDATE_INCUS   — override incus container existence check
#   LUNA_TEST_VALIDATE_SERVICE — override systemd unit existence check
do_validate() {
  local profile="$1"; profile_config "$profile"
  local ok=true

  echo "[validate:$profile] Checking registry entries..."

  # 1. Repo dir
  local repo_ok
  if [[ "${LUNA_TEST_VALIDATE_REPO+set}" == "set" ]]; then
    repo_ok="$LUNA_TEST_VALIDATE_REPO"
  elif [[ -d "$P_REPO/.git" ]]; then
    repo_ok="true"
  else
    repo_ok="false"
  fi
  if [[ "$repo_ok" == "true" ]]; then
    echo "[validate:$profile] OK: repo dir $P_REPO"
  else
    echo "[validate:$profile] FAIL: repo dir $P_REPO not found or not a git repo" >&2
    ok=false
  fi

  # 2. Incus container (only if incus is configured)
  if [[ -n "$P_INCUS" ]]; then
    local incus_ok
    if [[ "${LUNA_TEST_VALIDATE_INCUS+set}" == "set" ]]; then
      incus_ok="$LUNA_TEST_VALIDATE_INCUS"
    elif command -v incus >/dev/null 2>&1 && incus info "$P_INCUS" >/dev/null 2>&1; then
      incus_ok="true"
    else
      incus_ok="false"
    fi
    if [[ "$incus_ok" == "true" ]]; then
      echo "[validate:$profile] OK: incus container $P_INCUS"
    else
      echo "[validate:$profile] FAIL: incus container $P_INCUS not found or not running" >&2
      ok=false
    fi
  else
    echo "[validate:$profile] OK: bare-host mode (no incus container)"
  fi

  # 3. Systemd unit file (only if P_SERVICE_NAME is set)
  if [[ -n "$P_SERVICE_NAME" ]]; then
    local svc_ok
    if [[ "${LUNA_TEST_VALIDATE_SERVICE+set}" == "set" ]]; then
      svc_ok="$LUNA_TEST_VALIDATE_SERVICE"
    elif [[ -f "/etc/systemd/system/$P_SERVICE_NAME" ]] || \
         systemctl cat "$P_SERVICE_NAME" >/dev/null 2>&1; then
      svc_ok="true"
    else
      svc_ok="false"
    fi
    if [[ "$svc_ok" == "true" ]]; then
      echo "[validate:$profile] OK: systemd unit $P_SERVICE_NAME"
    else
      echo "[validate:$profile] FAIL: systemd unit $P_SERVICE_NAME not found" >&2
      ok=false
    fi
  fi

  if [[ "$ok" == "true" ]]; then
    echo "[validate:$profile] All checks passed."
    return 0
  else
    echo "[validate:$profile] Validation FAILED — check errors above." >&2
    return 2
  fi
}

# ── systemd timer install ─────────────────────────────────────────────────────
# Test seam:
#   LUNA_TEST_SYSTEMD_DIR — override the unit dir (default /etc/systemd/system)
install_timer() {
  local profile="$1"; profile_config "$profile"

  # (F5) Hard-reject timer install for any profile where the registry says
  # timer is not allowed. This enforces the opt-out rail in CODE, not just
  # data — even if someone edits the registry entry, this gate fires.
  if [[ "$P_TIMER_ALLOWED" != "true" ]]; then
    echo "luna-autodeploy: timers are not allowed for profile '$profile' (registry deploy.timer=false)." >&2
    echo "  This profile is deploy-by-hand only until the registry says otherwise." >&2
    echo "  If you intend to enable auto-deploy for this profile, set deploy.timer=true in the registry." >&2
    exit 2
  fi

  # Cadence: --interval wins, else the registry's deploy.timerInterval, else
  # 3min. The seed registry ships dev=3min, stable=15min.
  local interval="${INTERVAL:-${P_TIMER_INTERVAL:-3min}}"
  local unit_dir="${LUNA_TEST_SYSTEMD_DIR:-/etc/systemd/system}"
  local svc="$unit_dir/luna-autodeploy-$profile.service"
  local tmr="$unit_dir/luna-autodeploy-$profile.timer"

  # ExecStart points at the CHANNEL repo's OWN copy of this script
  # ($P_REPO/scripts/luna-autodeploy), not the provisioning checkout that may
  # have invoked us. This keeps the timer alive if the provisioning checkout
  # moves, and lets the channel run autodeploy fixes shipped through the very
  # branch it updates. Fall back to the running copy only when the channel copy
  # is not yet present (e.g. install-timer against a repo cloned later).
  local exec_bin="$P_REPO/scripts/luna-autodeploy"
  if [[ ! -x "$exec_bin" ]]; then
    echo "luna-autodeploy: channel copy $exec_bin not found — timer ExecStart falls back to $SELF" >&2
    exec_bin="$SELF"
  fi
  cat > "$svc" <<EOF
[Unit]
Description=Luna auto-deploy ($profile) — pull origin/$P_BRANCH and update if it moved
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# HOME is required so git/gh find credentials for the private remote (see
# memory: the unit running with HOME unset was a real auth footgun).
Environment=HOME=/root
# --from-timer: machine-initiated run — respects the deploy.autoUpdate knob
# and never bypasses the connect-aware active-session deferral.
ExecStart=$exec_bin $profile --from-timer
EOF
  cat > "$tmr" <<EOF
[Unit]
Description=Luna auto-deploy ($profile) timer — checks origin/$P_BRANCH every $interval

[Timer]
OnBootSec=2min
OnUnitActiveSec=$interval
AccuracySec=30s
Persistent=false

[Install]
WantedBy=timers.target
EOF
  systemctl daemon-reload
  systemctl enable --now "luna-autodeploy-$profile.timer"
  echo "luna-autodeploy: installed + enabled luna-autodeploy-$profile.timer (every $interval)"
  echo "  ExecStart=$exec_bin $profile --from-timer"
  systemctl list-timers "luna-autodeploy-$profile.timer" --no-pager 2>/dev/null | head -3 || true
}

uninstall_timer() {
  local profile="$1"
  local unit_dir="${LUNA_TEST_SYSTEMD_DIR:-/etc/systemd/system}"
  systemctl disable --now "luna-autodeploy-$profile.timer" 2>/dev/null || true
  rm -f "$unit_dir/luna-autodeploy-$profile.timer" "$unit_dir/luna-autodeploy-$profile.service"
  systemctl daemon-reload
  echo "luna-autodeploy: removed luna-autodeploy-$profile timer + service"
}

# ── arg parse + dispatch ─────────────────────────────────────────────────────
CMD="${1:-}"
case "$CMD" in
  install-timer|uninstall-timer)
    SUBPROFILE="${2:?usage: luna-autodeploy $CMD <profile>}"; shift 2
    while [[ $# -gt 0 ]]; do case "$1" in --interval) INTERVAL="${2:?}"; shift 2 ;; *) echo "unknown arg: $1" >&2; exit 2 ;; esac; done
    # A plain if/else (not `A && B || C`): the list form suppressed `set -e`
    # inside install_timer (a failed unit write still exited 0) and ran
    # uninstall_timer whenever install_timer returned non-zero.
    if [[ "$CMD" == install-timer ]]; then
      install_timer "$SUBPROFILE"
    else
      uninstall_timer "$SUBPROFILE"
    fi
    ;;
  *)
    # A profile name (or unknown command) — must be a non-empty string.
    [[ -n "$CMD" && "$CMD" != "-h" && "$CMD" != "--help" ]] || { sed -n '2,53p' "$SELF" | sed 's/^# \{0,1\}//'; exit 0; }
    PROFILE="$CMD"; shift
    while [[ $# -gt 0 ]]; do case "$1" in
      --force) FORCE=true; shift ;;
      --allow-active) ALLOW_ACTIVE=true; shift ;;
      --dry-run) DRY_RUN=true; shift ;;
      --validate) VALIDATE=true; shift ;;
      --from-timer) FROM_TIMER=true; shift ;;
      *) echo "unknown arg: $1" >&2; exit 2 ;;
    esac; done
    if [[ "$VALIDATE" == true ]]; then
      do_validate "$PROFILE"
    else
      do_deploy "$PROFILE"
    fi
    ;;
esac
