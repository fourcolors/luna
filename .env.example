# .env.example — operator-supplied SECRETS for a Luna server (reference only).
#
# Real values belong ONLY in the runtime env file ($LUNA_HOME/.env, default
# /root/.luna/.env), which is gitignored and mode 600. NEVER put real values in
# this file or any tracked file — CI's secret-scan (a hard gate) will block the
# merge. scripts/luna-server-install writes the non-secret LUNA_* config keys for
# you; this file documents only the two values you supply. See docs/server-secrets.md.

# Long-lived Claude model-auth token from `claude setup-token` (sk-ant-oat01...).
# When set, the default account is pointed at env:CLAUDE_CODE_OAUTH_TOKEN — durable
# auth that does NOT idle-expire (preferred over the interactive claude-code:login,
# which lapses after a few idle hours). Supply it to the installer via
# --claude-token-file <path> or this env var — never as a command-line flag value
# (flags leak into shell history and `ps`).
CLAUDE_CODE_OAUTH_TOKEN=

# UI WebSocket bearer token (clients pass it in the ws:// URL). A random 32+ char
# hex value; the installer can generate one via --token / scripts/lib/gen-token.sh.
UI_WS_TOKEN=

# Telegram bot token from @BotFather (digits:base64-ish, e.g. 123456:ABC-DEF...).
# When set, the chat server starts the Telegram channel adapter at boot: the bot
# long-polls for messages, routes each chat to its own Luna thread, and streams
# the agent's reply back via message edits. Leave empty to disable the channel.
# The value is read once at boot and held as a Redacted secret (never logged).
TELEGRAM_BOT_TOKEN=
