node_modules/
dist/
.DS_Store
*.tsbuildinfo
coverage/
.vitest-temp/
tsconfig.tsbuildinfo
pnpm-lock.yaml
.env
.env.local
.env.*.local

# Local-only symlink to ~/.luna/CLAUDE.md (Operator's box only)
/CLAUDE.md

# Scratch space for ad-hoc scripts, notes, and review artifacts
.scratch/

# Local-only Claude Code agent state (settings.json is tracked; these are not)
.claude/agent-memory/
.claude/software-engineering/
.claude/scheduled_tasks.lock
.claude/settings.local.json
# Match nested .claude dirs anywhere in the tree (e.g. apps/*/frontend/.claude/).
**/.claude/agent-memory/
**/.claude/software-engineering/
**/.claude/scheduled_tasks.lock
**/.claude/settings.local.json

# Local-only scratch for things like issue bodies waiting to be filed
/.local/

# Worktree-local bun package cache (sandboxed installs use BUN_INSTALL_CACHE_DIR)
/.bun-cache/
