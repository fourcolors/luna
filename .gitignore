/worktrees/
node_modules/
dist/
.DS_Store
*.tsbuildinfo
coverage/
.vitest-temp/
.lavish/
tsconfig.tsbuildinfo
pnpm-lock.yaml
.env
.env.local
.env.*.local

# Local-only symlink to ~/.luna/CLAUDE.md (Operator's box only)
/CLAUDE.md

# Scratch space for ad-hoc scripts, notes, and review artifacts
.scratch/

# Local-only Claude Code agent state (settings.json is tracked; these are not)
.claude/agent-memory/
.claude/software-engineering/
.claude/scheduled_tasks.lock
.claude/settings.local.json
.claude/ping-pong/
.claude/skills/*
# ...but luna-verify is repo knowledge, not an installed tool: it encodes how to
# actually run and check this app, so it ships with the repo like the workflows
# and commands do. (A bare `.claude/skills/` exclusion cannot be negated - git
# will not descend into an excluded directory - hence the `/*`.)
!.claude/skills/luna-verify/
.claude/worktrees/
# Match nested .claude dirs anywhere in the tree (e.g. apps/*/frontend/.claude/).
**/.claude/agent-memory/
**/.claude/software-engineering/
**/.claude/scheduled_tasks.lock
**/.claude/settings.local.json
**/.claude/worktrees/
**/.claude/checkpoints/
**/.claude/mailbox/
**/.claude/routines/.state/
**/.claude/scheduled_tasks.json
**/.claude/agent-registry.json
**/.claude/agent-memory-local
**/.claude/first-run
**/.claude/assistant-daemon-state.json

# Ephemeral multi-agent session workspaces (committed agent defs live in agents/)
.agents/

# Editor / agent local hook and skill installs
.codex/
.cursor/
.github/hooks/
.github/skills/

# Generated local UML / graph builder output
.uml-builder/

# Personal / legal drafts - never commit
*.docx
/CTO-Transition-Advisory-Agreement*.docx

# Spike seed HTML left by local experiments
_seed-*.html
__spike-seed-*.html

# Local-only scratch for things like issue bodies waiting to be filed
/.local/

# Worktree-local bun package cache (sandboxed installs use BUN_INSTALL_CACHE_DIR)
/.bun-cache/

# rerank-eval LLM response cache (ephemeral, keyed by model+shape+query+candidates)
packages/memory/bench/.rerank-cache.json
