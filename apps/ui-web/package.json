{
  "name": "@luna/ui-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "bun run scripts/dev-server.ts",
    "server:chat": "bun run scripts/chat-server.ts",
    "dev:preview": "vite build --mode development && vite preview",
    "build": "[ -z \"$VITE_UI_WS_TOKEN\" ] || { echo 'refusing prod build: VITE_UI_WS_TOKEN is set (would bake the shared secret into dist/)'; exit 1; }; vite build",
    "serve:static": "bun run scripts/serve-static.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@astryxdesign/core": "0.1.8",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@stylexjs/stylex": "^0.19.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.1.8",
    "@luna/adapter-sdk": "workspace:*",
    "@luna/capabilities": "workspace:*",
    "@luna/channels": "workspace:*",
    "@luna/chat-service": "workspace:*",
    "@luna/connectors": "workspace:*",
    "@luna/control-server": "workspace:*",
    "@luna/core": "workspace:*",
    "@luna/design-system": "workspace:*",
    "@luna/job-input-tools": "workspace:*",
    "@luna/local-shell-tools": "workspace:*",
    "@luna/mcp-servers": "workspace:*",
    "@luna/memory": "workspace:*",
    "@luna/memory-tools": "workspace:*",
    "@luna/oauth": "workspace:*",
    "@luna/observability-tools": "workspace:*",
    "@luna/scheduler-tools": "workspace:*",
    "@luna/secret-tools": "workspace:*",
    "@luna/skill-tools": "workspace:*",
    "@luna/suggested-actions-tools": "workspace:*",
    "@luna/thread-tools": "workspace:*",
    "@luna/tools": "workspace:*",
    "@luna/ui-shared": "workspace:*",
    "@luna/ui-transport": "workspace:*",
    "@luna/ui-ws": "workspace:*",
    "@luna/vault": "workspace:*",
    "@luna/widget-tools": "workspace:*",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "debug": "^4.4.3",
    "effect": "^3.21.0",
    "extend": "^3.0.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.5"
  }
