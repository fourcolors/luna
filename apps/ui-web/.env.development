# Auto-loaded by vite in dev + preview modes (NODE_ENV=development).
# Pre-fills the token field in the connection panel so `bun run dev:server`
# + `bun run dev` is a zero-copy-paste workflow.
#
# This token is NOT a secret — it's the hardcoded dev-server.ts token, used
# only by the local synthetic-event harness on ws://127.0.0.1:4753. Real
# deployments override via VITE_UI_WS_TOKEN at build time.
VITE_UI_WS_TOKEN=dev-ui-ws-token-do-not-ship

# Sets cwd for all Claude subprocesses so they load ~/Projects/luna/CLAUDE.md
# (→ ~/.luna/CLAUDE.md) as Luna's identity. See packages/chat-service/src/chat-service.ts:198.
LUNA_REPO_ROOT=/Users/sol/Projects/luna
