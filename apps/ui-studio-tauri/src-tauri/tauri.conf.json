{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luna Studio",
  "version": "0.1.1",
  "identifier": "com.luna.studio",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "bun run --cwd ../../ui-web build",
    "devUrl": null,
    "frontendDist": "../../ui-web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ws: wss:; img-src 'self' data:; font-src 'self' data: https://fonts.gstatic.com; style-src-elem 'self' 'unsafe-inline' https://fonts.googleapis.com; frame-src 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Luna Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/fourcolors/luna/releases/download/studio-updater/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCODFGNDc5QUZFNzA4MjAKUldRZ0NPZXZlZlNCYXcraDlDRnM4U1lCNjBKSEYxN25wTnZXRnBLK1VkKy9NM3F0OVRoNjdRRUUK"
    }
  }
}