{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "panels",
  "description": "Permission set for SYSTEM widget windows (panel-* \u2014 settings panels and prebuilt rails; design/widget-system.md 'First-Class Widgets'). System tier: pages shipped in the app bundle, never agent/user-authored content (that's widget-* + the sandbox). Inherits the widget windows' dock/snap surface plus the Tauri commands each panel type needs (updates today; more arrive with the Phase 3 settings migration).",
  "windows": [
    "panel-*"
  ],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-set-always-on-top",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-inner-size",
    "core:window:allow-current-monitor",
    "core:window:allow-scale-factor",
    "core:window:allow-close",
    "core:event:default",
    "allow-load-connection",
    "allow-get-platform",
    "allow-close-widget",
    "allow-list-widget-windows",
    "allow-set-dock",
    "allow-grab-dock",
    "allow-check-for-update",
    "allow-install-update",
    "allow-hub-event",
    "allow-voice-status",
    "allow-voice-set-mode",
    "allow-voice-set-voice",
    "allow-voice-set-config",
    "allow-voice-list-voices",
    "allow-voice-ensure-model",
    "allow-save-connection",
    "allow-load-profiles",
    "allow-set-active-profile",
    "allow-open-external-url",
    "opener:allow-open-url",
    "allow-open-widget"
  ]
}