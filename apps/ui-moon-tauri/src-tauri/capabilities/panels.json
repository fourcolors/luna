{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "panels",
  "description": "Permission set for SYSTEM widget windows (panel-* — settings panels and prebuilt rails; design/widget-system.md 'First-Class Widgets'). System tier: pages shipped in the app bundle, never agent/user-authored content (that's widget-* + the sandbox). Windows use native independent dragging plus the Tauri commands each panel type needs.",
  "windows": [
    "panel-*"
  ],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-set-always-on-top",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-inner-size",
    "core:window:allow-current-monitor",
    "core:window:allow-scale-factor",
    "core:window:allow-close",
    "core:event:default",
    "allow-load-connection",
    "allow-migrate-legacy-connection",
    "allow-load-route",
    "allow-list-routes",
    "allow-set-default-route",
    "allow-get-panel-route",
    "allow-set-panel-route",
    "allow-get-panel-last-thread",
    "allow-set-panel-last-thread",
    "allow-get-platform",
    "allow-close-widget",
    "allow-updater",
    "allow-hub-event",
    "allow-voice-status",
    "allow-voice-set-mode",
    "allow-voice-set-voice",
    "allow-voice-set-config",
    "allow-voice-list-voices",
    "allow-voice-ensure-model",
    "allow-save-connection",
    "allow-load-profiles",
    "allow-set-active-profile",
    "allow-open-external-url",
    "opener:allow-open-url",
    "allow-open-widget",
    "allow-open-artifact-widget",
    "allow-collapse-to-moon",
    "allow-begin-native-resize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize"
  ]
}
