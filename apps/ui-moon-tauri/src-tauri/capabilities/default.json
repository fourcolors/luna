{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permission set for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "core:window:allow-set-always-on-top",
    "allow-get-last-thread-id",
    "allow-save-connection",
    "allow-load-connection",
    "allow-load-profiles",
    "allow-set-active-profile",
    "allow-local-shell-exec",
    "allow-get-platform",
    "allow-check-for-update",
    "allow-install-update",
    "dialog:allow-open"
  ]
}
