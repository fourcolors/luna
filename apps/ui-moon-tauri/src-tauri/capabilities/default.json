{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permission set for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-position",
    "core:window:allow-outer-position",
    "core:window:allow-current-monitor",
    "core:window:allow-scale-factor",
    "allow-get-last-thread-id",
    "allow-set-last-thread-id",
    "allow-get-panel-last-thread",
    "allow-set-panel-last-thread",
    "allow-save-connection",
    "allow-load-connection",
    "allow-migrate-legacy-connection",
    "allow-load-profiles",
    "allow-set-active-profile",
    "allow-load-route",
    "allow-list-routes",
    "allow-set-default-route",
    "allow-get-panel-route",
    "allow-set-panel-route",
    "allow-local-shell-exec",
    "allow-get-platform",
    "allow-notify",
    "allow-updater",
    "allow-voice-status",
    "allow-voice-set-mode",
    "allow-voice-ptt-down",
    "allow-voice-ptt-up",
    "allow-voice-cancel",
    "allow-speak-text",
    "allow-voice-stop-speaking",
    "allow-voice-list-voices",
    "allow-voice-set-voice",
    "allow-voice-set-config",
    "allow-voice-ensure-model",
    "dialog:allow-open",
    "allow-oauth-loopback-start",
    "allow-oauth-loopback-wait",
    "allow-oauth-loopback-cancel",
    "allow-open-external-url",
    "opener:allow-open-url",
    "allow-open-artifact-widget",
    "allow-open-widget",
    "allow-close-widget",
    "allow-list-widget-windows",
    "allow-collapse-to-moon",
    "allow-expand-from-moon",
    "allow-set-native-controls-visible",
    "allow-begin-native-resize",
    "allow-watch-drag-release",
    "allow-dock-self",
    "allow-dock-move-cluster"
  ]
}