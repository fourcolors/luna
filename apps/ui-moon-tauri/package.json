{
  "name": "@luna/ui-moon-tauri",
  "version": "0.0.67",
  "private": true,
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "dev:frontend": "vite",
    "build": "tauri build",
    "build:dev": "tauri build --config src-tauri/tauri.dev.conf.json",
    "build:frontend": "vite build",
    "install:macos": "bash scripts/install-macos-app.sh",
    "test:e2e:build": "cargo build --manifest-path src-tauri/Cargo.toml --features wdio-e2e",
    "test:e2e": "wdio run e2e/wdio.conf.mjs",
    "test:e2e:ci": "bun run test:e2e:build && bun run test:e2e"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "@wdio/cli": "9.27.1",
    "@wdio/local-runner": "9.27.1",
    "@wdio/mocha-framework": "9.27.1",
    "@wdio/spec-reporter": "9.27.1",
    "expect-webdriverio": "^5.4.0",
    "jsdom": "^29.1.1",
    "vite": "^5.4.10",
    "webdriverio": "9.27.1"
  },
  "dependencies": {
    "@astryxdesign/core": "0.1.8",
    "@luna/tools": "workspace:*",
    "@luna/ui-shared": "workspace:*",
    "@luna/ui-transport": "workspace:*",
    "@stylexjs/stylex": "^0.19.0",
    "react": "^19",
    "react-dom": "^19"
  }
}
