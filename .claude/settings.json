{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Grep",
      "Glob",
      "Bash",
      "WebFetch",
      "WebSearch",
      "Skill",
      "Task",
      "Agent",
      "mcp__memory"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm * -rf *)",
      "Bash(rm * -fr *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(secrets/**)",
      "Read(**/secrets/**)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/.env*)"
    ]
  },
  "mcpServers": {
    "memory": {
      "command": "bun",
      "args": [
        "run",
        "--filter",
        "@luna/memory-tools",
        "start"
      ],
      "env": {
        "LUNA_EMBEDDER": "stub",
        "LUNA_MEMORY_DB": ":memory:"
      }
    }
  },
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true,
  "voiceEnabled": false,
  "effortLevel": "high"
}
