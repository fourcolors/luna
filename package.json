{
  "name": "luna",
  "version": "0.0.1",
  "description": "Modular agent framework built on Effect with full Claude Agent SDK parity",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "install:safe": "BUN_INSTALL_CACHE_DIR=/tmp/bun-cache bun install"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
